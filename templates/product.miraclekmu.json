    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"mk-stats\">\n  <div class=\"mk-stats-left\">\n    <h2 class=\"mk-stats-title\">Made For Dry, Itchy Skin That Needs A Break</h2>\n    <p class=\"mk-stats-sub\">One light daily cream, with a full 60 days to try it.</p>\n  </div>\n\n  <div class=\"mk-stats-right\">\n    <div class=\"mk-stat\">\n      <p class=\"mk-stat-number\"><span class=\"mk-count\" data-target=\"4\">4</span></p>\n      <div class=\"mk-stat-body\">\n        <p class=\"mk-stat-heading\">Plant Heroes In Every Tub</p>\n        <p class=\"mk-stat-text\">Mānuka leaf oil, kānuka leaf oil, marshmallow leaf extract and coconut oil.</p>\n      </div>\n    </div>\n\n    <div class=\"mk-stat\">\n      <p class=\"mk-stat-number\"><span class=\"mk-count\" data-target=\"250\">250</span><span class=\"mk-unit\">g</span></p>\n      <div class=\"mk-stat-body\">\n        <p class=\"mk-stat-heading\">Big Tub For The Whole Body</p>\n        <p class=\"mk-stat-text\">Enough for arms, legs and everywhere else. Light, fast to sink in and never greasy.</p>\n      </div>\n    </div>\n\n    <div class=\"mk-stat\">\n      <p class=\"mk-stat-number\"><span class=\"mk-count\" data-target=\"60\">60</span></p>\n      <div class=\"mk-stat-body\">\n        <p class=\"mk-stat-heading\">Days To Try It</p>\n        <p class=\"mk-stat-text\">Use it every day. If your skin doesn't feel softer and calmer, get a full refund.</p>\n      </div>\n    </div>\n\n    <p class=\"mk-stats-note\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n        <circle cx=\"10\" cy=\"10\" r=\"9\" fill=\"#b79be8\"/>\n        <circle cx=\"10\" cy=\"6\" r=\"1.2\" fill=\"#fff\"/>\n        <rect x=\"9\" y=\"8.5\" width=\"2\" height=\"6.5\" rx=\"1\" fill=\"#fff\"/>\n      </svg>\n      <span>Results are different for everyone. See guarantee terms for details.</span>\n    </p>\n  </div>\n</section>\n\n<style>\n  .mk-stats {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    align-items: center;\n    gap: 40px 80px;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 70px 24px;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #000;\n    box-sizing: border-box;\n  }\n\n  .mk-stats-left {\n    text-align: center;\n  }\n\n  .mk-stats-title {\n    font-family: \"Arial Black\", \"Helvetica Neue\", Arial, sans-serif;\n    font-weight: 900;\n    font-size: 60px;\n    line-height: 1.05;\n    letter-spacing: -0.5px;\n    margin: 0 0 18px 0;\n  }\n\n  .mk-stats-sub {\n    font-size: 20px;\n    line-height: 1.4;\n    margin: 0;\n  }\n\n  .mk-stat {\n    display: flex;\n    align-items: center;\n    gap: 22px;\n    padding: 18px 0;\n    border-bottom: 1px solid #e3d9f5;\n  }\n\n  .mk-stat:first-child {\n    padding-top: 0;\n  }\n\n  .mk-stat:nth-of-type(3) {\n    border-bottom: none;\n  }\n\n  .mk-stat-number {\n    flex-shrink: 0;\n    min-width: 170px;\n    margin: 0;\n    font-family: \"Arial Black\", \"Helvetica Neue\", Arial, sans-serif;\n    font-weight: 900;\n    font-size: 62px;\n    line-height: 1;\n    color: #b79be8;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .mk-unit {\n    font-size: 30px;\n    margin-left: 2px;\n  }\n\n  .mk-stat-heading {\n    font-size: 27px;\n    font-weight: 700;\n    line-height: 1.25;\n    margin: 0 0 6px 0;\n  }\n\n  .mk-stat-text {\n    font-size: 19px;\n    line-height: 1.45;\n    color: #333;\n    margin: 0;\n  }\n\n  .mk-stats-note {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin: 44px 0 0 0;\n    font-size: 19px;\n    font-style: italic;\n  }\n\n  .mk-stats-note svg {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n  }\n\n  @media (max-width: 990px) {\n    .mk-stats {\n      grid-template-columns: 1fr;\n      padding: 48px 20px;\n    }\n\n    .mk-stats-title {\n      font-size: 42px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .mk-stats {\n      gap: 28px;\n      padding: 36px 16px;\n    }\n\n    .mk-stats-title {\n      font-size: 30px;\n      margin-bottom: 12px;\n    }\n\n    .mk-stats-sub {\n      font-size: 14px;\n    }\n\n    .mk-stat {\n      gap: 14px;\n      padding: 14px 0;\n    }\n\n    .mk-stat-number {\n      min-width: 100px;\n      font-size: 38px;\n    }\n\n    .mk-unit {\n      font-size: 19px;\n    }\n\n    .mk-stat-heading {\n      font-size: 17px;\n      margin-bottom: 4px;\n    }\n\n    .mk-stat-text {\n      font-size: 13px;\n    }\n\n    .mk-stats-note {\n      margin-top: 24px;\n      gap: 8px;\n      font-size: 12px;\n    }\n\n    .mk-stats-note svg {\n      width: 15px;\n      height: 15px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.querySelector('.mk-stats');\n    if (!section) return;\n\n    var counters = section.querySelectorAll('.mk-count');\n    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduceMotion || !('IntersectionObserver' in window)) return;\n\n    counters.forEach(function (el) { el.textContent = '0'; });\n\n    function run() {\n      var duration = 1600;\n      var start = null;\n\n      function frame(now) {\n        if (start === null) start = now;\n        var progress = Math.min((now - start) / duration, 1);\n        var eased = 1 - Math.pow(1 - progress, 3);\n\n        counters.forEach(function (el) {\n          var target = parseInt(el.getAttribute('data-target'), 10) || 0;\n          el.textContent = Math.round(target * eased);\n        });\n\n        if (progress < 1) requestAnimationFrame(frame);\n      }\n\n      requestAnimationFrame(frame);\n    }\n\n    var observer = new IntersectionObserver(function (entries) {\n      if (entries[0].isIntersecting) {\n        observer.disconnect();\n        run();\n      }\n    }, { threshold: 0.35 });\n\n    observer.observe(section);\n  })();\n</script>",
