    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"mk-why\">\n  <h2 class=\"mk-why-heading\">Why Jolie?</h2>\n\n  <div class=\"mk-why-header\">\n    <div class=\"mk-why-col\"></div>\n    <div class=\"mk-why-col\">\n      <div class=\"mk-why-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"10\" y=\"22\" width=\"40\" height=\"14\" rx=\"3\" fill=\"#b79be8\" stroke=\"#7a55c7\" stroke-width=\"1.5\"/>\n          <rect x=\"8\" y=\"36\" width=\"44\" height=\"44\" rx=\"6\" fill=\"#dccbf7\" stroke=\"#7a55c7\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"61\" font-size=\"8\" text-anchor=\"middle\" fill=\"#3d2a6b\" font-family=\"Arial\" font-weight=\"700\">JOLIE</text>\n        </svg>\n      </div>\n      <span>Jolie</span>\n    </div>\n    <div class=\"mk-why-col\">\n      <div class=\"mk-why-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Regular creams &amp; lotions</span>\n    </div>\n  </div>\n\n  <div class=\"mk-why-rows\">\n    <div class=\"mk-why-row\">\n      <div class=\"mk-why-label\">Keeps skin soft for longer</div>\n      <div class=\"mk-why-jolie\">Shea butter and coconut oil lock moisture in</div>\n      <div class=\"mk-why-other\">Often wear off fast, so the dryness comes back</div>\n    </div>\n\n    <div class=\"mk-why-row\">\n      <div class=\"mk-why-label\">How it feels</div>\n      <div class=\"mk-why-jolie\">Light, sinks in fast, no greasy film</div>\n      <div class=\"mk-why-other\">Often thick, sticky or greasy</div>\n    </div>\n\n    <div class=\"mk-why-row\">\n      <div class=\"mk-why-label\">What's inside</div>\n      <div class=\"mk-why-jolie\">Mānuka and kānuka oils with marshmallow leaf extract</div>\n      <div class=\"mk-why-other\">Often basic fillers and added perfume</div>\n    </div>\n\n    <div class=\"mk-why-row\">\n      <div class=\"mk-why-label\">Made for every day</div>\n      <div class=\"mk-why-jolie\">Steroid-free and gentle, for arms, legs and body</div>\n      <div class=\"mk-why-other\">Some are only meant for short-term use</div>\n    </div>\n\n    <div class=\"mk-why-row\">\n      <div class=\"mk-why-label\">Honest about pace</div>\n      <div class=\"mk-why-jolie\">Softer from day one, calmer with steady use</div>\n      <div class=\"mk-why-other\">\"Overnight fix\" promises that fizzle</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .mk-why {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #f5f0fd;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .mk-why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .mk-why-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #7a55c7;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .mk-why-col {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .mk-why-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .mk-why-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .mk-why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .mk-why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #dccbf7;\n  }\n\n  .mk-why-row:last-child {\n    border-bottom: none;\n  }\n\n  .mk-why-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .mk-why-jolie {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  .mk-why-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .mk-why {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .mk-why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .mk-why-header {\n      display: none;\n    }\n\n    .mk-why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .mk-why-label {\n      font-size: 13px;\n    }\n\n    .mk-why-jolie::before {\n      content: \"Jolie: \";\n      font-weight: 700;\n      color: #1a1a1a;\n    }\n\n    .mk-why-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .mk-why-jolie,\n    .mk-why-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
