    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"mk-feature\">\n  <div class=\"mk-feature-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/sven-s-island-miracle-manuka-daily-defence-cream-for-dry-itchy-skin-250g-1266892259.webp?v=1794562120\" alt=\"Daily cream for dry, itchy skin\" loading=\"lazy\">\n  </div>\n\n  <div class=\"mk-feature-content\">\n    <h2 class=\"mk-feature-heading\">\n      Made To Calm <span class=\"mk-highlight\">Dry, Itchy &amp; Rough Skin</span>\n    </h2>\n\n    <p class=\"mk-feature-text\">\n      Meet the daily cream built for the dry, itchy, rough skin nothing else has kept soft.\n    </p>\n\n    <p class=\"mk-feature-text\">\n      Most creams sit on top of your skin and are gone within an hour, so the itch and tightness come right back. This one pairs mānuka and kānuka oils with shea butter and coconut oil to lock moisture in and keep your skin soft and comfortable all day.\n    </p>\n\n    <p class=\"mk-feature-text\">\n      Your skin feels softer from the first use, and it stays calmer the longer you keep using it. It is light, it sinks in fast, and it never leaves you greasy.\n    </p>\n\n    <div class=\"mk-feature-highlights\">\n      <div class=\"mk-highlight-item\">\n        <span class=\"mk-sparkle\">✦</span>\n        <span>Soothes Dry, Itchy Skin</span>\n      </div>\n      <div class=\"mk-highlight-item\">\n        <span class=\"mk-sparkle\">✦</span>\n        <span>Steroid-free, gentle for daily use</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .mk-feature {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #dccbf7;\n    padding-top: 20px;\n  }\n\n  .mk-feature-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .mk-feature-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .mk-feature-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .mk-feature-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .mk-highlight {\n    background: #dccbf7;\n    color: #1a1a1a;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .mk-feature-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n\n  .mk-feature-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .mk-highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n\n  .mk-sparkle {\n    color: #9b7fd1;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .mk-feature {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .mk-feature-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .mk-feature-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .mk-feature-highlights {\n      gap: 14px;\n    }\n\n    .mk-highlight-item {\n      font-size: 12.5px;\n    }\n\n    .mk-feature-content {\n      padding: 0;\n    }\n  }\n</style>",
