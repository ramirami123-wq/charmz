        "custom_liquid": "<section class=\"manuka-reviews\" aria-label=\"Sample customer reviews\">\n  <h2 class=\"manuka-reviews__title\">Reviews</h2>\n  \n\n  <ul class=\"manuka-reviews__grid\" role=\"list\">\n    <li class=\"manuka-reviews__card\">\n      <h3>Rich texture</h3>\n      <p>“I like thicker creams for my hands. I usually put this one on before bed, especially around my knuckles.”</p>\n      <p class=\"manuka-reviews__name\">Nour Haddad</p>\n    </li>\n\n    <li class=\"manuka-reviews__card\">\n      <h3>A little goes a long way</h3>\n      <p>“I use a small amount on my elbows after a shower. It spreads easily, so I don’t need much.”</p>\n      <p class=\"manuka-reviews__name\">Mira Khoury</p>\n    </li>\n\n    <li class=\"manuka-reviews__card\">\n      <h3>Part of my evening routine</h3>\n      <p>“I keep the jar on my bedside table. I reach for it most often when my hands feel dry after a long day.”</p>\n      <p class=\"manuka-reviews__name\">Jana Aoun</p>\n    </li>\n  </ul>\n</section>\n\n<style>\n  .manuka-reviews {\n    max-width: 1120px;\n    margin-inline: auto;\n    padding: 40px 16px;\n    color: #222540;\n  }\n\n  .manuka-reviews .manuka-reviews__title {\n    margin: 0 0 8px;\n    color: inherit;\n    font-size: clamp(26px, 4vw, 36px);\n    line-height: 1.15;\n    text-align: center;\n  }\n\n  .manuka-reviews .manuka-reviews__disclaimer {\n    margin: 0 auto 24px;\n    color: #4b5073;\n    font-size: 14px;\n    line-height: 1.5;\n    text-align: center;\n  }\n\n  .manuka-reviews .manuka-reviews__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 14px;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .manuka-reviews .manuka-reviews__card {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 22px;\n    border: 1px solid #dce0f3;\n    border-radius: 16px;\n    background: #eef0fc;\n  }\n\n  .manuka-reviews .manuka-reviews__card h3,\n  .manuka-reviews .manuka-reviews__card p {\n    margin: 0;\n    color: inherit;\n  }\n\n  .manuka-reviews .manuka-reviews__card h3 {\n    font-size: 18px;\n    line-height: 1.3;\n  }\n\n  .manuka-reviews .manuka-reviews__card p {\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  .manuka-reviews .manuka-reviews__card .manuka-reviews__name {\n    margin-top: auto;\n    padding-top: 12px;\n    border-top: 1px solid #d4d8ed;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  @media (max-width: 749px) {\n    .manuka-reviews {\n      padding-block: 28px;\n    }\n\n    .manuka-reviews .manuka-reviews__grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>",
