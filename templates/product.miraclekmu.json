        "custom_liquid_PigjTJ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"mk-guarantee\">\n  <div class=\"mk-guarantee-icon\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"#3d2a6b\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <ellipse cx=\"16\" cy=\"30\" rx=\"9\" ry=\"4\"/>\n      <path d=\"M7 30v4c0 2.2 4 4 9 4s9-1.8 9-4v-4\"/>\n      <ellipse cx=\"22\" cy=\"21\" rx=\"9\" ry=\"4\"/>\n      <path d=\"M13 21v4c0 2.2 4 4 9 4s9-1.8 9-4v-4\"/>\n      <path d=\"M15 8v10M12 10.5h6M12 15h6\"/>\n    </svg>\n  </div>\n  <div class=\"mk-guarantee-content\">\n    <p class=\"mk-guarantee-heading\">60-Day Money Back Guarantee</p>\n    <p class=\"mk-guarantee-text\">\n      Use it every day, and if your skin doesn't feel softer and calmer after 60 days, send it back — opened or unopened — for a full refund.*\n    </p>\n  </div>\n</div>\n\n<style>\n  .mk-guarantee {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    background: linear-gradient(135deg, #f3ecfd, #dccbf7);\n    border: 1px dashed #9b7fd1;\n    border-radius: 14px;\n    padding: 20px 24px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n    box-sizing: border-box;\n  }\n\n  .mk-guarantee-icon {\n    flex-shrink: 0;\n    width: 44px;\n    height: 44px;\n  }\n\n  .mk-guarantee-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .mk-guarantee-content {\n    min-width: 0;\n  }\n\n  .mk-guarantee-heading {\n    font-size: 17px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin: 0 0 6px 0;\n  }\n\n  .mk-guarantee-text {\n    font-size: 14px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0;\n  }\n\n  @media (max-width: 480px) {\n    .mk-guarantee {\n      gap: 14px;\n      padding: 14px 16px;\n      border-radius: 12px;\n    }\n\n    .mk-guarantee-icon {\n      width: 34px;\n      height: 34px;\n    }\n\n    .mk-guarantee-heading {\n      font-size: 14px;\n      margin-bottom: 4px;\n    }\n\n    .mk-guarantee-text {\n      font-size: 12px;\n      line-height: 1.4;\n    }\n  }\n</style>"
          }
        },
        "custom_liquid_NxRXtm": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"mk-faq\">\n  <details class=\"mk-faq-item\">\n    <summary class=\"mk-faq-question\">\n      <span>Why Is This Cream Different?</span>\n      <span class=\"mk-faq-icon\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"mk-faq-answer\">\n      <p>Most creams for dry skin are thick, greasy and gone in an hour. This one is light and sinks in fast. It is made with mānuka leaf oil, kānuka leaf oil, marshmallow leaf extract, coconut oil and shea butter, and it has no steroids. The big 250g tub is made for large areas like arms, legs and the whole body.</p>\n    </div>\n  </details>\n\n  <details class=\"mk-faq-item\">\n    <summary class=\"mk-faq-question\">\n      <span>How Long Until I See Results?</span>\n      <span class=\"mk-faq-icon\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"mk-faq-answer\">\n      <p>Your skin should feel softer right after you put it on. Calmer, more comfortable skin takes steady daily use, and for some people that means a few weeks. Everyone's skin is different. Use it 2–3 times a day for the best chance of results. This is a moisturiser, not a medicine, so see your doctor for strong or painful flare-ups.</p>\n    </div>\n  </details>\n\n  <details class=\"mk-faq-item\">\n    <summary class=\"mk-faq-question\">\n      <span>When Will I Receive My Order?</span>\n      <span class=\"mk-faq-icon\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"mk-faq-answer\">\n      <p>Orders are packed and sent out within 24 business hours. Delivery usually takes 3–5 business days after that, depending on where you live. We email you a tracking link as soon as your order ships.</p>\n    </div>\n  </details>\n\n  <details class=\"mk-faq-item\">\n    <summary class=\"mk-faq-question\">\n      <span>Do You Offer A Guarantee?</span>\n      <span class=\"mk-faq-icon\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"mk-faq-answer\">\n      <p>Yes. Every order comes with a 60-day money back guarantee. If you're not happy, contact our support team within 60 days and send it back for a full refund.</p>\n    </div>\n  </details>\n</div>\n\n<style>\n  .mk-faq {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 730px;\n    box-sizing: border-box;\n  }\n\n  .mk-faq-item {\n    border-bottom: 1px solid #e3d9f5;\n  }\n\n  .mk-faq-item:last-child {\n    border-bottom: none;\n  }\n\n  .mk-faq-question {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 15px 4px 15px 0;\n    font-size: 20px;\n    line-height: 1.3;\n    color: #1a1a1a;\n    cursor: pointer;\n    list-style: none;\n  }\n\n  .mk-faq-question::-webkit-details-marker {\n    display: none;\n  }\n\n  .mk-faq-icon {\n    position: relative;\n    flex-shrink: 0;\n    width: 14px;\n    height: 14px;\n  }\n\n  .mk-faq-icon::before,\n  .mk-faq-icon::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 14px;\n    height: 2px;\n    background: #7a55c7;\n    transform: translate(-50%, -50%);\n    transition: transform 0.2s ease;\n  }\n\n  .mk-faq-icon::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n\n  .mk-faq-item[open] .mk-faq-icon::after {\n    transform: translate(-50%, -50%) rotate(0deg);\n  }\n\n  .mk-faq-answer {\n    padding: 0 40px 16px 0;\n  }\n\n  .mk-faq-answer p {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #444;\n    margin: 0;\n  }\n\n  @media (max-width: 480px) {\n    .mk-faq-question {\n      font-size: 16px;\n      padding: 13px 2px 13px 0;\n    }\n\n    .mk-faq-icon,\n    .mk-faq-icon::before,\n    .mk-faq-icon::after {\n      width: 12px;\n    }\n\n    .mk-faq-icon {\n      height: 12px;\n    }\n\n    .mk-faq-answer {\n      padding: 0 24px 14px 0;\n    }\n\n    .mk-faq-answer p {\n      font-size: 13px;\n    }\n  }\n</style>"
          }
