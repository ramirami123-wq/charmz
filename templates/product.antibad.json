    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"breath-why-section\">\n  <h2 class=\"why-heading\">Why Our Gel?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"14\" y=\"22\" width=\"32\" height=\"8\" rx=\"2\" fill=\"#6f8a3c\" stroke=\"#4f6628\" stroke-width=\"1.5\"/>\n          <path d=\"M12 32h36v42c0 4-3 7-7 7H19c-4 0-7-3-7-7V32z\" fill=\"#e3eac8\" stroke=\"#6f8a3c\" stroke-width=\"1.5\"/>\n          <rect x=\"16\" y=\"44\" width=\"28\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#9fb06c\" stroke-width=\"1\"/>\n          <text x=\"30\" y=\"56\" font-size=\"7\" text-anchor=\"middle\" fill=\"#3d4a3a\" font-family=\"Arial\" font-weight=\"700\">GEL</text>\n        </svg>\n      </div>\n      <span>Our Gel</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"24\" y=\"8\" width=\"12\" height=\"8\" rx=\"1.5\" fill=\"#777\" stroke=\"#555\" stroke-width=\"1.5\"/>\n          <path d=\"M24 16h12v6c5 3 8 8 8 14v40c0 3-2 5-5 5H21c-3 0-5-2-5-5V36c0-6 3-11 8-14v-6z\" fill=\"#9aa3a8\" stroke=\"#666\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Mints, gum &amp; mouthwash</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">How it works</div>\n      <div class=\"why-row-ours\">Works from the inside, every day</div>\n      <div class=\"why-row-other\">Covers up odor on the surface</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">How long it lasts</div>\n      <div class=\"why-row-ours\">Freshness that lasts all day</div>\n      <div class=\"why-row-other\">Wears off in minutes to a couple of hours</div>\