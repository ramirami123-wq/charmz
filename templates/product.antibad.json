    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"ddm-section\">\n  <!-- Shared gear icon (defined once, reused in each card) -->\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n    <symbol id=\"ddm-gears\" viewBox=\"0 0 48 48\">\n      <g fill=\"none\" stroke=\"#3d4a3a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <g transform=\"translate(6 6) scale(0.62)\">\n          <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n          <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/>\n        </g>\n        <g transform=\"translate(25 13) scale(0.5)\">\n          <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n          <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/>\n        </g>\n        <g transform=\"translate(15 27) scale(0.45)\">\n          <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n          <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.820l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/>\n        </g>\n      </g>\n    </symbol>\n    <symbol id=\"ddm-x\" viewBox=\"0 0 24 24\">\n      <path d=\"M5 5l14 14M19 5L5 19\" fill=\"none\" stroke=\"#c62828\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </symbol>\n  </svg>\n\n  <h2 class=\"ddm-heading\">Traditional External Deodorizing Methods</h2>\n\n  <div class=\"ddm-grid\">\n\n    <!-- Deodorant -->\n    <div class=\"ddm-card\">\n      <div class=\"ddm-top\">\n        <img class=\"ddm-img\" src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/deo.avif?v=1795259365\" alt=\"Roll-on deodorant\" loading=\"lazy\">\n        <h3 class=\"ddm-title\">Deodorant &amp; Antiperspirants</h3>\n      </div>\n      <div class=\"ddm-desc\">\n        <span class=\"ddm-desc-icon\"><svg><use href=\"#ddm-gears\"/></svg></span>\n        <p>Masks odor with fragrance or reduces sweat with aluminum compounds.</p>\n      </div>\n      <div class=\"ddm-limits\">\n        <p class=\"ddm-limits-title\">Limitations:</p>\n        <ul>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Only works on the skin surface.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Does not eliminate odor-causing bacteria.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Can irritate skin or cause allergic reactions.</span></li>\n        </ul>\n      </div>\n    </div>\n\n    <!-- Mouthwash -->\n    <div class=\"ddm-card\">\n      <div class=\"ddm-top\">\n        <img class=\"ddm-img\" src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/mouthwash.avif?v=1795259408\" alt=\"Mouthwash bottle\" loading=\"lazy\">\n        <h3 class=\"ddm-title\">Mouthwash</h3>\n      </div>\n      <div class=\"ddm-desc\">\n        <span class=\"ddm-desc-icon\"><svg><use href=\"#ddm-gears\"/></svg></span>\n        <p>Temporarily kills bacteria in the mouth and freshens breath.</p>\n      </div>\n      <div class=\"ddm-limits\">\n        <p class=\"ddm-limits-title\">Limitations:</p>\n        <ul>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Only treats bad breath, not systemic causes.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Can disrupt the natural oral bacteria balance.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Alcohol-based formulas may cause dry mouth.</span></li>\n        </ul>\n      </div>\n    </div>\n\n    <!-- Mints & Gum -->\n    <div class=\"ddm-card\">\n      <div class=\"ddm-top\">\n        <img class=\"ddm-img\" src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/mintsandgum.avif?v=1795259450\" alt=\"Mints and chewing gum\" loading=\"lazy\">\n        <h3 class=\"ddm-title\">Mints &amp; Gum</h3>\n      </div>\n      <div class=\"ddm-desc\">\n        <span class=\"ddm-desc-icon\"><svg><use href=\"#ddm-gears\"/></svg></span>\n        <p>Stimulates saliva to help neutralize acids and wash away food particles.</p>\n      </div>\n      <div class=\"ddm-limits\">\n        <p class=\"ddm-limits-title\">Limitations:</p>\n        <ul>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Temporary solution, doesn't address bacterial causes.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>Sugar-containing gums can promote tooth decay.</span></li>\n          <li><svg><use href=\"#ddm-x\"/></svg><span>No effect on body odor.</span></li>\n        </ul>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .ddm-section {\n    font-family: \"Montserrat\", Arial, Helvetica, sans-serif;\n    background: linear-gradient(180deg, #f8f9ef 0%, #eef2dc 100%);\n    padding: 24px 16px 32px;\n    box-sizing: border-box;\n    width: 100%;\n  }\n\n  .ddm-section * { box-sizing: border-box; }\n\n  .ddm-heading {\n    text-align: center;\n    font-size: 38px;\n    font-weight: 500;\n    color: #1f3320;\n    margin: 0 0 40px 0;\n    letter-spacing: 0.5px;\n    line-height: 1.25;\n  }\n\n  .ddm-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 30px;\n    max-width: 1560px;\n    margin: 0 auto;\n  }\n\n  .ddm-card {\n    background: rgba(255, 255, 255, 0.55);\n    border-radius: 10px;\n    padding: 14px 14px 16px;\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n  }\n\n  .ddm-top {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    min-height: 130px;\n    padding: 0 10px 10px;\n  }\n\n  .ddm-img {\n    width: 130px;\n    height: 125px;\n    object-fit: contain;\n    flex-shrink: 0;\n    display: block;\n  }\n\n  .ddm-title {\n    font-size: 24px;\n    font-weight: 500;\n    color: #1a1a1a;\n    margin: 0;\n    line-height: 1.35;\n    letter-spacing: 0.4px;\n  }\n\n  .ddm-desc {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    background: #fff;\n    border-radius: 8px 8px 0 0;\n    padding: 18px 16px;\n  }\n\n  .ddm-desc-icon {\n    flex-shrink: 0;\n    width: 52px;\n    height: 52px;\n    border-radius: 50%;\n    background: #e3eac8;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .ddm-desc-icon svg {\n    width: 40px;\n    height: 40px;\n  }\n\n  .ddm-desc p {\n    margin: 0;\n    font-size: 17px;\n    line-height: 1.5;\n    color: #2a2a2a;\n    letter-spacing: 0.3px;\n  }\n\n  .ddm-limits {\n    flex: 1;\n    background: #d9cbb6;\n    border-radius: 0 0 8px 8px;\n    padding: 16px 16px 24px;\n  }\n\n  .ddm-limits-title {\n    font-size: 17px;\n    font-weight: 600;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n    letter-spacing: 0.3px;\n  }\n\n  .ddm-limits ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n\n  .ddm-limits li {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    font-size: 15px;\n    line-height: 1.5;\n    color: #2a2a2a;\n    letter-spacing: 0.4px;\n    margin: 0 0 10px 0;\n  }\n\n  .ddm-limits li:last-child { margin-bottom: 0; }\n\n  .ddm-limits li svg {\n    flex-shrink: 0;\n    width: 22px;\n    height: 22px;\n    margin-top: 1px;\n  }\n\n  /* Tablet: stack cards */\n  @media (max-width: 1000px) {\n    .ddm-heading { font-size: 30px; margin-bottom: 28px; }\n    .ddm-grid {\n      grid-template-columns: minmax(0, 1fr);\n      max-width: 560px;\n      gap: 20px;\n    }\n  }\n\n  /* Mobile */\n  @media (max-width: 480px) {\n    .ddm-section { padding: 18px 12px 24px; }\n    .ddm-heading { font-size: 22px; margin-bottom: 20px; }\n    .ddm-top { min-height: 0; gap: 16px; padding: 0 4px 10px; }\n    .ddm-img { width: 80px; height: 80px; }\n    .ddm-title { font-size: 18px; }\n    .ddm-desc { gap: 12px; padding: 14px 12px; }\n    .ddm-desc-icon { width: 42px; height: 42px; }\n    .ddm-desc-icon svg { width: 32px; height: 32px; }\n    .ddm-desc p { font-size: 14px; }\n    .ddm-limits { padding: 14px 12px 18px; }\n    .ddm-limits-title { font-size: 15px; margin-bottom: 12px; }\n    .ddm-limits li { font-size: 13px; gap: 10px; }\n    .ddm-limits li svg { width: 18px; height: 18px; }\n  }\n</style>",
        "full_width": true,
