    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"breath-fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/WH_WhispProductVisuals_1_copyArtboard1_99930b72-66b3-45ea-b437-c390dfdcdb13.webp?v=1795259058\" alt=\"Anti-bad breath herbal gel jar\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Fight <span class=\"highlight\">Bad Breath &amp; Body Odor</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      Meet the daily gel made for the bad breath and body odor that mints, gum and mouthwash only cover up.\n    </p>\n\n    <p class=\"fade-text\">\n      Most quick fixes only work on the surface and wear off within minutes. This gel works from the inside, every day, so you stay fresh from your morning coffee to your last conversation at night.\n    </p>\n\n    <p class=\"fade-text\">\n      Just a small spoonful as part of your daily routine, and you'll feel fresher as the days go by. No sugar, no harsh taste, no hiding your breath anymore.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Fresher breath all day</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Fights body odor from within</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .breath-fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #9fb06c;\n    padding-top: 20px;\n  }\n\n  .breath-fade-section .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .breath-fade-section .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .breath-fade-section .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .breath-fade-section .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1f2a22;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .breath-fade-section .highlight {\n    background: #6f8a3c;\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .breath-fade-section .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1f2a22;\n    margin: 0 0 16px 0;\n  }\n\n  .breath-fade-section .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .breath-fade-section .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1f2a22;\n  }\n\n  .breath-fade-section .sparkle {\n    color: #6f8a3c;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .breath-fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .breath-fade-section .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .breath-fade-section .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .breath-fade-section .fade-highlights {\n      gap: 14px;\n    }\n\n    .breath-fade-section .highlight-item {\n      font-size: 12.5px;\n    }\n\n    .breath-fade-section .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
