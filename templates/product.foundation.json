    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .lb-section {\n    max-width: 1200px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 40px 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n    position: relative;\n  }\n  .lb-title-wrap {\n    text-align: center;\n    margin-bottom: 30px;\n    position: relative;\n  }\n  .lb-title {\n    font-size: clamp(26px, 4.5vw, 38px);\n    font-weight: 800;\n    color: #1a1a1a;\n    position: relative;\n    display: inline-block;\n  }\n  .lb-circle {\n    position: absolute;\n    top: -14px;\n    left: 50%;\n    transform: translateX(-6%);\n    width: 46%;\n    min-width: 130px;\n    pointer-events: none;\n  }\n  .lb-circle svg {\n    width: 100%;\n    height: auto;\n    display: block;\n    color: #E88BA5;\n  }\n  .lb-carousel-wrap {\n    position: relative;\n  }\n  .lb-track-outer {\n    overflow: hidden;\n  }\n  .lb-track {\n    display: flex;\n    gap: 16px;\n    transition: transform 0.4s ease;\n  }\n  .lb-card {\n    flex: 0 0 calc(25% - 12px);\n    min-width: 220px;\n    background: #fff;\n    border-radius: 14px;\n    overflow: hidden;\n    box-shadow: 0 1px 4px rgba(0,0,0,0.08);\n  }\n  .lb-photo {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n  }\n  .lb-photo img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .lb-card-body {\n    padding: 14px 16px 18px;\n  }\n  .lb-card-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 6px;\n  }\n  .lb-name {\n    font-size: clamp(14px, 1.9vw, 15.5px);\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .lb-stars {\n    display: flex;\n    gap: 1px;\n  }\n  .lb-stars svg {\n    width: 13px;\n    height: 13px;\n    color: #D96E86;\n  }\n  .lb-verified {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    font-size: 11px;\n    font-weight: 700;\n    color: #D96E86;\n    text-transform: uppercase;\n    letter-spacing: 0.3