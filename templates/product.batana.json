      "settings": {
        "custom_liquid": "<style>\n  .batana-features {\n    background-color: #FBF8ED;\n    padding: clamp(32px, 6vw, 72px) clamp(20px, 6vw, 56px);\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    font-family: Georgia, 'Times New Roman', serif;\n    text-align: center;\n  }\n\n  .batana-features * {\n    box-sizing: border-box;\n  }\n\n  .batana-features__heading {\n    font-size: clamp(28px, 5.5vw, 48px);\n    line-height: 1.2;\n    color: #1B3B2F;\n    margin: 0 0 clamp(16px, 3vw, 24px) 0;\n    font-weight: 400;\n  }\n\n  .batana-features__subtext {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(14px, 2.4vw, 18px);\n    line-height: 1.6;\n    color: #2b2b28;\n    max-width: 640px;\n    margin: 0 auto clamp(32px, 6vw, 56px) auto;\n  }\n\n  .batana-features__grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: clamp(24px, 4vw, 40px);\n  }\n\n  .batana-features__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .batana-features__badge {\n    width: clamp(64px, 12vw, 96px);\n    height: clamp(64px, 12vw, 96px);\n    border-radius: 50%;\n    background-color: #EDE7D6;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: clamp(14px, 2.5vw, 20px);\n  }\n\n  .batana-features__icon {\n    width: clamp(30px, 5.5vw, 42px);\n    height: clamp(30px, 5.5vw, 42px);\n  }\n\n  .batana-features__title {\n    font-size: clamp(15px, 2.4vw, 20px);\n    color: #1B3B2F;\n    margin: 0 0 8px 0;\n    font-weight: 400;\n  }\n\n  .batana-features__desc {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(11px, 1.9vw, 14px);\n    line-height: 1.55;\n    color: #4a4a45;\n    margin: 0;\n    max-width: 220px;\n  }\n\n  @media (max-width: 700px) {\n    .batana-features__grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n</style>\n\n<div class=\"batana-features\">\n  <h2 class=\"batana-features__heading\">Thousands of <br>queens choose our oil</h2>\n  <p class=\"batana-features__subtext\">\n    In a world full of chemical-laced fakes, thousands of queens choose the original-Batana Oil\n  </p>\n\n  <div class=\"batana-features__grid\">\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M20 10 C20 10 30 12 34 20 C36 24 35 28 32 30 C28 26 24 22 20 10 Z\" stroke=\"#1B3B2F\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/>\n          <path d=\"M20 10 C23 14 25 18 26 22\" stroke=\"#1B3B2F\" stroke-width=\"1.2\"/>\n          <path d=\"M22 14 C24 15 26 17 27 19\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <path d=\"M24 18 C26 19 28 21 29 23\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <path d=\"M20 10 C17 13 15 16 14 19\" stroke=\"#1B3B2F\" stroke-width=\"1.2\"/>\n          <path d=\"M18 13 C16 14 14 16 13 18\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <path d=\"M16 16 C14 17 12 19 11 21\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <circle cx=\"14\" cy=\"12\" r=\"0.8\" fill=\"#1B3B2F\"/>\n          <path d=\"M31 29 C31 31 29.5 32.5 28.5 33.5 C27.5 32.5 26 31 26 29 C26 27.3 27.3 26 28.5 26 C29.7 26 31 27.3 31 29 Z\" fill=\"#E7A93C\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <path d=\"M35 32 C35 33.5 34 34.6 33.2 35.4 C32.4 34.6 31.4 33.5 31.4 32 C31.4 30.7 32.3 29.8 33.2 29.8 C34.1 29.8 35 30.7 35 32 Z\" fill=\"#E7A93C\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">100% Pure Batana Oil</h3>\n      <p class=\"batana-features__desc\">Sourced directly from the American palm tree, no fillers or blends.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <rect x=\"12\" y=\"26\" width=\"18\" height=\"12\" rx=\"2\" fill=\"#E7A93C\" opacity=\"0.35\" stroke=\"#1B3B2F\" stroke-width=\"1.4\"/>\n          <path d=\"M21 26 C21 20 21 15 24 11 C25 9.5 26.5 9 27 10 C27.5 11 26 12.5 25 13.5\" stroke=\"#1B3B2F\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <circle cx=\"21\" cy=\"30\" r=\"3\" fill=\"#FBF8ED\" stroke=\"#1B3B2F\" stroke-width=\"1.4\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Hair Growth Focused</h3>\n      <p class=\"batana-features__desc\">Traditionally used to revive thinning edges &amp; bald spots.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M24 12 L26 20 L34 22 L26 24 L24 32 L22 24 L14 22 L22 20 Z\" fill=\"#E7A93C\" stroke=\"#1B3B2F\" stroke-width=\"1.2\" stroke-linejoin=\"round\"/>\n          <path d=\"M33 28 L34 32 L38 33 L34 34 L33 38 L32 34 L28 33 L32 32 Z\" fill=\"#EDE7D6\" stroke=\"#1B3B2F\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Deeply Restorative</h3>\n      <p class=\"batana-features__desc\">Repairs breakage, dryness, and split ends from root to tip.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M24 12 C31 12 36 17 36 24 C36 31 31 36 24 36 C17 36 12 31 12 24 C12 17 17 12 24 12 Z\" stroke=\"#1B3B2F\" stroke-width=\"1.4\"/>\n          <path d=\"M18 24 C18 24 20 18 24 18 C28 18 26 26 24 30 C22 34 18 30 18 24 Z\" fill=\"#E7A93C\" opacity=\"0.5\" stroke=\"#1B3B2F\" stroke-width=\"1.2\"/>\n          <path d=\"M24 18 L24 30\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Lightweight &amp; Absorbent</h3>\n      <p class=\"batana-features__desc\">Nourishes your hair and scalp deeply, without greasiness or buildup.</p>\n    </div>\n  </div>\n</div>",
