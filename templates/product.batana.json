    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .batana-timeline {\n    background-color: #EEEEE4;\n    padding: clamp(28px, 5vw, 56px) clamp(20px, 6vw, 56px);\n    max-width: 1100px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    font-family: Georgia, 'Times New Roman', serif;\n  }\n\n  .batana-timeline * {\n    box-sizing: border-box;\n  }\n\n  .batana-timeline__heading {\n    font-size: clamp(28px, 6vw, 52px);\n    line-height: 1.15;\n    color: #1B3B2F;\n    margin: 0 0 clamp(24px, 5vw, 40px) 0;\n    font-weight: 400;\n  }\n\n  .batana-timeline__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: clamp(16px, 3vw, 24px);\n  }\n\n  .batana-timeline__card {\n    background-color: #FBF8ED;\n    border: 1px solid #D9D6C6;\n    border-radius: 10px;\n    padding: clamp(18px, 3vw, 28px);\n  }\n\n  .batana-timeline__top {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: clamp(14px, 2.5vw, 20px);\n  }\n\n  .batana-timeline__dot {\n    flex: 0 0 auto;\n    width: clamp(28px, 4vw, 36px);\n    height: clamp(28px, 4vw, 36px);\n    border-radius: 50%;\n    background-color: #4FA187;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .batana-timeline__dot span {\n    width: 45%;\n    height: 45%;\n    border-radius: 50%;\n    background-color: #1B3B2F;\n  }\n\n  .batana-timeline__badge {\n    background-color: #F2B84D;\n    color: #1B3B2F;\n    font-family: Helvetica, Arial, sans-serif;\n    font-weight: 700;\n    font-size: clamp(12px, 1.8vw, 14px);\n    padding: 6px 16px;\n    border-radius: 999px;\n    white-space: nowrap;\n  }\n\n  .batana-timeline__title {\n    font-size: clamp(17px, 2.6vw, 22px);\n    color: #12261E;\n    font-weight: 700;\n    line-height: 1.3;\n    margin: 0 0 10px 0;\n  }\n\n  .batana-timeline__desc {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(13px, 1.9vw, 15px);\n    line-height: 1.6;\n    color: #3a3a35;\n    margin: 0;\n  }\n\n  @media (max-width: 640px) {\n    .batana-timeline__grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"batana-timeline\">\n  <h2 class=\"batana-timeline__heading\">Results to expect over time</h2>\n\n  <div class=\"batana-timeline__grid\">\n    <div class=\"batana-timeline__card\">\n      <div class=\"batana-timeline__top\">\n        <div class=\"batana-timeline__dot\"><span></span></div>\n        <div class=\"batana-timeline__badge\">Day 1-7</div>\n      </div>\n      <h3 class=\"batana-timeline__title\">Deep Nourishment &amp; Relief</h3>\n      <p class=\"batana-timeline__desc\">Dryness fades quickly as the oil penetrates deep into scalp and hair shafts. Irritation calms, hair feels softer and less brittle, and natural shine begins to return.</p>\n    </div>\n\n    <div class=\"batana-timeline__card\">\n      <div class=\"batana-timeline__top\">\n        <div class=\"batana-timeline__dot\"><span></span></div>\n        <div class=\"batana-timeline__badge\">Week 2&ndash;4</div>\n      </div>\n      <h3 class=\"batana-timeline__title\">Stronger Strands, Reduced Shedding</h3>\n      <p class=\"batana-timeline__desc\">Consistent use strengthens the roots and minimizes breakage. You&rsquo;ll notice fewer hairs on your pillow and in the shower. Scalp feels healthier and more balanced, helping to slow early thinning and alopecia-related shedding.</p>\n    </div>\n\n    <div class=\"batana-timeline__card\">\n      <div class=\"batana-timeline__top\">\n        <div class=\"batana-timeline__dot\"><span></span></div>\n        <div class=\"batana-timeline__badge\">Month 2</div>\n      </div>\n      <h3 class=\"batana-timeline__title\">Edges &amp; Alopecia Patches Begin to Fill In</h3>\n      <p class=\"batana-timeline__desc\">Thin or patchy areas especially around the hairline, edges, and alopecia spots show early signs of regrowth. New baby hairs begin to sprout, giving the hairline a fuller, more defined look.</p>\n    </div>\n\n    <div class=\"batana-timeline__card\">\n      <div class=\"batana-timeline__top\">\n        <div class=\"batana-timeline__dot\"><span></span></div>\n        <div class=\"batana-timeline__badge\">Month 3+</div>\n      </div>\n      <h3 class=\"batana-timeline__title\">Thicker, Healthier Growth</h3>\n      <p class=\"batana-timeline__desc\">Edges continue to thicken, alopecia patches improve, overall volume increases, and hair looks visibly stronger and denser. With less shedding and improved scalp health, growth feels consistent and long-lasting.</p>\n    </div>\n  </div>\n</div>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
