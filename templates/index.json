    "custom_liquid_LWEg3f": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>JOLIE — Where Beauty Is Crafted</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/>\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin/>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=DM+Sans:wght@300;400;500&family=Cormorant:ital,wght@0,300;0,400;1,300;1,400&display=swap\" rel=\"stylesheet\"/>\n<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n:root{\n  --cream:#FAF6F1;\n  --warm-white:#FDF9F5;\n  --blush:#E8C4B0;\n  --rose:#C9836A;\n  --deep-rose:#A05840;\n  --charcoal:#1C1915;\n  --mid:#6B5C52;\n  --gold:#C9A96E;\n  --gold-light:#E8D5A8;\n  --magenta:#FF2D7A;\n  --off-white:#F5EFE8;\n}\nhtml{scroll-behavior:smooth}\nbody{background:var(--cream);color:var(--charcoal);font-family:'DM Sans',sans-serif;overflow-x:hidden}\n\n/* ── HERO ── */\n.hero{\n  position:relative;height:100vh;min-height:620px;\n  display:flex;align-items:flex-end;overflow:hidden;\n}\n.hero-img{\n  position:absolute;inset:0;width:100%;height:100%;\n  object-fit:cover;object-position:center top;\n}\n.hero-overlay{\n  position:absolute;inset:0;\n  background:rgba(28,25,21,0.68);\n}\n.hero-content{\n  position:relative;z-index:2;\n  padding:0 80px 100px;max-width:660px;\n}\n.hero-eyebrow{\n  font-size:10px;letter-spacing:0.45em;text-transform:uppercase;\n  color:var(--gold);margin-bottom:22px;\n  opacity:0;transform:translateY(16px);\n  animation:fadeUp 0.8s ease forwards 0.3s;\n}\n.hero-title{\n  font-family:'Playfair Display',serif;\n  font-size:clamp(3rem,5.5vw,5rem);font-weight:400;\n  color:#fff;line-height:1.08;margin-bottom:26px;\n  opacity:0;transform:translateY(24px);\n  animation:fadeUp 0.9s ease forwards 0.5s;\n}\n.hero-title em{font-style:italic;color:var(--gold-light)}\n.hero-sub{\n  font-size:15px;color:rgba(255,255,255,0.58);line-height:1.75;\n  margin-bottom:42px;font-weight:300;max-width:400px;\n  opacity:0;transform:translateY(16px);\n  animation:fadeUp 0.8s ease forwards 0.7s;\n}\n.hero-cta{\n  display:inline-block;\n  background:var(--gold);color:var(--charcoal);\n  padding:15px 38px;font-size:11px;letter-spacing:0.22em;\n  text-transform:uppercase;font-weight:500;text-decoration:none;\n  position:relative;overflow:hidden;\n  opacity:0;transform:translateY(16px);\n  animation:fadeUp 0.8s ease forwards 0.9s;\n  transition:color 0.35s;\n}\n.hero-cta::before{\n  content:'';position:absolute;inset:0;\n  background:var(--charcoal);transform:scaleX(0);transform-origin:left;\n  transition:transform 0.35s ease;z-index:0;\n}\n.hero-cta:hover::before{transform:scaleX(1)}\n.hero-cta:hover{color:#fff}\n.hero-cta span{position:relative;z-index:1}\n\n.hero-badge{\n  position:absolute;top:50%;right:90px;\n  transform:translateY(-50%);\n  width:108px;height:108px;border-radius:50%;\n  background:var(--magenta);\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\n  text-align:center;z-index:3;\n  opacity:0;animation:fadeIn 1s ease forwards 1.2s;\n}\n.hero-badge .pct{font-size:30px;font-weight:700;color:#fff;line-height:1}\n.hero-badge .off{font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.85);margin-top:3px}\n\n.hero-scroll{\n  position:absolute;bottom:38px;left:50%;transform:translateX(-50%);\n  z-index:3;display:flex;flex-direction:column;align-items:center;gap:8px;\n  opacity:0;animation:fadeIn 1s ease forwards 1.5s;\n}\n.hero-scroll span{font-size:9px;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,255,255,0.38)}\n.scroll-line{width:1px;height:38px;background:linear-gradient(to bottom,rgba(255,255,255,0.3),transparent);animation:scrollAnim 1.6s ease infinite}\n\n@keyframes fadeUp{to{opacity:1;transform:translateY(0)}}\n@keyframes fadeIn{to{opacity:1}}\n@keyframes scrollAnim{\n  0%{transform:scaleY(0);transform-origin:top}\n  50%{transform:scaleY(1);transform-origin:top}\n  51%{transform:scaleY(1);transform-origin:bottom}\n  100%{transform:scaleY(0);transform-origin:bottom}\n}\n\n/* ── MARQUEE ── */\n.marquee-wrap{background:var(--charcoal);overflow:hidden;padding:15px 0;position:relative}\n.marquee-track{display:flex;width:max-content;white-space:nowrap;will-change:transform}\n.marquee-item{\n  font-family:'Cormorant',serif;font-style:italic;font-size:17px;\n  color:rgba(255,255,255,0.5);padding:0 36px;\n  display:flex;align-items:center;gap:18px;\n}\n.marquee-dot{width:3px;height:3px;border-radius:50%;background:var(--gold);flex-shrink:0}\n@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n/* ── SHARED ── */\n.section-label{font-size:10px;letter-spacing:0.42em;text-transform:uppercase;color:var(--rose);font-weight:500;margin-bottom:12px}\n.section-title{font-family:'Playfair Display',serif;font-size:clamp(2rem,3.5vw,2.8rem);font-weight:400;line-height:1.2;color:var(--charcoal)}\n.section-title em{font-style:italic;color:var(--rose)}\n\n/* ── PRODUCTS ── */\n.products-section{padding:100px 80px;background:var(--warm-white)}\n.products-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px}\n.products-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}\n\n.product-card{\n  display:block;text-decoration:none;color:inherit;\n  opacity:0;transform:translateY(36px);\n  transition:opacity 0.6s ease,transform 0.6s ease;\n}\n.product-card.visible{opacity:1;transform:translateY(0)}\n.product-card:nth-child(2){transition-delay:.1s}\n.product-card:nth-child(3){transition-delay:.2s}\n.product-card:nth-child(4){transition-delay:.3s}\n\n.product-img-wrap{\n  position:relative;aspect-ratio:3/4;overflow:hidden;\n  background:var(--off-white);margin-bottom:16px;\n}\n.product-img-wrap img{\n  width:100%;height:100%;object-fit:cover;\n  transition:transform 0.6s ease;\n}\n.product-card:hover .product-img-wrap img{transform:scale(1.05)}\n.product-img-wrap::after{\n  content:'';position:absolute;inset:0;\n  background:linear-gradient(to top,rgba(28,25,21,0.18) 0%,transparent 50%);\n}\n\n.product-badge{\n  position:absolute;top:12px;left:12px;\n  font-size:9px;letter-spacing:0.14em;text-transform:uppercase;\n  font-weight:500;padding:4px 10px;z-index:2;\n}\n.badge-sale{background:var(--magenta);color:#fff}\n.badge-pct{background:var(--charcoal);color:#fff}\n\n.product-name{\n  font-family:'Playfair Display',serif;font-size:14.5px;\n  font-weight:400;color:var(--charcoal);margin-bottom:6px;line-height:1.3;\n}\n.product-price{display:flex;gap:9px;align-items:center}\n.price-old{font-size:12px;color:var(--mid);text-decoration:line-through}\n.price-new{font-size:14px;color:var(--rose);font-weight:500}\n\n/* ── TRUST STRIP ── */\n.trust-strip{\n  background:var(--magenta);padding:20px 80px;\n  display:flex;gap:0;overflow:hidden;\n}\n.trust-item{\n  flex:1;display:flex;align-items:center;justify-content:center;gap:10px;\n  padding:0 20px;border-right:1px solid rgba(255,255,255,0.2);\n}\n.trust-item:last-child{border-right:none}\n.trust-item span{font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#fff;white-space:nowrap}\n\n/* ── ABOUT ── */\n.about-section{display:grid;grid-template-columns:1fr 1fr;min-height:580px}\n.about-visual{\n  background:linear-gradient(145deg,#241A16 0%,#3D2820 50%,#5C3425 100%);\n  display:flex;align-items:center;justify-content:center;\n  position:relative;overflow:hidden;padding:60px 50px;\n}\n.about-visual::before{\n  content:'';position:absolute;\n  width:380px;height:380px;border-radius:50%;\n  background:radial-gradient(circle,rgba(201,163,110,0.15) 0%,transparent 70%);\n  top:-60px;left:-60px;\n}\n.about-visual::after{\n  content:'';position:absolute;\n  width:250px;height:250px;border-radius:50%;\n  background:radial-gradient(circle,rgba(255,45,122,0.08) 0%,transparent 70%);\n  bottom:-40px;right:-40px;\n}\n.about-stats{position:relative;z-index:1;display:flex;flex-direction:column;gap:0;width:100%}\n.about-stat-row{\n  padding:32px 0;border-bottom:1px solid rgba(255,255,255,0.07);\n  display:flex;align-items:center;justify-content:space-between;\n}\n.about-stat-row:last-child{border-bottom:none}\n.stat-num{\n  font-family:'Playfair Display',serif;\n  font-size:clamp(2.2rem,4vw,3.2rem);font-weight:400;\n  color:var(--gold-light);line-height:1;\n}\n.stat-label{\n  font-size:11px;letter-spacing:0.25em;text-transform:uppercase;\n  color:rgba(255,255,255,0.4);text-align:right;max-width:140px;line-height:1.5;\n}\n\n.about-content{\n  background:var(--off-white);\n  display:flex;flex-direction:column;justify-content:center;\n  padding:80px;\n}\n.about-content .section-label{margin-bottom:14px}\n.about-content .section-title{margin-bottom:26px}\n.about-body{\n  font-size:15px;line-height:1.85;color:var(--mid);\n  margin-bottom:36px;font-weight:300;\n}\n.about-values{display:flex;flex-direction:column;gap:14px}\n.value-item{display:flex;gap:14px;align-items:flex-start}\n.value-dot{width:5px;height:5px;border-radius:50%;background:var(--rose);flex-shrink:0;margin-top:7px}\n.value-text{font-size:13px;color:var(--mid);line-height:1.55}\n.value-text strong{display:block;color:var(--charcoal);font-weight:500;font-size:13px;margin-bottom:1px}\n\n/* ── WHY JOLIE ── */\n.why-section{\n  padding:100px 80px;background:var(--charcoal);\n  position:relative;overflow:hidden;\n}\n.why-section::before{\n  content:'';position:absolute;\n  top:-120px;right:-80px;width:500px;height:500px;border-radius:50%;\n  background:radial-gradient(circle,rgba(201,163,110,0.06) 0%,transparent 70%);\n}\n.why-header{text-align:center;margin-bottom:70px}\n.why-header .section-label{color:var(--gold)}\n.why-header .section-title{color:#fff}\n.why-header .section-title em{color:var(--gold-light)}\n.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}\n.why-item{\n  background:rgba(255,255,255,0.03);\n  border:1px solid rgba(255,255,255,0.05);\n  padding:48px 38px;position:relative;\n  transition:background 0.3s;\n}\n.why-item:hover{background:rgba(255,255,255,0.06)}\n.why-num{\n  font-family:'Playfair Display',serif;font-size:72px;font-weight:400;\n  color:rgba(255,255,255,0.04);line-height:1;\n  position:absolute;top:18px;right:22px;\n}\n.why-icon{\n  width:50px;height:50px;border-radius:50%;\n  background:rgba(201,163,110,0.08);border:1px solid rgba(201,163,110,0.18);\n  display:flex;align-items:center;justify-content:center;\n  font-size:20px;margin-bottom:22px;\n}\n.why-name{\n  font-family:'Playfair Display',serif;font-size:19px;\n  font-weight:400;color:#fff;margin-bottom:12px;\n}\n.why-desc{font-size:13px;line-height:1.78;color:rgba(255,255,255,0.42);font-weight:300}\n\n/* ── REVIEWS ── */\n.reviews-section{padding:100px 80px;background:var(--warm-white)}\n.reviews-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px}\n.rating-summary{display:flex;flex-direction:column;align-items:flex-end;gap:4px}\n.rating-big{font-family:'Playfair Display',serif;font-size:46px;font-weight:400;color:var(--charcoal);line-height:1}\n.rating-stars{color:var(--gold);font-size:15px;letter-spacing:2px}\n.rating-count{font-size:12px;color:var(--mid)}\n\n.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:16px}\n.review-card{\n  background:#fff;padding:30px;border:1px solid rgba(0,0,0,0.05);\n  opacity:0;transform:translateY(28px);\n  transition:opacity 0.55s ease,transform 0.55s ease;\n}\n.review-card.visible{opacity:1;transform:translateY(0)}\n.review-card:nth-child(2){transition-delay:.1s}\n.review-card:nth-child(3){transition-delay:.2s}\n.review-quote{font-family:'Playfair Display',serif;font-size:30px;color:var(--gold-light);line-height:1;margin-bottom:10px}\n.review-stars{color:var(--gold);font-size:11px;letter-spacing:1px;margin-bottom:14px}\n.review-text{font-size:13.5px;line-height:1.76;color:var(--mid);font-style:italic;margin-bottom:22px;font-weight:300}\n.review-footer{display:flex;align-items:center;gap:11px;padding-top:18px;border-top:1px solid rgba(0,0,0,0.05)}\n.review-avatar{\n  width:34px;height:34px;border-radius:50%;\n  background:linear-gradient(135deg,var(--blush),var(--rose));\n  display:flex;align-items:center;justify-content:center;\n  font-size:12px;font-weight:500;color:#fff;flex-shrink:0;\n}\n.review-name{font-size:13px;font-weight:500;color:var(--charcoal);margin-bottom:1px}\n.review-meta{font-size:11px;color:var(--mid)}\n.verified{\n  margin-left:auto;background:rgba(201,131,106,0.08);color:var(--rose);\n  font-size:9px;letter-spacing:0.1em;text-transform:uppercase;\n  padding:3px 8px;font-weight:500;\n}\n\n/* ── NEWSLETTER ── */\n.nl-section{\n  background:linear-gradient(135deg,#1C1915 0%,#3A2820 60%,#4A2E24 100%);\n  padding:100px 80px;\n  display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;\n  position:relative;overflow:hidden;\n}\n.nl-section::before{\n  content:'JOLIE';position:absolute;\n  font-family:'Playfair Display',serif;font-size:220px;font-weight:700;\n  color:rgba(255,255,255,0.025);right:-10px;top:50%;transform:translateY(-50%);\n  white-space:nowrap;pointer-events:none;letter-spacing:0.04em;\n}\n.nl-info .section-label{color:var(--gold)}\n.nl-info .section-title{color:#fff;margin-bottom:18px}\n.nl-info p{font-size:14px;color:rgba(255,255,255,0.48);line-height:1.78;font-weight:300}\n.nl-perks{margin-top:30px;display:flex;flex-direction:column;gap:10px}\n.perk{display:flex;gap:11px;align-items:center;font-size:13px;color:rgba(255,255,255,0.55)}\n.perk-check{\n  width:17px;height:17px;border-radius:50%;\n  background:rgba(201,163,110,0.12);border:1px solid rgba(201,163,110,0.25);\n  display:flex;align-items:center;justify-content:center;\n  font-size:8px;color:var(--gold);flex-shrink:0;\n}\n.nl-form{}\n.nl-eyebrow{font-size:10px;letter-spacing:0.32em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:22px}\n.nl-inputs{display:flex;flex-direction:column;gap:12px}\n.nl-input{\n  background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\n  color:#fff;padding:14px 18px;font-size:14px;font-family:'DM Sans',sans-serif;\n  outline:none;width:100%;transition:border-color 0.3s;\n}\n.nl-input::placeholder{color:rgba(255,255,255,0.28)}\n.nl-input:focus{border-color:rgba(201,163,110,0.45)}\n.nl-btn{\n  background:var(--gold);color:var(--charcoal);padding:15px;\n  font-size:11px;letter-spacing:0.2em;text-transform:uppercase;font-weight:500;\n  border:none;cursor:pointer;font-family:'DM Sans',sans-serif;\n  transition:background 0.3s;\n}\n.nl-btn:hover{background:var(--gold-light)}\n.nl-note{font-size:11px;color:rgba(255,255,255,0.25);margin-top:10px}\n\n/* ── RESPONSIVE ── */\n@media(max-width:1024px){\n  .products-grid{grid-template-columns:repeat(2,1fr)}\n  .why-grid{grid-template-columns:1fr 1fr}\n}\n@media(max-width:768px){\n  .hero-content{padding:0 24px 70px}\n  .hero-img-wrap{width:100%}\n  .hero-badge{right:20px;width:88px;height:88px}\n  .hero-badge .pct{font-size:24px}\n  .products-section,.reviews-section,.why-section,.nl-section{padding:60px 24px}\n  .about-content{padding:60px 24px}\n  .products-header{flex-direction:column;align-items:flex-start;gap:14px}\n  .products-grid{grid-template-columns:repeat(2,1fr);gap:14px}\n  .about-section{grid-template-columns:1fr}\n  .trust-strip{padding:16px 24px;flex-wrap:wrap;gap:12px}\n  .trust-item{border-right:none;flex:none;width:45%}\n  .reviews-header{flex-direction:column;align-items:flex-start;gap:18px}\n  .rating-summary{align-items:flex-start}\n  .reviews-grid{grid-template-columns:1fr}\n  .nl-section{grid-template-columns:1fr;gap:40px;padding:60px 24px}\n  .why-grid{grid-template-columns:1fr}\n}\n</style>\n</head>\n<body>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <img class=\"hero-img\" src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/ChatGPT_Image_May_25_2026_05_14_53_PM.png?v=1779718528\" alt=\"Jolie Beauty\"/>\n  <div class=\"hero-overlay\"></div>\n  <div class=\"hero-content\">\n    <p class=\"hero-eyebrow\">✦ New Collection 2025</p>\n    <h1 class=\"hero-title\">Where <em>Beauty</em><br>Is Crafted</h1>\n    <p class=\"hero-sub\">Premium beauty tools and cosmetics, curated for the woman who refuses to settle. Delivered free across Lebanon.</p>\n    <a href=\"https://jolielb.com/collections/all\" class=\"hero-cta\"><span>Shop the Collection</span></a>\n  </div>\n  <div class=\"hero-badge\">\n    <span class=\"pct\">30%</span>\n    <span class=\"off\">Off Today</span>\n  </div>\n  <div class=\"hero-scroll\">\n    <span>Scroll</span>\n    <div class=\"scroll-line\"></div>\n  </div>\n</section>\n\n<!-- MARQUEE -->\n<div class=\"marquee-wrap\">\n  <div class=\"marquee-track\">\n    <div class=\"marquee-item\"><span>Winged Eyeliner Stamp</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Turmeric Fade & Glow Bar</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>3-in-1 Freckles Pen</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Changing Foundation 4-in-1</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Free Delivery Lebanon</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>30% Off Today</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Winged Eyeliner Stamp</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Turmeric Fade & Glow Bar</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>3-in-1 Freckles Pen</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Changing Foundation 4-in-1</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>Free Delivery Lebanon</span><div class=\"marquee-dot\"></div></div>\n    <div class=\"marquee-item\"><span>30% Off Today</span><div class=\"marquee-dot\"></div></div>\n  </div>\n</div>\n\n<!-- PRODUCTS -->\n<section class=\"products-section\" id=\"products\">\n  <div class=\"products-header\">\n    <div>\n      <p class=\"section-label\">Our Collection</p>\n      <h2 class=\"section-title\">Bestselling <em>Products</em></h2>\n    </div>\n    <a href=\"https://jolielb.com/collections/all\" style=\"font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:var(--charcoal);text-decoration:none;border-bottom:1px solid var(--charcoal);padding-bottom:2px\">View All →</a>\n  </div>\n  <div class=\"products-grid\">\n\n    <a class=\"product-card\" href=\"https://jolielb.com/products/jolie%E2%84%A2-winged-eyeliner-stamp\">\n      <div class=\"product-img-wrap\">\n        <span class=\"product-badge badge-sale\">Sale</span>\n        <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/408029FC-4B03-4B87-A5D1-444C8CA48802_1060x_c7cbeb07-1bb9-4b28-92a0-ceb0bcea58bf.png?v=1770406604\" alt=\"Jolie Winged Eyeliner Stamp\"/>\n      </div>\n      <div class=\"product-name\">Jolie™ Winged Eyeliner Stamp</div>\n      <div class=\"product-price\">\n        <span class=\"price-old\">$31.99</span>\n        <span class=\"price-new\">$22.99</span>\n      </div>\n    </a>\n\n    <a class=\"product-card\" href=\"https://jolielb.com/products/turmeric-fade-glow-bar\">\n      <div class=\"product-img-wrap\">\n        <span class=\"product-badge badge-pct\">-27%</span>\n        <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/ChatGPTImageMay22_2026_04_45_24PM.png?v=1779457561\" alt=\"Turmeric Fade & Glow Bar\"/>\n      </div>\n      <div class=\"product-name\">Turmeric Fade & Glow Bar</div>\n      <div class=\"product-price\">\n        <span class=\"price-old\">$30.00</span>\n        <span class=\"price-new\">$21.99</span>\n      </div>\n    </a>\n\n    <a class=\"product-card\" href=\"https://jolielb.com/products/legacare-changing-foundation-4-in-1\">\n      <div class=\"product-img-wrap\">\n        <span class=\"product-badge badge-pct\">-22%</span>\n        <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/ChatGPTImageApr17_2026_10_22_44AM.png?v=1776410655\" alt=\"LegaCare Changing Foundation 4-in-1\"/>\n      </div>\n      <div class=\"product-name\">LegaCare Changing Foundation 4-in-1</div>\n      <div class=\"product-price\">\n        <span class=\"price-old\">$33.00</span>\n        <span class=\"price-new\">$25.99</span>\n      </div>\n    </a>\n\n    <a class=\"product-card\" href=\"https://jolielb.com/products/jolie-freckles-stamp\">\n      <div class=\"product-img-wrap\">\n        <span class=\"product-badge badge-sale\">Sale</span>\n        <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/common__3099-3099-freckle-stamp-ALT-6__05.png?v=1771182216\" alt=\"3-in-1 Freckles Pen\"/>\n      </div>\n      <div class=\"product-name\">3-in-1 Freckles Pen</div>\n      <div class=\"product-price\">\n        <span class=\"price-old\">$25.00</span>\n        <span class=\"price-new\">$17.99</span>\n      </div>\n    </a>\n\n  </div>\n</section>\n\n<!-- TRUST STRIP -->\n<div class=\"trust-strip\">\n  <div class=\"trust-item\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 2L12.09 7.26L18 7.27L13.45 10.74L15.18 16L10 12.77L4.82 16L6.55 10.74L2 7.27L7.91 7.26L10 2Z\" fill=\"white\" opacity=\"0.9\"/></svg>\n    <span>Free Delivery All Over Lebanon</span>\n  </div>\n  <div class=\"trust-item\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm-.5 12L5 9.5l1.41-1.41L9.5 11.67l5.09-5.08L16 8l-6.5 6z\" fill=\"white\" opacity=\"0.9\"/></svg>\n    <span>100% Authentic</span>\n  </div>\n  <div class=\"trust-item\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 1l2.39 5.26L18 7.28l-4 3.9.94 5.5L10 14l-4.94 2.68.94-5.5-4-3.9 5.61-.02L10 1z\" fill=\"white\" opacity=\"0.9\"/></svg>\n    <span>10,000+ Happy Customers</span>\n  </div>\n  <div class=\"trust-item\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M9 12l-4-4 1.41-1.42L9 9.17l6.59-6.58L17 4l-8 8z\" fill=\"white\" opacity=\"0.9\"/></svg>\n    <span>Easy Returns</span>\n  </div>\n</div>\n\n<!-- ABOUT -->\n<section class=\"about-section\">\n  <div class=\"about-visual\">\n    <div class=\"about-stats\">\n      <div class=\"about-stat-row\">\n        <div class=\"stat-num\">10K+</div>\n        <div class=\"stat-label\">Happy Customers</div>\n      </div>\n      <div class=\"about-stat-row\">\n        <div class=\"stat-num\">4.9 ★</div>\n        <div class=\"stat-label\">Average Rating</div>\n      </div>\n      <div class=\"about-stat-row\">\n        <div class=\"stat-num\">100%</div>\n        <div class=\"stat-label\">Free Delivery Lebanon</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"about-content\">\n    <p class=\"section-label\">About Jolie</p>\n    <h2 class=\"section-title\">Beauty built for<br><em>real women</em></h2>\n    <p class=\"about-body\">Jolie was born from a simple belief: every woman deserves beauty tools that actually work. We curate premium cosmetics and beauty essentials — crafted to make your routine effortless and your results flawless, delivered free right to your door in Lebanon.</p>\n    <div class=\"about-values\">\n      <div class=\"value-item\">\n        <div class=\"value-dot\"></div>\n        <div class=\"value-text\"><strong>Premium Quality</strong>Every product hand-selected for real performance</div>\n      </div>\n      <div class=\"value-item\">\n        <div class=\"value-dot\"></div>\n        <div class=\"value-text\"><strong>Lebanon-First</strong>Free delivery across the country, always</div>\n      </div>\n      <div class=\"value-item\">\n        <div class=\"value-dot\"></div>\n        <div class=\"value-text\"><strong>Effortless Results</strong>Tools that do the work, so you don't have to</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- WHY JOLIE -->\n<section class=\"why-section\">\n  <div class=\"why-header\">\n    <p class=\"section-label\">The Jolie Promise</p>\n    <h2 class=\"section-title\" style=\"color:#fff\">Why thousands choose <em>Jolie</em></h2>\n  </div>\n  <div class=\"why-grid\">\n    <div class=\"why-item\">\n      <div class=\"why-num\">01</div>\n      <div class=\"why-icon\">💎</div>\n      <div class=\"why-name\">Premium Curation</div>\n      <p class=\"why-desc\">Every product is rigorously tested and hand-selected. If it doesn't perform, it doesn't make the cut.</p>\n    </div>\n    <div class=\"why-item\">\n      <div class=\"why-num\">02</div>\n      <div class=\"why-icon\">🚀</div>\n      <div class=\"why-name\">Fast Local Delivery</div>\n      <p class=\"why-desc\">Based in Lebanon, shipping to Lebanon. Free delivery on every order, to every corner of the country.</p>\n    </div>\n    <div class=\"why-item\">\n      <div class=\"why-num\">03</div>\n      <div class=\"why-icon\">🛡️</div>\n      <div class=\"why-name\">100% Authentic</div>\n      <p class=\"why-desc\">We only carry genuine products. What you see is what you get — no fakes, no compromises, ever.</p>\n    </div>\n  </div>\n</section>\n\n<!-- REVIEWS -->\n<section class=\"reviews-section\">\n  <div class=\"reviews-header\">\n    <div>\n      <p class=\"section-label\">Real Reviews</p>\n      <h2 class=\"section-title\">What our girls<br><em>are saying</em></h2>\n    </div>\n    <div class=\"rating-summary\">\n      <div class=\"rating-big\">4.9</div>\n      <div class=\"rating-stars\">★★★★★</div>\n      <div class=\"rating-count\">10,000+ verified reviews</div>\n    </div>\n  </div>\n  <div class=\"reviews-grid\">\n    <div class=\"review-card\">\n      <div class=\"review-quote\">\"</div>\n      <div class=\"review-stars\">★★★★★</div>\n      <p class=\"review-text\">I've tried every eyeliner tool out there. This stamp is genuinely different — my wings come out identical every single morning. I've recommended it to literally everyone I know.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-avatar\">S</div>\n        <div><div class=\"review-name\">Sara M.</div><div class=\"review-meta\">Eyeliner Stamp · Beirut</div></div>\n        <span class=\"verified\">✓ Verified</span>\n      </div>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-quote\">\"</div>\n      <div class=\"review-stars\">★★★★★</div>\n      <p class=\"review-text\">The Turmeric Glow Bar actually works. My skin looks brighter after just a week. The formula is so gentle and it smells amazing. A permanent part of my routine now.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-avatar\" style=\"background:linear-gradient(135deg,#E8D5A8,#C9A96E)\">L</div>\n        <div><div class=\"review-name\">Lara K.</div><div class=\"review-meta\">Turmeric Glow Bar · Tripoli</div></div>\n        <span class=\"verified\">✓ Verified</span>\n      </div>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-quote\">\"</div>\n      <div class=\"review-stars\">★★★★★</div>\n      <p class=\"review-text\">The Freckles Pen is so realistic — people keep asking if they're real! Delivery was super fast too. Jolie is the only beauty store I fully trust now.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-avatar\" style=\"background:linear-gradient(135deg,#D8C8E8,#9070B8)\">N</div>\n        <div><div class=\"review-name\">Nour H.</div><div class=\"review-meta\">Freckles Pen · Jounieh</div></div>\n        <span class=\"verified\">✓ Verified</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- NEWSLETTER -->\n<section class=\"nl-section\">\n  <div class=\"nl-info\">\n    <p class=\"section-label\">Stay in the Loop</p>\n    <h2 class=\"section-title\">Exclusive deals,<br><em>first access.</em></h2>\n    <p>Join the Jolie community and be the first to know about new arrivals, flash sales, and beauty tips.</p>\n    <div class=\"nl-perks\">\n      <div class=\"perk\"><div class=\"perk-check\">✓</div>Early access to new products</div>\n      <div class=\"perk\"><div class=\"perk-check\">✓</div>Exclusive member-only discounts</div>\n      <div class=\"perk\"><div class=\"perk-check\">✓</div>Beauty tips & tutorials</div>\n      <div class=\"perk\"><div class=\"perk-check\">✓</div>Flash sale alerts</div>\n    </div>\n  </div>\n  <div class=\"nl-form\">\n    <p class=\"nl-eyebrow\">Join Free — No Spam, Ever</p>\n    <div class=\"nl-inputs\">\n      <input class=\"nl-input\" type=\"text\" placeholder=\"Your name\"/>\n      <input class=\"nl-input\" type=\"email\" placeholder=\"Your email address\"/>\n      <button class=\"nl-btn\">Join the Jolie Community →</button>\n    </div>\n    <p class=\"nl-note\">Unsubscribe anytime. We respect your inbox.</p>\n  </div>\n</section>\n\n<script>\n// Scroll reveal\nconst observer = new IntersectionObserver((entries) => {\n  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible') });\n}, {threshold: 0.08});\ndocument.querySelectorAll('.product-card, .review-card').forEach(el => observer.observe(el));\n\n// Marquee — JS pixel scroll, always works\n(function(){\n  const track = document.querySelector('.marquee-track');\n  if(!track) return;\n  // Clone items for seamless loop\n  const items = track.innerHTML;\n  track.innerHTML = items + items;\n  let x = 0;\n  const speed = 0.6; // px per frame\n  function tick(){\n    x -= speed;\n    // Reset when first copy has scrolled fully\n    if(Math.abs(x) >= track.scrollWidth / 2) x = 0;\n    track.style.transform = `translateX(${x}px)`;\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</body>\n</html>",
