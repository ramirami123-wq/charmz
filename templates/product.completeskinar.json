      "settings": {
        "custom_liquid": "<div class=\"whats-inside-section\">\n  <h2 class=\"whats-inside-heading\">What's Inside Your Routine</h2>\n  <div class=\"whats-inside-grid\">\n    <div class=\"wi-card wi-green\">\n      <p class=\"wi-step\">Step 1</p>\n      <p class=\"wi-name\">Aloe PDRN Calming Serum</p>\n      <p class=\"wi-desc\">Calms redness and irritation, strengthens your barrier overnight.</p>\n    </div>\n    <div class=\"wi-card wi-yellow\">\n      <p class=\"wi-step\">Step 2</p>\n      <p class=\"wi-name\">Vitamin Illuminating Cream</p>\n      <p class=\"wi-desc\">Fades dark spots and brightens dull, uneven tone.</p>\n    </div>\n    <div class=\"wi-card wi-purple\">\n      <p class=\"wi-step\">Step 3</p>\n      <p class=\"wi-name\">Bakuchiol Plumping Serum</p>\n      <p class=\"wi-desc\">Tightens pores and smooths fine lines with a gentle retinol alternative.</p>\n    </div>\n    <div class=\"wi-card wi-purple2\">\n      <p class=\"wi-step\">Step 4</p>\n      <p class=\"wi-name\">Bakuchiol Plumping Capsule Cream</p>\n      <p class=\"wi-desc\">Seals everything in, boosts firmness and elasticity while you sleep.</p>\n    </div>\n  </div>\n</div>\n<style>\n  .whats-inside-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n  .whats-inside-heading {\n    text-align: center;\n    font-size: 24px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n  .whats-inside-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n  .wi-card {\n    border-radius: 12px;\n    padding: 20px 16px;\n    box-sizing: border-box;\n  }\n  .wi-green { background: #eaf4e5; }\n  .wi-yellow { background: #fdf3d0; }\n  .wi-purple { background: #f0e6f7; }\n  .wi-purple2 { background: #e9d9f4; }\n  .wi-step {\n    font-size: 11px;\n    font-weight: 700;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin: 0 0 6px 0;\n  }\n  .wi-name {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin: 0 0 8px 0;\n  }\n  .wi-desc {\n    font-size: 13px;\n    line-height: 1.45;\n    color: #444;\n    margin: 0;\n  }\n  @media (max-width: 900px) {\n    .whats-inside-grid { grid-template-columns: repeat(2, 1fr); }\n  }\n  @media (max-width: 480px) {\n    .whats-inside-heading { font-size: 19px; }\n    .whats-inside-grid { gap: 12px; }\n  }\n</style>",
