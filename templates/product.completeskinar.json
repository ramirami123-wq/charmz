 padding-bottom: 30px;\n    border-bottom: 1px solid #e5e5e5;\n  }\n  .agg-stat-number {\n    font-size: 34px;\n    font-weight: 800;\n    color: #b5384a;\n    margin: 0 0 6px 0;\n  }\n  .agg-stat-label {\n    font-size: 13px;\n    color: #555;\n    margin: 0;\n    max-width: 160px;\n  }\n  .agg-proof-quotes {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .agg-quote {\n    background: #faf5f6;\n    border-radius: 12px;\n    padding: 22px;\n    box-sizing: border-box;\n  }\n  .agg-quote-stars {\n    color: #b5384a;\n    font-size: 14px;\n    letter-spacing: 1px;\n    margin-bottom: 10px;\n  }\n  .agg-quote-text {\n    font-size: 14px;\n    line-height: 1.55;\n    color: #1a1a1a;\n    margin: 0 0 12px 0;\n  }\n  .agg-quote-name {\n    font-size: 12.5px;\n    font-weight: 700;\n    color: #555;\n    margin: 0;\n  }\n  @media (max-width: 900px) {\n    .agg-proof-quotes { grid-template-columns: 1fr; }\n    .agg-proof-stats { gap: 30px; }\n  }\n  @media (max-width: 480px) {\n    .agg-stat-number { font-size: 26px; }\n    .agg-stat-label { font-size: 12px; }\n  }\n</style>",
