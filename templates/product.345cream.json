    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .rprr-section {\n    max-width: 900px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 40px 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    text-align: center;\n    box-sizing: border-box;\n  }\n  .rprr-title {\n    font-size: clamp(24px, 4vw, 34px);\n    font-weight: 700;\n    color: #1a1a1a;\n    margin-bottom: 28px;\n  }\n  .rprr-carousel {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n  }\n  .rprr-track-wrap {\n    overflow: hidden;\n    width: 100%;\n    max-width: 480px;\n  }\n  .rprr-track {\n    display: flex;\n    transition: transform 0.4s ease;\n  }\n  .rprr-slide {\n    flex: 0 0 100%;\n    box-sizing: border-box;\n    padding: 24px 20px;\n    background: #F7F5FF;\n    border-radius: 16px;\n  }\n  .rprr-quote {\n    font-size: clamp(15px, 2.2vw, 17px);\n    line-height: 1.5;\n    color: #333;\n    margin: 0 0 12px;\n    font-style: italic;\n  }\n  .rprr-name {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .rprr-arrow {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    border: 1px solid #ddd;\n    background: #fff;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    color: #333;\n    user-select: none;\n  }\n  .rprr-arrow:hover {\n    background: #f5f5f5;\n  }\n  .rprr-dots {\n    display: flex;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 16px;\n  }\n  .rprr-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #ddd;\n    cursor: pointer;\n  }\n  .rprr-dot.active {\n    background: #7B5FE8;\n  }\n  @media (max-width: 600px) {\n    .rprr-arrow {\n      width: 32px;\n      height: 32px;\n      font-size: 15px;\n    }\n    .rprr-carousel {\n      gap: 8px;\n    }\n  }\n</style>\n\n<div class=\"rprr-section\">\n  <div class=\"rprr-title\">Real People, Real Results</div>\n\n  <div class=\"rprr-carousel\">\n    <div class=\"rprr-arrow\" id=\"rprrPrev\">&#10094;</div>\n\n    <div class=\"rprr-track-wrap\">\n      <div class=\"rprr-track\" id=\"rprrTrack\">\n        <div class=\"rprr-slide\">\n          <div class=\"rprr-quote\">\"I have sensitive, acne-prone skin and this is the first cream that doesn't irritate me at all — just calm, soothed skin every morning.\"</div>\n          <div class=\"rprr-name\">— Janet S.</div>\n        </div>\n        <div class=\"rprr-slide\">\n          <div class=\"rprr-quote\">\"My post-acne redness has calmed down so much since I started using this. It's gentle enough for daily use and doesn't clog my pores.\"</div>\n          <div class=\"rprr-name\">— Catherine R.</div>\n        </div>\n        <div class=\"rprr-slide\">\n          <div class=\"rprr-quote\">\"My skin looks brighter and feels so much more hydrated. This has become the last step in my routine every single night.\"</div>\n          <div class=\"rprr-name\">— Alice K.</div>\n        </div>\n        <div class=\"rprr-slide\">\n          <div class=\"rprr-quote\">\"Finally a moisturizer that soothes my breakouts instead of making them worse. My skin barrier feels stronger already.\"</div>\n          <div class=\"rprr-name\">— Linda M.</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"rprr-arrow\" id=\"rprrNext\">&#10095;</div>\n  </div>\n\n  <div class=\"rprr-dots\" id=\"rprrDots\"></div>\n</div>\n\n<script>\n(function() {\n  const track = document.getElementById('rprrTrack');\n  const slides = track.querySelectorAll('.rprr-slide');\n  const dotsWrap = document.getElementById('rprrDots');\n  const prevBtn = document.getElementById('rprrPrev');\n  const nextBtn = document.getElementById('rprrNext');\n  let index = 0;\n\n  slides.forEach((_, i) => {\n    const dot = document.createElement('div');\n    dot.className = 'rprr-dot' + (i === 0 ? ' active' : '');\n    dot.addEventListener('click', () => goTo(i));\n    dotsWrap.appendChild(dot);\n  });\n  const dots = dotsWrap.querySelectorAll('.rprr-dot');\n\n  function goTo(i) {\n    index = (i + slides.length) % slides.length;\n    track.style.transform = 'translateX(-' + (index * 100) + '%)';\n    dots.forEach((d, di) => d.classList.toggle('active', di === index));\n  }\n\n  prevBtn.addEventListener('click', () => goTo(index - 1));\n  nextBtn.addEventListener('click', () => goTo(index + 1));\n\n  let startX = 0;\n  track.addEventListener('touchstart', e => startX = e.touches[0].clientX);\n  track.addEventListener('touchend', e => {\n    const diff = startX - e.changedTouches[0].clientX;\n    if (diff > 50) goTo(index + 1);\n    else if (diff < -50) goTo(index - 1);\n  });\n})();\n</script>",
