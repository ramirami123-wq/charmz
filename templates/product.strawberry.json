      "settings": {
        "custom_liquid": "<div class=\"results-section\">\n  <h2 class=\"results-heading\">\n    Real <span class=\"highlight\">Results</span>\n  </h2>\n\n  <div class=\"results-grid\">\n    <div class=\"result-card\">\n      <p class=\"result-percent\">87%</p>\n      <p class=\"result-title\">saw their dark patches fade<br>after 2 weeks</p>\n      <p class=\"result-subtext\">Based on an independent clinical study*</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">92%</p>\n      <p class=\"result-title\">reported smoother, more even tone<br>after 4 weeks</p>\n      <p class=\"result-subtext\">Based on an independent clinical study*</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">95%</p>\n      <p class=\"result-title\">kept their results<br>with daily sunscreen</p>\n      <p class=\"result-subtext\">Based on an independent clinical study*</p>\n    </div>\n  </div>\n\n</div>\n\n<style>\n  .results-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n  .results-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 30px 0;\n  }\n\n  .results-heading .highlight {\n    background: linear-gradient(135deg, #e3263f, #f47a8d);\n    color: #fff;\n    padding: 2px 10px;\n  }\n\n  .results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n\n  .result-card {\n    background: #fff0f2;\n    border: 1px solid #ffc2cc;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  .result-percent {\n    font-size: 64px;\n    font-weight: 800;\n    line-height: 1;\n    margin: 0 0 16px 0;\n    color: #e3263f;\n    background: linear-gradient(135deg, #e3263f, #f47a8d);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .result-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.4;\n    margin: 0 0 10px 0;\n  }\n\n  .result-subtext {\n    font-size: 12px;\n    color: #555;\n    margin: 0;\n  }\n\n  .results-disclaimer {\n    max-width: 900px;\n    margin: 24px auto 0;\n    text-align: center;\n    font-size: 11.5px;\n    line-height: 1.5;\n    color: #8a8a8a;\n  }\n\n  @media (max-width: 900px) {\n    .results-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .results-heading {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n\n    .result-card {\n      padding: 22px 18px;\n    }\n\n    .result-percent {\n      font-size: 44px;\n      margin-bottom: 10px;\n    }\n\n    .result-title {\n      font-size: 14px;\n    }\n\n    .result-subtext {\n      font-size: 11px;\n    }\n\n    .results-disclaimer {\n      font-size: 10.5px;\n      margin-top: 18px;\n    }\n  }\n</style>",
