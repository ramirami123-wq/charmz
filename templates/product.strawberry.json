    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why <span class=\"why-highlight\">Strawberry?</span></h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <defs>\n            <linearGradient id=\"sbGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#e3263f\"/>\n              <stop offset=\"1\" stop-color=\"#f47a8d\"/>\n            </linearGradient>\n          </defs>\n          <path d=\"M20 8h20v10c4 4 6 10 6 18v42c0 3-2 5-5 5H19c-3 0-5-2-5-5V36c0-8 2-14 6-18V8z\" fill=\"url(#sbGrad)\" stroke=\"#c41d35\" stroke-width=\"1.5\"/>\n          <rect x=\"20\" y=\"8\" width=\"20\" height=\"8\" fill=\"#ffc2cc\" stroke=\"#c41d35\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"50\" font-size=\"5.5\" text-anchor=\"middle\" fill=\"#fff\" font-family=\"Arial\" font-weight=\"700\">STRAWBERRY</text>\n        </svg>\n      </div>\n      <span>Strawberry</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#bdbdbd\" stroke=\"#999\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Typical dark-spot creams</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Active ingredients</div>\n      <div class=\"why-row-sb\">5 proven actives in one formula: glycolic, kojic &amp; tranexamic acid, alpha-arbutin, niacinamide</div>\n      <div class=\"why-row-other\">Often built around just one or two</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Targets the causes</div>\n      <div class=\"why-row-sb\">Fades existing spots and slows new pigment forming</div>\n      <div class=\"why-row-other\">Mostly brightens the surface</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Routine</div>\n      <div class=\"why-row-sb\">One step, twice daily, on clean dry skin</div>\n      <div class=\"why-row-other\">A multi-product stack to keep up</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Sensitive skin</div>\n      <div class=\"why-row-sb\">Can start every other day and build up</div>\n      <div class=\"why-row-other\">Can leave skin dry or irritated</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Honest about pace</div>\n      <div class=\"why-row-sb\">Fading in weeks, full results over 8–12 weeks</div>\n      <div class=\"why-row-other\">\"Gone overnight\" promises that fizzle</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Risk-free</div>\n      <div class=\"why-row-sb\">60-day money back guarantee</div>\n      <div class=\"why-row-other\">Rarely guaranteed</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #fff0f2;\n    border: 1px solid #ffc2cc;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .why-highlight {\n    background: linear-gradient(135deg, #e3263f, #f47a8d);\n    color: #fff;\n    padding: 2px 10px;\n    border-radius: 4px;\n  }\n\n  .why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #e3263f;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-col-product span {\n    color: #e3263f;\n  }\n\n  .why-col-other span {\n    color: #999;\n  }\n\n  .product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #ffd6dd;\n    align-items: center;\n  }\n\n  .why-row:last-child {\n    border-bottom: none;\n  }\n\n  .why-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-row-sb {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600;\n    padding-left: 22px;\n    position: relative;\n  }\n\n  .why-row-sb::after {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #e3263f;\n    font-weight: 700;\n  }\n\n  .why-row-other {\n    font-size: 14px;\n    color: #999;\n    padding-left: 22px;\n    position: relative;\n  }\n\n  .why-row-other::after {\n    content: \"✕\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #bbb;\n    font-weight: 700;\n  }\n\n  @media (max-width: 700px) {\n    .why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .why-columns-header {\n      display: none;\n    }\n\n    .why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .why-row-label {\n      font-size: 13px;\n    }\n\n    .why-row-sb::before {\n      content: \"Strawberry: \";\n      font-weight: 700;\n      color: #e3263f;\n    }\n\n    .why-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .why-row-sb,\n    .why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
