    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/3_50a51cd2-1da6-4d2c-8eb4-0ed96a3c8996.webp?v=1795031604\" alt=\"Strawberry Advanced Triple-Acid Complex for hyperpigmentation\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Fade <span class=\"highlight\">Dark Patches, Spots &amp; Uneven Tone</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      Meet the Triple-Acid Complex, made for the stubborn dark patches on your underarms, inner thighs, neck and face that nothing else has touched.\n    </p>\n\n    <p class=\"fade-text\">\n      Most products only work on the surface. This one combines glycolic acid, kojic acid, tranexamic acid, alpha-arbutin and niacinamide to work on several causes of pigmentation at once: fading the dark spots you already have and slowing new pigment from forming.\n    </p>\n\n    <p class=\"fade-text\">\n      Apply it twice daily to clean, dry skin. Many customers see dark patches start to fade within weeks, with full results over 8–12 weeks. It evens out your tone without bleaching your skin.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Fades dark patches &amp; spots</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Gentle enough for daily use</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #e3263f;\n    padding-top: 20px;\n  }\n\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .highlight {\n    background: linear-gradient(135deg, #e3263f, #f47a8d);\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n\n  .sparkle {\n    color: #e3263f;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .fade-highlights {\n      gap: 14px;\n    }\n\n    .highlight-item {\n      font-size: 12.5px;\n    }\n\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
