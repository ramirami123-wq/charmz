    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"feel-again-block\">\n  <h2 class=\"feel-again-title\">Feel Like You Again, One Day at a Time</h2>\n\n  <div class=\"feel-again-content\">\n    <div class=\"chart-card\">\n      <h3 class=\"chart-title\">Improvement Over Time</h3>\n\n      <div class=\"chart-wrap\">\n        <svg viewBox=\"0 0 620 480\" class=\"chart-svg\" preserveAspectRatio=\"xMidYMid meet\">\n          <!-- Y axis labels -->\n          <text x=\"30\" y=\"60\" class=\"axis-label\">100</text>\n          <text x=\"30\" y=\"145\" class=\"axis-label\">75</text>\n          <text x=\"30\" y=\"230\" class=\"axis-label\">50</text>\n          <text x=\"30\" y=\"315\" class=\"axis-label\">25</text>\n          <text x=\"30\" y=\"400\" class=\"axis-label\">0</text>\n\n          <!-- X axis line -->\n          <line x1=\"60\" y1=\"400\" x2=\"600\" y2=\"400\" stroke=\"#191516\" stroke-width=\"1.5\"/>\n\n          <!-- X axis labels -->\n          <text x=\"95\" y=\"425\" class=\"axis-label x\">Week 1</text>\n          <text x=\"185\" y=\"425\" class=\"axis-label x\">Week 2</text>\n          <text x=\"275\" y=\"425\" class=\"axis-label x\">Week 3</text>\n          <text x=\"365\" y=\"425\" class=\"axis-label x\">Week 4</text>\n          <text x=\"455\" y=\"425\" class=\"axis-label x\">Week 5</text>\n          <text x=\"545\" y=\"425\" class=\"axis-label x\">Week 6</text>\n\n          <!-- % Less Pain (orange, rising) -->\n          <polyline points=\"95,340 185,290 275,230 365,185 455,110 545,60\"\n                    fill=\"none\" stroke=\"#F5A623\" stroke-width=\"3\"/>\n          <circle cx=\"95\" cy=\"340\" r=\"6\" fill=\"#F5A623\"/>\n          <circle cx=\"185\" cy=\"290\" r=\"6\" fill=\"#F5A623\"/>\n          <circle cx=\"275\" cy=\"230\" r=\"6\" fill=\"#F5A623\"/>\n          <circle cx=\"365\" cy=\"185\" r=\"6\" fill=\"#F5A623\"/>\n          <circle cx=\"455\" cy=\"110\" r=\"6\" fill=\"#F5A623\"/>\n          <circle cx=\"545\" cy=\"60\" r=\"6\" fill=\"#F5A623\"/>\n\n          <!-- Swelling (teal, declining) -->\n          <polyline points=\"95,60 185,130 275,190 365,240 455,330 545,398\"\n                    fill=\"none\" stroke=\"#5BC0C8\" stroke-width=\"3\"/>\n          <circle cx=\"95\" cy=\"60\" r=\"6\" fill=\"#5BC0C8\"/>\n          <circle cx=\"545\" cy=\"398\" r=\"6\" fill=\"#5BC0C8\"/>\n\n          <!-- Inflammation (red, declining) -->\n          <polyline points=\"95,90 185,110 275,125 365,190 455,300 545,398\"\n                    fill=\"none\" stroke=\"#D9534F\" stroke-width=\"3\"/>\n          <circle cx=\"95\" cy=\"90\" r=\"6\" fill=\"#D9534F\"/>\n          <circle cx=\"545\" cy=\"398\" r=\"6\" fill=\"#D9534F\"/>\n\n          <!-- Percent callout bubbles -->\n          <g class=\"bubble\" transform=\"translate(185,270)\">\n            <rect x=\"-25\" y=\"-38\" width=\"50\" height=\"28\" rx=\"8\" fill=\"#F5A623\"/>\n            <polygon points=\"-6,-10 6,-10 0,0\" fill=\"#F5A623\"/>\n            <text x=\"0\" y=\"-19\" class=\"bubble-text\">25%</text>\n          </g>\n          <g class=\"bubble\" transform=\"translate(275,210)\">\n            <rect x=\"-25\" y=\"-38\" width=\"50\" height=\"28\" rx=\"8\" fill=\"#F5A623\"/>\n            <polygon points=\"-6,-10 6,-10 0,0\" fill=\"#F5A623\"/>\n            <text x=\"0\" y=\"-19\" class=\"bubble-text\">50%</text>\n          </g>\n          <g class=\"bubble\" transform=\"translate(365,165)\">\n            <rect x=\"-25\" y=\"-38\" width=\"50\" height=\"28\" rx=\"8\" fill=\"#F5A623\"/>\n            <polygon points=\"-6,-10 6,-10 0,0\" fill=\"#F5A623\"/>\n            <text x=\"0\" y=\"-19\" class=\"bubble-text\">70%</text>\n          </g>\n          <g class=\"bubble\" transform=\"translate(455,90)\">\n            <rect x=\"-30\" y=\"-38\" width=\"60\" height=\"28\" rx=\"8\" fill=\"#F5A623\"/>\n            <polygon points=\"-6,-10 6,-10 0,0\" fill=\"#F5A623\"/>\n            <text x=\"0\" y=\"-19\" class=\"bubble-text\">100%</text>\n          </g>\n        </svg>\n      </div>\n\n      <div class=\"legend\">\n        <div class=\"legend-item\">\n          <span class=\"legend-bar orange\"></span>\n          <div>\n            <strong>% Less Pain</strong>\n            <p>Reduces knee pain during usual daily activities</p>\n          </div>\n        </div>\n        <div class=\"legend-item\">\n          <span class=\"legend-bar teal\"></span>\n          <div>\n            <strong>Swelling</strong>\n            <p>Reduces swelling in and around the knee</p>\n          </div>\n        </div>\n        <div class=\"legend-item\">\n          <span class=\"legend-bar red\"></span>\n          <div>\n            <strong>Inflammation</strong>\n            <p>Reduces inflammation in the knee</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"timeline-card\">\n      <div class=\"timeline-row\">\n        <div class=\"timeline-time\">1-4<span>Weeks</span></div>\n        <div class=\"timeline-arrow-seg top\"></div>\n        <div class=\"timeline-text\">\n          <h4>Instant Relief</h4>\n          <p><span class=\"check\">✓</span> Pain begins to ease naturally</p>\n          <p><span class=\"check\">✓</span> Swelling and stiffness decrease</p>\n        </div>\n      </div>\n      <div class=\"timeline-row\">\n        <div class=\"timeline-time\">1-2<span>Months</span></div>\n        <div class=\"timeline-arrow-seg mid\"></div>\n        <div class=\"timeline-text\">\n          <h4>Restored Motion</h4>\n          <p><span class=\"check\">✓</span> Movement feels smoother</p>\n          <p><span class=\"check\">✓</span> Discomfort dissolves</p>\n        </div>\n      </div>\n      <div class=\"timeline-row\">\n        <div class=\"timeline-time\">3-4<span>Months</span></div>\n        <div class=\"timeline-arrow-seg bottom\"></div>\n        <div class=\"timeline-text\">\n          <h4>Lasting Relief</h4>\n          <p><span class=\"check\">✓</span> Comfort becomes consistent</p>\n          <p><span class=\"check\">✓</span> Daily activity feels easier</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <p class=\"disclaimer\">*Note: Individual results may vary. The benefits stated are based on personal experiences and subjective feedback from TheraWolf users may vary from person to person.</p>\n</div>\n\n<style>\n  .feel-again-block {\n    width: 100%;\n    max-width: 1300px;\n    margin: 0 auto;\n    padding: clamp(16px, 4vw, 48px) clamp(10px, 3vw, 32px);\n    background: #ffffff;\n    box-sizing: border-box;\n    font-family: 'Open Sans', Arial, sans-serif;\n  }\n\n  .feel-again-title {\n    text-align: center;\n    font-family: 'Playfair Display', serif;\n    font-weight: 700;\n    font-size: clamp(20px, 3.5vw, 38px);\n    color: #191516;\n    margin: 0 0 clamp(20px, 3vw, 40px) 0;\n    line-height: 1.2;\n  }\n\n  .feel-again-content {\n    display: flex;\n    flex-wrap: wrap;\n    gap: clamp(16px, 3vw, 40px);\n    align-items: stretch;\n  }\n\n  .chart-card {\n    flex: 1 1 500px;\n    background: #F4F7F5;\n    border-radius: 16px;\n    padding: clamp(14px, 2.5vw, 32px);\n    box-sizing: border-box;\n    min-width: 0;\n    width: 100%;\n  }\n\n  .chart-title {\n    font-family: 'Playfair Display', serif;\n    font-weight: 700;\n    font-size: clamp(16px, 2.5vw, 28px);\n    color: #191516;\n    margin: 0 0 12px 0;\n  }\n\n  .chart-wrap {\n    width: 100%;\n    overflow-x: auto;\n  }\n\n  .chart-svg {\n    width: 100%;\n    height: auto;\n    display: block;\n    min-width: 340px;\n  }\n\n  .axis-label {\n    font-size: 13px;\n    fill: #474747;\n    font-family: 'Open Sans', Arial, sans-serif;\n  }\n\n  .axis-label.x {\n    text-anchor: middle;\n  }\n\n  .bubble-text {\n    font-size: 14px;\n    font-weight: 700;\n    fill: #fff;\n    text-anchor: middle;\n    font-family: 'Open Sans', Arial, sans-serif;\n  }\n\n  .legend {\n    display: flex;\n    flex-wrap: wrap;\n    gap: clamp(10px, 2vw, 24px);\n    margin-top: 16px;\n  }\n\n  .legend-item {\n    display: flex;\n    gap: 10px;\n    flex: 1 1 140px;\n    min-width: 120px;\n  }\n\n  .legend-bar {\n    width: 4px;\n    border-radius: 2px;\n    flex-shrink: 0;\n  }\n\n  .legend-bar.orange { background: #F5A623; }\n  .legend-bar.teal { background: #5BC0C8; }\n  .legend-bar.red { background: #D9534F; }\n\n  .legend-item strong {\n    display: block;\n    font-size: clamp(12px, 1.6vw, 15px);\n    color: #191516;\n    margin-bottom: 2px;\n  }\n\n  .legend-item p {\n    margin: 0;\n    font-size: clamp(11px, 1.4vw, 13px);\n    color: #474747;\n    line-height: 1.4;\n  }\n\n  .timeline-card {\n    flex: 1 1 500px;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n    min-width: 0;\n    width: 100%;\n  }\n\n  .timeline-row {\n    display: grid;\n    grid-template-columns: clamp(60px,10vw,100px) clamp(40px,7vw,80px) 1fr;\n    align-items: center;\n    gap: clamp(10px, 2vw, 24px);\n    flex: 1;\n  }\n\n  .timeline-time {\n    font-family: 'Playfair Display', serif;\n    font-weight: 700;\n    font-size: clamp(18px, 3vw, 34px);\n    color: #191516;\n    text-align: center;\n    line-height: 1.1;\n  }\n\n  .timeline-time span {\n    display: block;\n    font-size: clamp(10px, 1.6vw, 16px);\n    font-weight: 700;\n  }\n\n  .timeline-arrow-seg {\n    width: 100%;\n    height: clamp(80px, 12vw, 140px);\n    background: linear-gradient(180deg, #FDDA82 0%, #FF8122 100%);\n    position: relative;\n  }\n\n  .timeline-arrow-seg.top {\n    border-radius: 10px 10px 0 0;\n  }\n\n  .timeline-arrow-seg.bottom {\n    clip-path: polygon(0% 0%, 100% 0%, 100% 75%, 50% 100%, 0% 75%);\n  }\n\n  .timeline-text h4 {\n    margin: 0 0 6px 0;\n    font-size: clamp(14px, 2.2vw, 22px);\n    color: #191516;\n  }\n\n  .timeline-text p {\n    margin: 2px 0;\n    font-size: clamp(11px, 1.6vw, 15px);\n    color: #474747;\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n    line-height: 1.4;\n  }\n\n  .timeline-text .check {\n    color: #e16203;\n    font-weight: 700;\n    flex-shrink: 0;\n  }\n\n  .disclaimer {\n    margin-top: clamp(14px, 2vw, 28px);\n    font-size: clamp(10px, 1.3vw, 13px);\n    color: #474747;\n    line-height: 1.5;\n  }\n\n  @media (max-width: 700px) {\n    .feel-again-content {\n      flex-direction: column;\n    }\n    .timeline-arrow-seg.bottom {\n      clip-path: polygon(0% 0%, 100% 0%, 100% 65%, 50% 100%, 0% 65%);\n    }\n  }\n\n  @media (max-width: 480px) {\n    .feel-again-block {\n      padding: 14px 8px;\n    }\n    .timeline-row {\n      grid-template-columns: 48px 32px 1fr;\n      gap: 8px;\n    }\n    .timeline-time {\n      font-size: 15px;\n    }\n    .timeline-time span {\n      font-size: 9px;\n    }\n    .timeline-text h4 {\n      font-size: 13px;\n      margin-bottom: 3px;\n    }\n    .timeline-text p {\n      font-size: 10.5px;\n    }\n    .timeline-arrow-seg {\n      height: 65px;\n    }\n    .chart-card {\n      padding: 10px;\n    }\n    .legend {\n      flex-direction: column;\n      gap: 10px;\n    }\n    .legend-item {\n      flex: 1 1 100%;\n    }\n  }\n</style>",
