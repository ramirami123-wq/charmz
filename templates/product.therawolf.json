      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"pain-relief-block\">\n  <h2 class=\"pain-relief-title\">Instant Relief Wherever It Hurts</h2>\n  <div class=\"pain-relief-grid\">\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/hand-2-1-1-1.svg\" alt=\"Shoulder Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">SHOULDER PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/leg-2-1-1.svg\" alt=\"Knee Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">KNEE PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/spinal-1.svg\" alt=\"Back Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">BACK PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/hand-copy-1-1.svg\" alt=\"Elbow Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">ELBOW PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/hand-1-1-1.svg\" alt=\"Finger Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">FINGER PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/Layer_1-2-3.svg\" alt=\"Ankle Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">ANKLE PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/neck-1.svg\" alt=\"Neck Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">NECK PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/hurt-1.svg\" alt=\"Hip Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">HIP PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/hand-1.svg\" alt=\"Wrist Pain\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">WRIST PAIN</span>\n    </div>\n    <div class=\"pain-item\">\n      <div class=\"icon-circle\">\n        <img src=\"https://therawolf.com/wp-content/uploads/leg-2-2.svg\" alt=\"Muscle Cramps\" loading=\"lazy\">\n      </div>\n      <span class=\"pain-label\">MUSCLE CRAMPS</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .pain-relief-block {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: clamp(20px, 4vw, 48px) clamp(12px, 3vw, 32px);\n    background: #ffffff;\n    box-sizing: border-box;\n    font-family: 'Open Sans', Arial, sans-serif;\n  }\n\n  .pain-relief-title {\n    text-align: center;\n    font-family: 'Playfair Display', 'DM Serif Display', serif;\n    font-weight: 700;\n    font-size: clamp(22px, 4vw, 40px);\n    color: #191516;\n    margin: 0 0 clamp(24px, 4vw, 48px) 0;\n  }\n\n  .pain-relief-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: clamp(16px, 2.5vw, 32px) clamp(10px, 2vw, 20px);\n    justify-items: center;\n  }\n\n  .pain-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: clamp(10px, 1.8vw, 16px);\n    width: 100%;\n  }\n\n  .icon-circle {\n    width: clamp(70px, 9vw, 130px);\n    height: clamp(70px, 9vw, 130px);\n    border-radius: 50%;\n    background: #C9C7E0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    flex-shrink: 0;\n  }\n\n  .icon-circle img {\n    width: 65%;\n    height: 65%;\n    object-fit: contain;\n  }\n\n  .pain-label {\n    font-weight: 700;\n    font-size: clamp(11px, 1.4vw, 15px);\n    letter-spacing: 0.3px;\n    color: #191516;\n    text-align: center;\n    white-space: nowrap;\n  }\n\n  @media (max-width: 900px) {\n    .pain-relief-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n  }\n\n  @media (max-width: 520px) {\n    .pain-relief-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n    .pain-label {\n      white-space: normal;\n    }\n  }\n</style>",
