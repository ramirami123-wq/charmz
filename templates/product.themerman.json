            "custom_liquid": "<div class=\"bundle-benefits-block\">\n  <p class=\"benefits-heading\">\n    Messy hair happens. Spray in some sea salt for cool beach waves, then use the clay to make your style stay all day.\n  </p>\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M4 14c2-4 4-8 4-10s2 2 2 5 2 3 2 3 0-4 2-6 2 4 2 8-3 6-6 6-6-2-6-6z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">No more sticky, crunchy hair spray</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z\"/>\n          <path d=\"M9 12l2 2 4-4\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Your hairstyle stays put all day long</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M6 19c3-6 3-12 6-14 3 2 3 8 6 14\"/>\n          <path d=\"M8 19h8\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Beachy texture in seconds, no heat tools needed</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"8\"/>\n          <path d=\"M9 12h6M12 9v6\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Never feels greasy or heavy</p>\n    </div>\n  </div>\n</div>\n<style>\n  .bundle-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n  .benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n  .benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n  .benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: #e6f2ef;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n  .benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n  @media (max-width: 480px) {\n    .benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n    .benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n    .benefit-item {\n      gap: 10px;\n    }\n    .benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n    .benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n    }\n    .benefit-text {\n      font-size: 11.5px;\n    }\n  }\n</style>"
