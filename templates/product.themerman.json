        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why Us?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"18\" y=\"14\" width=\"24\" height=\"10\" rx=\"2\" fill=\"#c9a55a\" stroke=\"#a8853f\" stroke-width=\"1.5\"/>\n          <rect x=\"26\" y=\"6\" width=\"8\" height=\"10\" fill=\"#e8d4a3\" stroke=\"#c9a55a\" stroke-width=\"1.5\"/>\n          <path d=\"M16 24h28v54c0 4-3 7-7 7H23c-4 0-7-3-7-7V24z\" fill=\"#e8d4a3\" stroke=\"#c9a55a\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"55\" font-size=\"6\" text-anchor=\"middle\" fill=\"#5c4a1e\" font-family=\"Arial\" font-weight=\"700\">SPRAY</text>\n          <text x=\"30\" y=\"65\" font-size=\"6\" text-anchor=\"middle\" fill=\"#5c4a1e\" font-family=\"Arial\" font-weight=\"700\">+ CLAY</text>\n        </svg>\n      </div>\n      <span>Us</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Regular sprays &amp; gels alone</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Texture without the crunch</div>\n      <div class=\"why-row-jolie\">Light, beachy waves that still feel soft</div>\n      <div class=\"why-row-other\">Often leaves hair stiff or sticky</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Hold that lasts</div>\n      <div class=\"why-row-jolie\">Clay keeps your style in place all day</div>\n      <div class=\"why-row-other\">Wears off or goes flat by afternoon</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Routine</div>\n      <div class=\"why-row-jolie\">Two products, one simple routine</div>\n      <div class=\"why-row-other\">Juggling several products to get both</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Feel on your hair</div>\n      <div class=\"why-row-jolie\">Matte finish, never greasy or heavy</div>\n      <div class=\"why-row-other\">Can leave hair oily or weighed down</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Made for you</div>\n      <div class=\"why-row-jolie\">Works for waves and hold, together</div>\n      <div class=\"why-row-other\">Usually built for one look, not both</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #f5f5f4;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #1a1a1a;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #ddd;\n  }\n\n  .why-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-row-jolie {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  .why-row-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .why-columns-header {\n      display: none;\n    }\n\n    .why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .why-row-label {\n      font-size: 13px;\n    }\n\n    .why-row-jolie::before {\n      content: \"Us: \";\n      font-weight: 700;\n      color: #1a1a1a;\n    }\n\n    .why-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .why-row-jolie,\n    .why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
