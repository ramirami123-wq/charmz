    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"jlr-reviews-section\">\n  <h2 class=\"jlr-heading\">\n    Loved by <span class=\"jlr-highlight\">350,000+</span>\n  </h2>\n  <div class=\"jlr-grid\">\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Sara, 24</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"I've tried so many salt sprays that left my hair feeling like straw. This one actually gives me soft waves, not crunchy ones. My go-to before any night out.\"\n      </p>\n    </div>\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Karim, 29</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"The clay is exactly what I was looking for — strong hold, matte finish, no shine. Doesn't feel greasy or heavy at all. Lasts me the whole day.\"\n      </p>\n    </div>\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Yara, 31</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"Loved having both products together. Spray for the beachy texture, clay when I want it more defined. Genuinely changed my daily routine.\"\n      </p>\n    </div>\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Adam, 33</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"Wasn't expecting much from a bundle deal, but both products pulled their weight. My hair holds its style way longer than anything I've used before.\"\n      </p>\n    </div>\n  </div>\n</div>\n<style>\n  .jlr-reviews-section {\n    font-family: Arial, Helvetica, sans-serif;\n    padding: 20px;\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 100vw;\n    overflow-x: hidden;\n  }\n  .jlr-reviews-section * {\n    box-sizing: border-box;\n  }\n  .jlr-heading {\n    text-align: center;\n    font-size: 32px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 30px 0;\n  }\n  .jlr-highlight {\n    background: #cf9d3f;\n    color: #fff;\n    padding: 4px 12px;\n    border-radius: 4px;\n    white-space: nowrap;\n  }\n  .jlr-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 16px;\n    max-width: 1400px;\n    margin: 0 auto;\n    width: 100%;\n  }\n  .jlr-card {\n    background: #f5f5f4;\n    border-radius: 10px;\n    padding: 20px;\n    min-width: 0;\n  }\n  .jlr-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 12px;\n    flex-wrap: wrap;\n  }\n  .jlr-name {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .jlr-stars {\n    color: #cf9d3f;\n    font-size: 14px;\n    letter-spacing: 1px;\n  }\n  .jlr-text {\n    font-size: 14px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0;\n    overflow-wrap: break-word;\n    word-break: break-word;\n  }\n  @media (max-width: 900px) {\n    .jlr-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n  @media (max-width: 480px) {\n    .jlr-heading {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n    .jlr-grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 12px;\n    }\n    .jlr-card {\n      padding: 16px;\n    }\n    .jlr-name {\n      font-size: 13px;\n    }\n    .jlr-text {\n      font-size: 12.5px;\n    }\n  }\n</style>",
