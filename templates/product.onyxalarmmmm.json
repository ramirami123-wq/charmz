    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .bfc-section {\n    max-width: 900px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 40px 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n  }\n  .bfc-eyebrow {\n    text-align: center;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    color: #a08a5c;\n    margin-bottom: 10px;\n  }\n  .bfc-title {\n    text-align: center;\n    font-size: clamp(26px, 4vw, 36px);\n    font-weight: 800;\n    color: #1a1a1a;\n    margin-bottom: 6px;\n  }\n  .bfc-sub {\n    text-align: center;\n    font-size: clamp(14px, 2vw, 16px);\n    color: #666;\n    margin-bottom: 32px;\n  }\n  .bfc-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n  }\n  .bfc-card {\n    border-radius: 16px;\n    padding: 24px 18px;\n    text-align: center;\n    border: 1px solid #e2e2e2;\n    background: #fafafa;\n  }\n  .bfc-card.bfc-winner {\n    background: #3B2417;\n    border: 2px solid #d4a537;\n    position: relative;\n    transform: translateY(-6px);\n  }\n  .bfc-winner-tag {\n    position: absolute;\n    top: -14px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #d4a537;\n    color: #1a1a1a;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    padding: 5px 12px;\n    border-radius: 20px;\n    white-space: nowrap;\n  }\n  .bfc-icon-wrap {\n    width: 56px;\n    height: 56px;\n    margin: 8px auto 14px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #eee;\n  }\n  .bfc-winner .bfc-icon-wrap {\n    background: #d4a537;\n  }\n  .bfc-icon-wrap svg {\n    width: 28px;\n    height: 28px;\n    color: #3B2417;\n  }\n  .bfc-card:not(.bfc-winner) .bfc-icon-wrap svg {\n    color: #555;\n  }\n  .bfc-name {\n    font-size: 18px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin-bottom: 18px;\n  }\n  .bfc-winner .bfc-name {\n    color: #fff;\n  }\n  .bfc-feature-list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    text-align: left;\n  }\n  .bfc-feature {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    font-weight: 600;\n    color: #333;\n  }\n  .bfc-winner .bfc-feature {\n    color: #f2e7d3;\n  }\n  .bfc-feature svg {\n    flex-shrink: 0;\n    width: 16px;\n    height: 16px;\n  }\n  .bfc-yes { color: #2e7d32; }\n  .bfc-no { color: #c62828; }\n  .bfc-winner .bfc-yes { color: #7ed957; }\n  .bfc-winner .bfc-no { color: #ff8a80; }\n\n  @media (max-width: 640px) {\n    .bfc-grid {\n      grid-template-columns: 1fr;\n    }\n    .bfc-card.bfc-winner {\n      order: -1;\n      transform: none;\n    }\n  }\n</style>\n\n<div class=\"bfc-section\">\n  <div class=\"bfc-eyebrow\">What Makes HiStrips Onyx Different?</div>\n  <div class=\"bfc-title\">Built for a conscious morning.</div>\n  <div class=\"bfc-sub\">Physical vibration beats sound. Every time.</div>\n\n  <div class=\"bfc-grid\">\n\n    <!-- PHONE -->\n    <div class=\"bfc-card\">\n      <div class=\"bfc-icon-wrap\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"7\" y=\"2\" width=\"10\" height=\"20\" rx=\"2\"/><line x1=\"11\" y1=\"18\" x2=\"13\" y2=\"18\"/></svg>\n      </div>\n      <div class=\"bfc-name\">Phone</div>\n      <div class=\"bfc-feature-list\">\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Used as an Alarm</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>EMF-Free</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>14+ Day Battery</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>Partner-Friendly / Silent Wake-Up</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>No Cortisol Spike</div>\n      </div>\n    </div>\n\n    <!-- ONYX (winner) -->\n    <div class=\"bfc-card bfc-winner\">\n      <div class=\"bfc-winner-tag\">The Best Solution</div>\n      <div class=\"bfc-icon-wrap\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"13\" r=\"8\"/><path d=\"M12 9v4l3 2\"/><path d=\"M9 2h6\"/></svg>\n      </div>\n      <div class=\"bfc-name\">ONYX</div>\n      <div class=\"bfc-feature-list\">\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Used as an Alarm</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>EMF-Free</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>14+ Day Battery</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Partner-Friendly / Silent Wake-Up</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>No Cortisol Spike</div>\n      </div>\n    </div>\n\n    <!-- SMARTWATCH -->\n    <div class=\"bfc-card\">\n      <div class=\"bfc-icon-wrap\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"2\"/><path d=\"M9 7V4h6v3M9 17v3h6v-3\"/></svg>\n      </div>\n      <div class=\"bfc-name\">Smartwatch</div>\n      <div class=\"bfc-feature-list\">\n        <div class=\"bfc-feature\"><svg class=\"bfc-yes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Used as an Alarm</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>EMF-Free</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>14+ Day Battery</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>Partner-Friendly / Silent Wake-Up</div>\n        <div class=\"bfc-feature\"><svg class=\"bfc-no\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M18 6L6 18M6 6l12 12\" stroke-linecap=\"round\"/></svg>No Cortisol Spike</div>\n      </div>\n    </div>\n\n  </div>\n</div>",
