        "custom_liquid_PigjTJ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .pr-wrap {\n    max-width: 800px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n  }\n  .pr-banner {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    background: #dce6f5;\n    border: 1px solid #0f2540;\n    border-radius: 14px;\n    padding: 18px 22px;\n    margin-bottom: 20px;\n  }\n  .pr-badge {\n    flex-shrink: 0;\n    width: 46px;\n    height: 46px;\n    border-radius: 50%;\n    background: #0f2540;\n    border: 3px dashed #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .pr-badge svg {\n    width: 22px;\n    height: 22px;\n    color: #fff;\n  }\n  .pr-banner-text {\n    font-size: clamp(14px, 2vw, 16px);\n    line-height: 1.4;\n    color: #1a1a1a;\n  }\n  .pr-banner-text b {\n    font-weight: 700;\n  }\n  .pr-banner-text .pr-link {\n    color: #1a3a6b;\n    font-weight: 700;\n  }\n  .pr-faq {\n    border: 1px solid #0f2540;\n    border-radius: 14px;\n    overflow: hidden;\n  }\n  .pr-faq-item {\n    border-bottom: 1px solid #d8d8d8;\n  }\n  .pr-faq-item:last-child {\n    border-bottom: none;\n  }\n  .pr-faq-question {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 16px 20px;\n    cursor: pointer;\n    font-size: clamp(14px, 2vw, 16px);\n    color: #1a1a1a;\n    font-weight: 600;\n  }\n  .pr-faq-plus {\n    flex-shrink: 0;\n    width: 16px;\n    height: 16px;\n    position: relative;\n  }\n  .pr-faq-plus::before,\n  .pr-faq-plus::after {\n    content: '';\n    position: absolute;\n    background: #1a3a6b;\n    transition: transform 0.25s ease;\n  }\n  .pr-faq-plus::before {\n    top: 0; left: 50%;\n    width: 2px; height: 100%;\n    transform: translateX(-50%);\n  }\n  .pr-faq-plus::after {\n    top: 50%; left: 0;\n    width: 100%; height: 2px;\n    transform: translateY(-50%);\n  }\n  .pr-faq-item.active .pr-faq-plus::before {\n    transform: translateX(-50%) rotate(90deg);\n    opacity: 0;\n  }\n  .pr-faq-item.active .pr-faq-question {\n    color: #1a3a6b;\n  }\n  .pr-faq-answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease;\n    padding: 0 20px;\n  }\n  .pr-faq-item.active .pr-faq-answer {\n    max-height: 400px;\n    padding-bottom: 18px;\n  }\n  .pr-faq-answer p {\n    margin: 0;\n    font-size: clamp(13px, 1.8vw, 15px);\n    line-height: 1.6;\n    color: #444;\n  }\n  @media (max-width: 480px) {\n    .pr-banner {\n      padding: 14px 16px;\n      gap: 12px;\n    }\n    .pr-badge {\n      width: 38px;\n      height: 38px;\n    }\n    .pr-badge svg {\n      width: 18px;\n      height: 18px;\n    }\n  }\n</style>\n\n<div class=\"pr-wrap\">\n\n  <div class=\"pr-banner\">\n    <div class=\"pr-badge\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n    <div class=\"pr-banner-text\"><b>Less than 1%</b> of customers claim our <span class=\"pr-link\">100-Day Money Back Guarantee</span></div>\n  </div>\n\n  <div class=\"pr-faq\">\n    <div class=\"pr-faq-item\">\n      <div class=\"pr-faq-question\">\n        <span>Will it actually wake me up?</span>\n        <span class=\"pr-faq-plus\"></span>\n      </div>\n      <div class=\"pr-faq-answer\">\n        <p>Yes. Onyx is built for heavy sleepers who sleep through phone alarms. It uses strong vibration on your wrist, not sound, and your brain can't tune that out. The vibration starts light and gets stronger until you wake up, even from deep sleep.</p>\n      </div>\n    </div>\n\n    <div class=\"pr-faq-item\">\n      <div class=\"pr-faq-question\">\n        <span>Will it wake up my partner too?</span>\n        <span class=\"pr-faq-plus\"></span>\n      </div>\n      <div class=\"pr-faq-answer\">\n        <p>No. Onyx only wakes you. There's no sound at all, just a vibration only you can feel on your wrist. Your partner can keep sleeping while you get up on time.</p>\n      </div>\n    </div>\n\n    <div class=\"pr-faq-item\">\n      <div class=\"pr-faq-question\">\n        <span>Battery & charging</span>\n        <span class=\"pr-faq-plus\"></span>\n      </div>\n      <div class=\"pr-faq-answer\">\n        <p>Up to 14 days on a single charge with normal nightly use. It comes with a magnetic charging cable, just click it onto the band and plug it in. No app needed, you set the alarm right on the device.</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function() {\n  document.querySelectorAll('.pr-faq-question').forEach(q => {\n    q.addEventListener('click', function() {\n      const item = this.parentElement;\n      const wasActive = item.classList.contains('active');\n      document.querySelectorAll('.pr-faq-item').forEach(i => i.classList.remove('active'));\n      if (!wasActive) item.classList.add('active');\n    });\n  });\n})();\n</script>"
          }
