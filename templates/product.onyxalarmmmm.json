    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .rv-wrap * {\n    box-sizing: border-box;\n  }\n  .rv-wrap {\n    max-width: 900px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 20px 0;\n    font-family: Arial, Helvetica, sans-serif;\n    overflow: hidden; /* stop the horizontal scroller from widening the page */\n  }\n  .rv-title {\n    font-size: clamp(18px, 5vw, 28px);\n    font-weight: 700;\n    text-align: center;\n    color: #1a1a1a;\n    margin-bottom: 6px;\n    padding: 0 12px;\n  }\n  .rv-stars {\n    text-align: center;\n    color: #d4a537;\n    font-size: 18px;\n    margin-bottom: 4px;\n  }\n  .rv-subtitle {\n    text-align: center;\n    font-size: 13px;\n    color: #666;\n    margin-bottom: 20px;\n    padding: 0 12px;\n  }\n  .rv-scroll {\n    display: flex;\n    gap: 12px;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    padding: 4px 16px 16px;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  .rv-scroll::-webkit-scrollbar { display: none; }\n  .rv-card {\n    flex: 0 0 260px;\n    max-width: 260px;\n    width: 260px;\n    min-width: 0;\n    scroll-snap-align: start;\n    border: 1px solid #e3e3e3;\n    border-radius: 14px;\n    overflow: hidden;\n    background: #fff;\n    box-shadow: 0 1px 4px rgba(0,0,0,0.06);\n    display: flex;\n    flex-direction: column;\n  }\n  .rv-card img {\n    width: 100%;\n    height: 220px;\n    object-fit: cover;\n    display: block;\n  }\n  .rv-body {\n    padding: 14px 16px 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    min-width: 0; /* allow text to shrink/wrap instead of forcing card width */\n  }\n  .rv-star-row {\n    color: #d4a537;\n    font-size: 14px;\n  }\n  .rv-text {\n    font-size: 14px;\n    line-height: 1.5;\n    color: #333;\n    overflow-wrap: break-word;\n    word-break: break-word;\n    hyphens: auto;\n  }\n  .rv-name-row {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 6px;\n    font-size: 13px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin-top: 4px;\n    overflow-wrap: break-word;\n  }\n  .rv-verified {\n    display: inline-flex;\n    align-items: center;\n    gap: 3px;\n    font-size: 11px;\n    font-weight: 600;\n    color: #2e7d32;\n    white-space: nowrap;\n  }\n  .rv-verified svg {\n    width: 12px;\n    height: 12px;\n    flex-shrink: 0;\n  }\n  .rv-date {\n    font-size: 11px;\n    color: #999;\n  }\n\n  /* Tablets */\n  @media (max-width: 700px) {\n    .rv-card {\n      flex: 0 0 72vw;\n      max-width: 72vw;\n      width: 72vw;\n    }\n    .rv-card img { height: 200px; }\n  }\n\n  /* Phones */\n  @media (max-width: 480px) {\n    .rv-wrap { padding: 16px 0; }\n    .rv-scroll { gap: 10px; padding: 4px 12px 14px; }\n    .rv-card {\n      flex: 0 0 82vw;\n      max-width: 82vw;\n      width: 82vw;\n    }\n    .rv-card img { height: 170px; }\n    .rv-body { padding: 12px 14px 14px; }\n    .rv-text { font-size: 13.5px; }\n  }\n\n  /* Very small phones */\n  @media (max-width: 340px) {\n    .rv-card {\n      flex: 0 0 88vw;\n      max-width: 88vw;\n      width: 88vw;\n    }\n  }\n</style>\n\n<div class=\"rv-wrap\">\n  <div class=\"rv-title\">Loved by Our Customers</div>\n  <div class=\"rv-stars\">★★★★★</div>\n  <div class=\"rv-subtitle\">4.8 out of 5 — based on 1,342 reviews</div>\n\n  <div class=\"rv-scroll\">\n\n    <!-- PHOTO REVIEW 1 -->\n    <div class=\"rv-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0742/4068/8311/files/pdyRquwCo.jpg?v=1788434155\" alt=\"Customer photo review\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Honestly exceeded my expectations. The quality feels premium and it arrived faster than I thought it would.</div>\n        <div class=\"rv-name-row\">\n          Rania Khoury\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">August 14, 2026</div>\n      </div>\n    </div>\n\n    <!-- PHOTO REVIEW 2 -->\n    <div class=\"rv-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0742/4068/8311/files/x4H7eFbk3.jpg?v=1788434156\" alt=\"Customer photo review\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">This is my second order already. Packaging was neat and the product looks even better in person.</div>\n        <div class=\"rv-name-row\">\n          Karim Abou Khalil\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">July 29, 2026</div>\n      </div>\n    </div>\n\n    <!-- PHOTO REVIEW 3 -->\n    <div class=\"rv-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0742/4068/8311/files/AwtI7hIIv.jpg?v=1788434155\" alt=\"Customer photo review\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Customer service answered all my questions within minutes. Really smooth experience from start to finish.</div>\n        <div class=\"rv-name-row\">\n          Layal Haddad\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">August 3, 2026</div>\n      </div>\n    </div>\n\n    <!-- PHOTO REVIEW 4 -->\n    <div class=\"rv-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0742/4068/8311/files/mSyql5X96.jpg?v=1788434156\" alt=\"Customer photo review\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Bought this as a gift and ended up ordering one for myself too. Worth every dollar.</div>\n        <div class=\"rv-name-row\">\n          Elie Nassif\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">June 21, 2026</div>\n      </div>\n    </div>\n\n    <!-- PHOTO REVIEW 5 -->\n    <div class=\"rv-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0742/4068/8311/files/ubY4lOeH2.jpg?v=1788434156\" alt=\"Customer photo review\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Was hesitant at first because of the price, but after using it for a few weeks I get why people love it.</div>\n        <div class=\"rv-name-row\">\n          Maya Sarkis\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">July 5, 2026</div>\n      </div>\n    </div>\n\n    <!-- TEXT-ONLY REVIEW 1 -->\n    <div class=\"rv-card\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Fast shipping to Beirut and the item matched the description exactly. Will be ordering again.</div>\n        <div class=\"rv-name-row\">\n          Joe Chidiac\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">August 20, 2026</div>\n      </div>\n    </div>\n\n    <!-- TEXT-ONLY REVIEW 2 -->\n    <div class=\"rv-card\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Simple checkout process and great communication about my order status the whole way through.</div>\n        <div class=\"rv-name-row\">\n          Sarah Fakhoury\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">May 30, 2026</div>\n      </div>\n    </div>\n\n    <!-- TEXT-ONLY REVIEW 3 -->\n    <div class=\"rv-card\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">I compared a few similar products before deciding, and this one had the best value by far.</div>\n        <div class=\"rv-name-row\">\n          Tarek Aoun\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">June 9, 2026</div>\n      </div>\n    </div>\n\n    <!-- TEXT-ONLY REVIEW 4 -->\n    <div class=\"rv-card\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Great attention to detail in the design. It's clear a lot of thought went into making this.</div>\n        <div class=\"rv-name-row\">\n          Nour Wehbe\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">July 12, 2026</div>\n      </div>\n    </div>\n\n    <!-- TEXT-ONLY REVIEW 5 -->\n    <div class=\"rv-card\">\n      <div class=\"rv-body\">\n        <div class=\"rv-star-row\">★★★★★</div>\n        <div class=\"rv-text\">Recommended this to two of my friends already, they both ended up buying it too.</div>\n        <div class=\"rv-name-row\">\n          Georges Matta\n          <span class=\"rv-verified\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Verified\n          </span>\n        </div>\n        <div class=\"rv-date\">August 1, 2026</div>\n      </div>\n    </div>\n\n  </div>\n</div>",
