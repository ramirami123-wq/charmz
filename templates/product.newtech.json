      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"jlr-reviews-section\">\n  <h2 class=\"jlr-heading\">\n    Loved by <span class=\"jlr-highlight\">women who wear it</span>\n  </h2>\n\n  <div class=\"jlr-grid\">\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Sarah</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\"I always picked the wrong shade. This one just matches. So easy.\"</p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Lina</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\"It goes on white, then turns into my skin color. Looks so natural.\"</p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Dana</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\"I have olive skin and most foundations look orange on me. Not this one.\"</p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Rita</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\"Super light. I forget I'm wearing makeup, and I'm ready in 5 minutes now.\"</p>\n    </div>\n  </div>\n\n \n</div>\n\n<style>\n  .jlr-reviews-section { font-family: Arial, Helvetica, sans-serif; padding: 20px; box-sizing: border-box; width: 100%; max-width: 100vw; overflow-x: hidden; }\n  .jlr-reviews-section * { box-sizing: border-box; }\n  .jlr-heading { text-align: center; font-size: 32px; font-weight: 800; color: #1a1a1a; margin: 0 0 30px 0; }\n  .jlr-highlight { background: #cf9d3f; color: #fff; padding: 4px 12px; border-radius: 4px; white-space: nowrap; }\n  .jlr-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; max-width: 1400px; margin: 0 auto; width: 100%; }\n  .jlr-card { background: #f5f5f4; border-radius: 10px; padding: 20px; min-width: 0; }\n  .jlr-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }\n  .jlr-name { font-size: 15px; font-weight: 700; color: #1a1a1a; }\n  .jlr-stars { color: #cf9d3f; font-size: 14px; letter-spacing: 1px; }\n  .jlr-text { font-size: 14px; line-height: 1.5; color: #1a1a1a; margin: 0; overflow-wrap: break-word; word-break: break-word; }\n  .jlr-disclaimer { text-align: center; font-size: 12px; color: #777; margin: 16px 0 0 0; }\n  @media (max-width: 900px) { .jlr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (max-width: 480px) {\n    .jlr-heading { font-size: 22px; margin-bottom: 20px; }\n    .jlr-highlight { white-space: normal; }\n    .jlr-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }\n    .jlr-card { padding: 16px; }\n    .jlr-name { font-size: 13px; }\n    .jlr-text { font-size: 12.5px; }\n    .jlr-disclaimer { font-size: 11px; }\n  }\n</style>",
