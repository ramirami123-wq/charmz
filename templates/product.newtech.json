        "custom_liquid_H9DXEK": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"skin-benefits-block\">\n  <p class=\"benefits-heading\">\n    Your shade, found in seconds: it goes on white and melts into your own skin tone as you blend, so you finally look like yourself, just smoother, in every light and every photo.\n  </p>\n\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"6\" width=\"18\" height=\"13\" rx=\"2\"/>\n          <path d=\"M3 10h18\"/>\n          <circle cx=\"16.5\" cy=\"14.5\" r=\"1\" fill=\"#1a1a1a\" stroke=\"none\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Stop buying shades that never quite matched</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n          <path d=\"M12 7v5l3 2\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Look polished in under 5 minutes</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z\"/>\n          <path d=\"M19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Skin looks smooth, never cakey or settled in lines</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M4 8h3l2-3h6l2 3h3v11H4z\"/>\n          <circle cx=\"12\" cy=\"13\" r=\"3.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Feel confident in photos, indoors or out</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .skin-benefits-block { font-family: Arial, Helvetica, sans-serif; max-width: 700px; }\n  .benefits-heading { font-size: 15px; line-height: 1.5; color: #1a1a1a; margin: 0 0 20px 0; }\n  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; }\n  .benefit-item { display: flex; align-items: flex-start; gap: 12px; }\n  .benefit-icon { flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: #fbead9; display: flex; align-items: center; justify-content: center; }\n  .benefit-icon svg { width: 20px; height: 20px; }\n  .benefit-text { font-size: 14px; line-height: 1.4; color: #1a1a1a; font-weight: 600; margin: 0; }\n  @media (max-width: 480px) {\n    .benefits-heading { font-size: 12px; margin-bottom: 16px; }\n    .benefits-grid { grid-template-columns: 1fr; gap: 13px; }\n    .benefit-item { gap: 10px; }\n    .benefit-icon { width: 33px; height: 33px; }\n    .benefit-icon svg { width: 16.5px; height: 16.5px; }\n    .benefit-text { font-size: 11.5px; }\n  }\n</style>"
