      "settings": {
        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why Jolie?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"22\" y=\"6\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#c9a55a\"/>\n          <path d=\"M18 20h24l4 58c0 3-2 5-5 5H19c-3 0-5-2-5-5l4-58z\" fill=\"#e8d4a3\" stroke=\"#c9a55a\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"50\" font-size=\"6\" text-anchor=\"middle\" fill=\"#5c4a1e\" font-family=\"Arial\" font-weight=\"700\">JOLIE</text>\n        </svg>\n      </div>\n      <span>Jolie</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"24\" y=\"8\" width=\"12\" height=\"14\" rx=\"2\" fill=\"#333\"/>\n          <rect x=\"16\" y=\"22\" width=\"28\" height=\"58\" rx=\"5\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Other foundations</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Your shade</div>\n      <div class=\"why-row-jolie\">Matches you as you blend</div>\n      <div class=\"why-row-other\">You guess, and often get it wrong</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Skin tones</div>\n      <div class=\"why-row-jolie\">Works on warm, cool and olive skin</div>\n      <div class=\"why-row-other\">Often looks pink or orange</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">How it looks</div>\n      <div class=\"why-row-jolie\">Light and natural</div>\n      <div class=\"why-row-other\">Can look heavy</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Time</div>\n      <div class=\"why-row-jolie\">Done in 5 minutes</div>\n      <div class=\"why-row-other\">Lots of steps</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Buying</div>\n      <div class=\"why-row-jolie\">One tube, done</div>\n      <div class=\"why-row-other\">Buy, return, try again</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Coverage</div>\n      <div class=\"why-row-jolie\">Natural, add more if you want</div>\n      <div class=\"why-row-other\">Thick and cakey</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section { font-family: Arial, Helvetica, sans-serif; background: #f5f5f4; border-radius: 20px; padding: 40px; max-width: 1000px; margin: 0 auto; box-sizing: border-box; }\n  .why-heading { text-align: center; font-size: 30px; font-weight: 800; color: #1a1a1a; margin: 0 0 24px 0; }\n  .why-columns-header { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 16px; align-items: end; border-bottom: 2px solid #1a1a1a; padding-bottom: 12px; margin-bottom: 8px; }\n  .why-col-label { text-align: center; font-size: 16px; font-weight: 700; color: #1a1a1a; }\n  .product-icon { width: 40px; height: 60px; margin: 0 auto 8px auto; }\n  .product-icon svg { width: 100%; height: 100%; }\n  .why-rows { display: flex; flex-direction: column; }\n  .why-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid #ddd; }\n  .why-row-label { font-size: 14px; font-weight: 700; color: #1a1a1a; }\n  .why-row-jolie { font-size: 14px; color: #1a1a1a; }\n  .why-row-other { font-size: 14px; color: #999; }\n  @media (max-width: 700px) {\n    .why-section { padding: 20px; border-radius: 14px; }\n    .why-heading { font-size: 20px; margin-bottom: 16px; }\n    .why-columns-header { display: none; }\n    .why-row { grid-template-columns: 1fr; gap: 6px; padding: 14px 0; }\n    .why-row-label { font-size: 13px; }\n    .why-row-jolie::before { content: \"Jolie: \"; font-weight: 700; color: #1a1a1a; }\n    .why-row-other::before { content: \"Others: \"; font-weight: 700; color: #999; }\n    .why-row-jolie, .why-row-other { font-size: 12.5px; }\n  }\n</style>",
