      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"results-section\">\n  <h2 class=\"results-heading\">\n    What You'll <span class=\"results-highlight\">Notice</span>\n  </h2>\n\n  <div class=\"results-grid\">\n    <div class=\"result-card\">\n      <p class=\"result-percent\">60<span class=\"result-unit\">sec</span></p>\n      <p class=\"result-title\">It turns into<br>your skin color</p>\n      <p class=\"result-subtext\">From the very first use</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">5<span class=\"result-unit\">min</span></p>\n      <p class=\"result-title\">Your full face<br>is done</p>\n      <p class=\"result-subtext\">Dot it on, blend, go</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">1<span class=\"result-unit\">tube</span></p>\n      <p class=\"result-title\">Is all<br>you need</p>\n      <p class=\"result-subtext\">No more mixing shades</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .results-section { font-family: Arial, Helvetica, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; box-sizing: border-box; }\n  .results-heading { text-align: center; font-size: 34px; font-weight: 800; color: #1a1a1a; margin: 0 0 30px 0; }\n  .results-highlight { background: #e0a83e; color: #fff; padding: 2px 10px; }\n  .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n  .result-card { background: #fbf0dc; border-radius: 14px; padding: 30px 24px; text-align: center; box-sizing: border-box; }\n  .result-percent { font-size: 64px; font-weight: 800; color: #e0b25a; line-height: 1; margin: 0 0 16px 0; }\n  .result-unit { font-size: 24px; margin-left: 4px; }\n  .result-title { font-size: 16px; font-weight: 700; color: #1a1a1a; line-height: 1.4; margin: 0 0 10px 0; }\n  .result-subtext { font-size: 12px; color: #555; margin: 0; }\n  @media (max-width: 900px) { .results-grid { grid-template-columns: 1fr; gap: 16px; } }\n  @media (max-width: 480px) {\n    .results-heading { font-size: 22px; margin-bottom: 20px; }\n    .result-card { padding: 22px 18px; }\n    .result-percent { font-size: 44px; margin-bottom: 10px; }\n    .result-unit { font-size: 18px; }\n    .result-title { font-size: 14px; }\n    .result-subtext { font-size: 11px; }\n  }\n</style>",
