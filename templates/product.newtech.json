            "custom_liquid": "<div class=\"guarantee-card\">\n  <div class=\"guarantee-icon\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"#5c4a1e\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <ellipse cx=\"16\" cy=\"30\" rx=\"9\" ry=\"4\"/>\n      <path d=\"M7 30v4c0 2.2 4 4 9 4s9-1.8 9-4v-4\"/>\n      <ellipse cx=\"22\" cy=\"21\" rx=\"9\" ry=\"4\"/>\n      <path d=\"M13 21v4c0 2.2 4 4 9 4s9-1.8 9-4v-4\"/>\n      <path d=\"M15 8v10M12 10.5h6M12 15h6\"/>\n    </svg>\n  </div>\n  <div class=\"guarantee-content\">\n    <p class=\"guarantee-heading\">30-Day Perfect Match Guarantee</p>\n    <p class=\"guarantee-text\">\n      Wear it every day for 30 days. If it doesn't blend into your skin the way you hoped, send it back, opened or unopened, for a full refund.*\n    </p>\n  </div>\n</div>\n\n<style>\n  .guarantee-card { display: flex; align-items: center; gap: 20px; background: linear-gradient(135deg, #f6dfa0, #e8c073); border: 1px dashed #c9a55a; border-radius: 14px; padding: 20px 24px; font-family: Arial, Helvetica, sans-serif; max-width: 700px; box-sizing: border-box; }\n  .guarantee-icon { flex-shrink: 0; width: 44px; height: 44px; }\n  .guarantee-icon svg { width: 100%; height: 100%; }\n  .guarantee-content { min-width: 0; }\n  .guarantee-heading { font-size: 17px; font-weight: 700; color: #1a1a1a; margin: 0 0 6px 0; }\n  .guarantee-text { font-size: 14px; line-height: 1.5; color: #1a1a1a; margin: 0; }\n  @media (max-width: 480px) {\n    .guarantee-card { gap: 14px; padding: 14px 16px; border-radius: 12px; }\n    .guarantee-icon { width: 34px; height: 34px; }\n    .guarantee-heading { font-size: 14px; margin-bottom: 4px; }\n    .guarantee-text { font-size: 12px; line-height: 1.4; }\n  }\n</style>"
