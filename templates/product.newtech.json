    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/dermatologist.webp?v=1792325800\" alt=\"Foundation going on white and blending into skin color\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Match <span class=\"fade-highlight\">Your Skin</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      Tired of picking the wrong shade? This foundation fixes that.\n    </p>\n\n    <p class=\"fade-text\">\n      It comes out white. When you blend it, tiny color beads break and turn into your skin color in about a minute.\n    </p>\n\n    <p class=\"fade-text\">\n      It looks like real skin, not makeup. Want more coverage? Just add a little more.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Matches your skin in 60 seconds</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Light or more coverage, your choice</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .fade-section { display: flex; align-items: stretch; gap: 40px; font-family: Arial, Helvetica, sans-serif; max-width: 1200px; margin: 0 auto; box-sizing: border-box; border-top: 3px solid #e8c073; padding-top: 20px; }\n  .fade-image { flex: 1; min-width: 0; }\n  .fade-image img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 4px; }\n  .fade-content { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 20px 0; }\n  .fade-heading { font-size: 26px; font-weight: 800; color: #1a1a1a; line-height: 1.3; margin: 0 0 20px 0; }\n  .fade-highlight { background: #e8c073; color: #fff; padding: 2px 8px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }\n  .fade-text { font-size: 15px; line-height: 1.6; color: #1a1a1a; margin: 0 0 16px 0; }\n  .fade-highlights { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 8px; }\n  .highlight-item { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #1a1a1a; }\n  .sparkle { color: #e8a94a; font-size: 16px; flex-shrink: 0; }\n  @media (max-width: 768px) {\n    .fade-section { flex-direction: column; gap: 20px; }\n    .fade-heading { font-size: 19px; margin-bottom: 14px; }\n    .fade-text { font-size: 13px; margin-bottom: 12px; }\n    .fade-highlights { gap: 14px; }\n    .highlight-item { font-size: 12.5px; }\n    .fade-content { padding: 0; }\n  }\n</style>",
