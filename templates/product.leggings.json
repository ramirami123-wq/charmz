    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"lumiere-goodbye-section\">\n  <div class=\"lumiere-goodbye-media\">\n    <img src=\"https://lumiereleggings.com/cdn/shop/files/7.jpg?v=1787515194&width=1500\" alt=\"Before and after wearing Lumière Sculpting Leggings\" loading=\"lazy\" />\n  </div>\n\n  <div class=\"lumiere-goodbye-content\">\n    <h2 class=\"lumiere-goodbye-heading\">Say goodbye to always feeling like you need to hide.</h2>\n\n    <p class=\"lumiere-goodbye-text\">\n      Imagine getting dressed without worrying about visible cellulite or how your legs look. No more changing outfits in front of the mirror or covering up at the gym, on walks, or during warmer days.\n    </p>\n\n    <p class=\"lumiere-goodbye-text\">\n      Our Sculpting Leggings shape and smooth your silhouette while supporting your weight-loss journey—helping you feel more confident from the moment you put them on. Wear the dress without hesitation, feel comfortable in your body every day, and enjoy your next holiday without feeling the need to hide.\n    </p>\n\n    <p class=\"lumiere-goodbye-bold\">With Lumière Sculpting Leggings, that becomes reality.</p>\n  </div>\n</div>\n\n<style>\n  .lumiere-goodbye-section {\n    width: 100%;\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    gap: clamp(24px, 5vw, 64px);\n    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 32px);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    box-sizing: border-box;\n  }\n\n  .lumiere-goodbye-section * {\n    box-sizing: border-box;\n  }\n\n  .lumiere-goodbye-media {\n    flex: 1 1 45%;\n    min-width: 0;\n  }\n\n  .lumiere-goodbye-media img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 8px;\n  }\n\n  .lumiere-goodbye-content {\n    flex: 1 1 55%;\n    min-width: 0;\n  }\n\n  .lumiere-goodbye-heading {\n    font-weight: 800;\n    font-size: clamp(24px, 3.6vw, 38px);\n    line-height: 1.25;\n    color: #111;\n    margin: 0 0 clamp(16px, 2.5vw, 24px) 0;\n  }\n\n  .lumiere-goodbye-text {\n    font-size: clamp(15px, 1.6vw, 18px);\n    line-height: 1.7;\n    color: #2b2b2b;\n    font-weight: 600;\n    margin: 0 0 clamp(14px, 2vw, 20px) 0;\n  }\n\n  .lumiere-goodbye-bold {\n    font-weight: 700;\n    font-size: clamp(15px, 1.6vw, 18px);\n    line-height: 1.7;\n    color: #111;\n    margin: clamp(4px, 1vw, 8px) 0 0 0;\n  }\n\n  @media (max-width: 768px) {\n    .lumiere-goodbye-section {\n      flex-direction: column;\n      align-items: stretch;\n      text-align: left;\n      gap: 24px;\n    }\n\n    .lumiere-goodbye-media,\n    .lumiere-goodbye-content {\n      flex: 1 1 100%;\n    }\n  }\n</style>",
