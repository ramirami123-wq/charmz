    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/DESK_PDP_FAQ_700x_758c97f9-2869-48c0-b546-5bfd4de03447.webp?v=1788968680\" alt=\"Before and after results on a cleaned dental appliance\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Clean <span class=\"zima-highlight\">Stains, Buildup &amp; Bad Smells</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      This is the 5-minute clean for the yucky stuff a toothbrush can't get off.\n    </p>\n\n    <p class=\"fade-text\">\n      A toothbrush only cleans the top. Rinsing with water misses the rest — all the germs and buildup stuck deep in the little grooves. Sound waves reach everywhere at once, so months of buildup can come off in one go.\n    </p>\n\n    <p class=\"fade-text\">\n      You'll see it look clean again the very first time you use it, and it stays that way every time after. It cleans your appliance — it never wears it down.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Removes stains and buildup</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Deep clean, never rough</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #3f7ea6;\n    padding-top: 20px;\n  }\n\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .fade-heading .zima-highlight {\n    background-color: #3f7ea6 !important;\n    color: #ffffff !important;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n\n  .sparkle {\n    color: #3f7ea6;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .fade-highlights {\n      gap: 14px;\n    }\n\n    .highlight-item {\n      font-size: 12.5px;\n    }\n\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
        "full_width": false,
