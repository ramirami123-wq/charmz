    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why Our Ultrasonic Cleaner?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"12\" y=\"18\" width=\"36\" height=\"60\" rx=\"8\" fill=\"#dceaf1\" stroke=\"#3f7ea6\" stroke-width=\"1.5\"/>\n          <rect x=\"20\" y=\"8\" width=\"20\" height=\"12\" rx=\"3\" fill=\"#dceaf1\" stroke=\"#3f7ea6\" stroke-width=\"1.5\"/>\n          <circle cx=\"30\" cy=\"46\" r=\"9\" fill=\"none\" stroke=\"#3f7ea6\" stroke-width=\"1.5\"/>\n          <circle cx=\"30\" cy=\"46\" r=\"3\" fill=\"#3f7ea6\"/>\n        </svg>\n      </div>\n      <span>Ultrasonic Cleaner</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Tablets &amp; toothbrush alone</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Reaches deep grooves</div>\n      <div class=\"why-row-jolie\">Sound waves clean every surface at once</div>\n      <div class=\"why-row-other\">Only touches what a brush can physically reach</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Removes bacteria &amp; plaque</div>\n      <div class=\"why-row-jolie\">Breaks it down at the source, not just surface-level</div>\n      <div class=\"why-row-other\">Kills some germs, leaves deeper buildup behind</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Routine</div>\n      <div class=\"why-row-jolie\">One 5-minute cycle, press a button</div>\n      <div class=\"why-row-other\">Scrubbing and soaking every day</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Safe on your appliance</div>\n      <div class=\"why-row-jolie\">Non-abrasive, no scratches</div>\n      <div class=\"why-row-other\">Bristles can scratch and wear it down</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Results</div>\n      <div class=\"why-row-jolie\">Clean and clear after one cycle</div>\n      <div class=\"why-row-other\">Cloudy, stained look creeps back fast</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #f5f5f4;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #1a1a1a;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #ddd;\n  }\n\n  .why-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-row-jolie {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  .why-row-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .why-columns-header {\n      display: none;\n    }\n\n    .why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .why-row-label {\n      font-size: 13px;\n    }\n\n    .why-row-jolie::before {\n      content: \"Us: \";\n      font-weight: 700;\n      color: #1a1a1a;\n    }\n\n    .why-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .why-row-jolie,\n    .why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
        "full_width": false,
