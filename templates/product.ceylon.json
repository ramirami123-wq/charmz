re-item\">\n          <div class=\"feature-icon\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M10 3v4.5c0 1.4 1.1 2.5 2.5 2.5H14a4 4 0 0 1 4 4c0 3-2.5 5-6 5h-2A2.5 2.5 0 0 0 7.5 21.5\"/>\n              <path d=\"M13.5 3v3.5\"/>\n            </svg>\n          </div>\n          <p class=\"feature-label\">Gentle on the Stomach</p>\n        </div>\n\n        <div class=\"feature-item\">\n          <div class=\"feature-icon\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z\"/>\n              <path d=\"M9 12l2.2 2.2L15 10.5\"/>\n            </svg>\n          </div>\n          <p class=\"feature-label\">Liver-Friendly Formula</p>\n        </div>\n\n      </div>\n\n      <div class=\"feel-better-image\">\n       \n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  .feel-better-section {\n    background: linear-gradient(180deg, #d08052 0%, #bd6a3d 45%, #a9562b 100%);\n    padding: 56px 24px 0;\n    font-family: \"Poppins\", Arial, Helvetica, sans-serif;\n    color: #ffffff;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n\n  .feel-better-section *,\n  .feel-better-section *::before,\n  .feel-better-section *::after {\n    box-sizing: border-box;\n  }\n\n  .feel-better-inner {\n    max-width: 1500px;\n    margin: 0 auto;\n  }\n\n  .feel-better-header {\n    text-align: center;\n    max-width: 1050px;\n    margin: 0 auto 70px;\n  }\n\n  .feel-better-title {\n    font-size: clamp(26px, 3.2vw, 40px);\n    font-weight: 500;\n    letter-spacing: 1px;\n    line-height: 1.2;\n    color: #ffffff;\n    margin: 0 0 18px 0;\n  }\n\n  .feel-better-subtitle {\n    font-size: clamp(14px, 1.4vw, 19px);\n 