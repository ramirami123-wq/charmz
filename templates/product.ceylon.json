    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"reviews-section\">\n  <div class=\"reviews-grid\">\n    <div class=\"review-card\">\n      <div class=\"review-rating\">\n        <span class=\"rating-number\">5.0</span>\n        <span class=\"rating-stars\">★★★★★</span>\n      </div>\n      <p class=\"review-title\">Exactly what I was looking for</p>\n      <p class=\"review-body\">I was looking specifically for Ceylon cinnamon. I liked that this one already comes with MCT oil, so I could get both in one product.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-author\">\n          <div class=\"author-avatar\">M</div>\n          <span class=\"author-name\">Maya Khoury</span>\n          \n        </div>\n        <div class=\"review-tags\">\n          <span class=\"review-tag\">Ceylon Cinnamon</span>\n          <span class=\"review-tag\">MCT Oil</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"review-rating\">\n        <span class=\"rating-number\">5.0</span>\n        <span class=\"rating-stars\">★★★★★</span>\n      </div>\n      <p class=\"review-title\">Easy to fit into my morning</p>\n      <p class=\"review-body\">My mornings are usually rushed, so I keep it next to my coffee mugs as a reminder. It was easy to add to the routine I already had.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-author\">\n          <div class=\"author-avatar\">R</div>\n          <span class=\"author-name\">Rania Haddad</span>\n          \n        </div>\n        <div class=\"review-tags\">\n          <span class=\"review-tag\">Morning Routine</span>\n          <span class=\"review-tag\">Convenient</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"review-card\">\n      <div class=\"review-rating\">\n        <span class=\"rating-number\">5.0</span>\n        <span class=\"rating-stars\">★★★★★</span>\n      </div>\n      <p class=\"review-title\">Glad I tried this combination</p>\n      <p class=\"review-body\">I was already using MCT oil and had been curious about trying Ceylon cinnamon. Having them together was what made me pick this one.</p>\n      <div class=\"review-footer\">\n        <div class=\"review-author\">\n          <div class=\"author-avatar\">N</div>\n          <span class=\"author-name\">Nour Nassar</span>\n          \n        </div>\n        <div class=\"review-tags\">\n          <span class=\"review-tag\">Cinnamon + MCT</span>\n          <span class=\"review-tag\">First-Time Buyer</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .reviews-section {\n    background: #f8f3f0;\n    padding: 24px 12px;\n    font-family: \"Poppins\", Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n  }\n\n  .reviews-section .reviews-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 26px;\n    max-width: 1560px;\n    margin: 0 auto;\n  }\n\n  .reviews-section .review-card {\n    display: flex;\n    flex-direction: column;\n    background: #ffffff;\n    border: 2px solid #dedad7;\n    border-radius: 14px;\n    padding: 36px 30px 30px;\n    box-sizing: border-box;\n  }\n\n  .reviews-section .review-rating {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 22px;\n  }\n\n  .reviews-section .rating-number {\n    font-size: 19px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    color: #1a1a1a;\n  }\n\n  .reviews-section .rating-stars {\n    font-size: 20px;\n    letter-spacing: 3px;\n    color: #c47245;\n    line-height: 1;\n  }\n\n  .reviews-section .review-title {\n    font-size: 19px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin: 0 0 14px;\n  }\n\n  .reviews-section .review-body {\n    font-size: 18px;\n    line-height: 1.6;\n    color: #2b2b2b;\n    margin: 0 0 32px;\n  }\n\n  .reviews-section .review-footer {\n    margin-top: auto;\n    border-top: 1px solid #ece8e5;\n    padding-top: 20px;\n  }\n\n  .reviews-section .review-author {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 20px;\n  }\n\n  .reviews-section .author-avatar {\n    flex-shrink: 0;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    background: #f8e6da;\n    color: #7a3f1f;\n    font-size: 14px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  .reviews-section .author-avatar img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .reviews-section .author-name {\n    font-size: 14px;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    color: #6b6b6b;\n  }\n\n  .reviews-section .verified-badge {\n    margin-left: auto;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n    color: #c47245;\n    white-space: nowrap;\n  }\n\n  .reviews-section .verified-badge svg {\n    width: 14px;\n    height: 14px;\n  }\n\n  .reviews-section .review-tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .reviews-section .review-tag {\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 15px;\n    letter-spacing: 0.4px;\n    color: #c47245;\n    background: #fdf5ef;\n    border: 1px solid #c47245;\n    border-radius: 999px;\n    padding: 9px 20px;\n  }\n\n  @media (max-width: 1000px) {\n    .reviews-section .reviews-grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 18px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .reviews-section {\n      padding: 16px 10px;\n    }\n\n    .reviews-section .review-card {\n      padding: 22px 18px 20px;\n      border-radius: 12px;\n    }\n\n    .reviews-section .rating-number,\n    .reviews-section .review-title,\n    .reviews-section .rating-stars {\n      font-size: 16px;\n    }\n\n    .reviews-section .review-body {\n      font-size: 14.5px;\n      margin-bottom: 22px;\n    }\n\n    .reviews-section .author-name {\n      font-size: 12px;\n    }\n\n    .reviews-section .verified-badge {\n      font-size: 11px;\n    }\n\n    .reviews-section .review-tag {\n      font-size: 13px;\n      padding: 7px 14px;\n    }\n  }\n</style>",
