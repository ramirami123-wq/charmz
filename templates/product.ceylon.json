    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"results-section\">\n  <h2 class=\"results-heading\">\n    Real <span class=\"highlight\">Results</span>\n  </h2>\n\n  <div class=\"results-grid\">\n    <div class=\"result-card\">\n      <p class=\"result-percent\">76%</p>\n      <p class=\"result-title\">felt steadier energy<br>by week 3</p>\n     \n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">84%</p>\n      <p class=\"result-title\">found it easy to take<br>every day</p>\n      \n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">91%</p>\n      <p class=\"result-title\">said it was gentle<br>on their stomach</p>\n    \n    </div>\n  </div>\n\n\n</div>\n\n<style>\n  .results-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n  .results-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 30px 0;\n  }\n\n  .highlight {\n    background: #c47245;\n    color: #fff;\n    padding: 2px 10px;\n  }\n\n  .results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n\n  .result-card {\n    background: #f8e6da;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  .result-percent {\n    font-size: 64px;\n    font-weight: 800;\n    color: #c47245;\n    line-height: 1;\n    margin: 0 0 16px 0;\n  }\n\n  .result-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.4;\n    margin: 0 0 10px 0;\n  }\n\n  .result-subtext {\n    font-size: 12px;\n    color: #555;\n    margin: 0;\n  }\n\n  .results-disclaimer {\n    text-align: center;\n    font-size: 12px;\n    line-height: 1.5;\n    color: #555;\n    margin: 20px 0 0 0;\n  }\n\n  @media (max-width: 900px) {\n    .results-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .results-heading {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n\n    .result-card {\n      padding: 22px 18px;\n    }\n\n    .result-percent {\n      font-size: 44px;\n      margin-bottom: 10px;\n    }\n\n    .result-title {\n      font-size: 14px;\n    }\n\n    .result-subtext,\n    .results-disclaimer {\n      font-size: 11px;\n    }\n  }\n</style>",
