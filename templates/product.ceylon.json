    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/metabolae-new-foto-pdp-8.webp?v=1794521848\" alt=\"Ceylon Cinnamon 7200mg equivalent softgels with MCT oil\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Support <span class=\"highlight\">Steady Blood Sugar &amp; Daily Balance</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      Meet the once-a-day softgel made with true Ceylon cinnamon from Sri Lanka, the kind people have trusted for centuries.\n    </p>\n\n    <p class=\"fade-text\">\n      Most cinnamon supplements are dry powder, and many use cheap cassia cinnamon. This one packs a concentrated Ceylon extract, equal to 7200mg of cinnamon bark, into one small softgel with MCT oil, so it's easy to take and gentle on your stomach.\n    </p>\n\n    <p class=\"fade-text\">\n      Take one a day with a meal to help keep your blood sugar steady within the healthy range and support healthy cholesterol. It works with your healthy habits, it never replaces them.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Supports Healthy Blood Sugar</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>True Ceylon, gentle for daily use</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #c47245;\n    padding-top: 20px;\n  }\n\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .highlight {\n    background: #c47245;\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n\n  .sparkle {\n    color: #c47245;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .fade-highlights {\n      gap: 14px;\n    }\n\n    .highlight-item {\n      font-size: 12.5px;\n    }\n\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
