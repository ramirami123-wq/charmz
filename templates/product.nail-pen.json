        "custom_liquid_rQgQ8z": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div id=\"jolie-bundle\">\n  <style>\n    #jolie-bundle { font-family: inherit; margin: 16px 0 20px; }\n    #jolie-bundle .jb-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #888; margin: 0 0 10px; }\n    #jolie-bundle .jb-options { display: flex; flex-direction: column; gap: 9px; margin-bottom: 20px; }\n    #jolie-bundle .jb-btn { display: flex; align-items: center; justify-content: space-between; padding: 13px 15px; border: 1.5px solid #e2e2e2; border-radius: 12px; cursor: pointer; background: #fff; transition: border-color 0.12s; }\n    #jolie-bundle .jb-btn:hover { border-color: #bbb; }\n    #jolie-bundle .jb-btn.active { border: 2px solid #a855f7; background: #faf5ff; }\n    #jolie-bundle .jb-btn.active .jb-name { color: #7e22ce; }\n    #jolie-bundle .jb-name { font-weight: 600; font-size: 14px; color: #111; }\n    #jolie-bundle .jb-desc { font-size: 12px; color: #888; margin-top: 2px; }\n    #jolie-bundle .jb-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }\n    #jolie-bundle .jb-price { font-size: 14px; font-weight: 600; color: #111; }\n    #jolie-bundle .jb-badge { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 20px; background: #dcfce7; color: #15803d; }\n    #jolie-bundle .jb-uv { border: 1px solid #e5e7eb; border-radius: 12px; padding: 13px 15px; background: #f9fafb; margin-bottom: 18px; }\n    #jolie-bundle .jb-uv-row { display: flex; align-items: center; gap: 10px; }\n    #jolie-bundle .jb-uv-check { width: 17px; height: 17px; accent-color: #a855f7; cursor: pointer; flex-shrink: 0; }\n    #jolie-bundle .jb-uv-name { font-size: 14px; color: #111; cursor: pointer; }\n    #jolie-bundle .jb-uv-sub { font-size: 12px; color: #888; }\n    #jolie-bundle .jb-uv-price { font-size: 14px; font-weight: 600; color: #111; margin-left: auto; white-space: nowrap; }\n    #jolie-bundle .jb-free-tag { font-size: 12px; font-weight: 600; color: #15803d; background: #dcfce7; padding: 3px 10px; border-radius: 20px; margin-left: auto; white-space: nowrap; }\n  </style>\n\n  <p class=\"jb-label\">Choose your bundle</p>\n  <div class=\"jb-options\">\n    <div class=\"jb-btn active\" data-qty=\"1\">\n      <div>\n        <div class=\"jb-name\">Buy 1 pen</div>\n        <div class=\"jb-desc\">Pick any color</div>\n      </div>\n      <div class=\"jb-right\">\n        <div class=\"jb-price\">$22.99</div>\n      </div>\n    </div>\n\n    <div class=\"jb-btn\" data-qty=\"2\">\n      <div>\n        <div class=\"jb-name\">Buy 2 pens</div>\n        <div class=\"jb-desc\">Mix any 2 colors</div>\n      </div>\n      <div class=\"jb-right\">\n        <span class=\"jb-badge\">🎁 FREE UV Lamp</span>\n        <div class=\"jb-price\">$45.98</div>\n      </div>\n    </div>\n\n    <div class=\"jb-btn\" data-qty=\"3\">\n      <div>\n        <div class=\"jb-name\">Buy 3 pens</div>\n        <div class=\"jb-desc\">Best value — mix any 3</div>\n      </div>\n      <div class=\"jb-right\">\n        <span class=\"jb-badge\">🎁 FREE UV Lamp</span>\n        <div class=\"jb-price\">$68.97</div>\n      </div>\n    </div>\n  </div>\n\n  <p class=\"jb-label\">UV lamp</p>\n  <div class=\"jb-uv\">\n    <div class=\"jb-uv-row\" id=\"jb-free\" style=\"display:none;\">\n      <span style=\"font-size:20px;\">💡</span>\n      <div>\n        <div class=\"jb-uv-name\" style=\"font-weight:600;\">UV Lamp — included!</div>\n        <div class=\"jb-uv-sub\">Cures your gel nails in 60 seconds</div>\n      </div>\n      <span class=\"jb-free-tag\">FREE</span>\n    </div>\n\n    <div class=\"jb-uv-row\" id=\"jb-paid\" style=\"display:flex;\">\n      <input type=\"checkbox\" class=\"jb-uv-check\" id=\"jb-uv-checkbox\">\n      <label for=\"jb-uv-checkbox\" style=\"flex:1; cursor:pointer;\">\n        <div class=\"jb-uv-name\">Add UV Lamp</div>\n        <div class=\"jb-uv-sub\">Cures your gel nails in 60 seconds</div>\n      </label>\n      <span class=\"jb-uv-price\">+$7.00</span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  let jbQty = 1;\n  let jbProcessing = false;\n  let jbLastHandledAt = 0;\n\n  const UV_PAID_VARIANT_ID = 52066914074906;\n  const UV_FREE_VARIANT_ID = 52066914107674;\n\n  function jbSelect(qty) {\n    jbQty = qty;\n\n    document.querySelectorAll('#jolie-bundle .jb-btn').forEach(function(btn) {\n      btn.classList.remove('active');\n    });\n\n    const active = document.querySelector('#jolie-bundle .jb-btn[data-qty=\"' + qty + '\"]');\n    if (active) active.classList.add('active');\n\n    const free = document.getElementById('jb-free');\n    const paid = document.getElementById('jb-paid');\n    const check = document.getElementById('jb-uv-checkbox');\n\n    if (qty >= 2) {\n      free.style.display = 'flex';\n      paid.style.display = 'none';\n      if (check) check.checked = false;\n    } else {\n      free.style.display = 'none';\n      paid.style.display = 'flex';\n    }\n  }\n\n  function jbNeedsUv() {\n    const check = document.getElementById('jb-uv-checkbox');\n    return (jbQty === 1 && check && check.checked) || (jbQty >= 2);\n  }\n\n  function jbGetUvVariantId() {\n    const check = document.getElementById('jb-uv-checkbox');\n    const addPaidUv = jbQty === 1 && check && check.checked;\n    const addFreeUv = jbQty >= 2;\n\n    if (addPaidUv) return UV_PAID_VARIANT_ID;\n    if (addFreeUv) return UV_FREE_VARIANT_ID;\n    return null;\n  }\n\n  async function jbGetCart() {\n    const res = await fetch('/cart.js', {\n      credentials: 'same-origin',\n      headers: { 'Accept': 'application/json' }\n    });\n    return await res.json();\n  }\n\n  async function jbCartHasVariant(variantId) {\n    const cart = await jbGetCart();\n    return cart.items.some(function(item) {\n      return Number(item.variant_id) === Number(variantId);\n    });\n  }\n\n  function jbDispatchCartEvents(cart) {\n    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));\n    document.dispatchEvent(new CustomEvent('cart:updated', {\n      bubbles: true,\n      detail: { cart: cart }\n    }));\n    document.dispatchEvent(new CustomEvent('cart:change', {\n      bubbles: true,\n      detail: { cart: cart }\n    }));\n    document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));\n  }\n\n  async function jbRefreshCartUi() {\n    try {\n      const cart = await jbGetCart();\n      jbDispatchCartEvents(cart);\n    } catch (e) {\n      console.error('JB cart UI refresh error:', e);\n    }\n  }\n\n  async function jbAddUvLamp() {\n    const uvVariantId = jbGetUvVariantId();\n    if (!uvVariantId) return;\n\n    const alreadyInCart = await jbCartHasVariant(uvVariantId);\n    if (alreadyInCart) return;\n\n    const res = await fetch('/cart/add.js', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'Accept': 'application/json'\n      },\n      body: JSON.stringify({\n        items: [\n          {\n            id: Number(uvVariantId),\n            quantity: 1\n          }\n        ]\n      }),\n      credentials: 'same-origin'\n    });\n\n    let data = null;\n    try {\n      data = await res.json();\n    } catch (e) {}\n\n    if (!res.ok) {\n      console.error('JB UV add failed:', data);\n      return;\n    }\n\n    setTimeout(function() {\n      jbRefreshCartUi();\n    }, 250);\n  }\n\n  function jbHandlePossibleProductAdd() {\n    if (!jbNeedsUv()) return;\n    if (jbProcessing) return;\n\n    const now = Date.now();\n    if (now - jbLastHandledAt < 1500) return;\n\n    jbLastHandledAt = now;\n    jbProcessing = true;\n\n    setTimeout(async function() {\n      try {\n        await jbAddUvLamp();\n      } catch (err) {\n        console.error('JB handle error:', err);\n      }\n      jbProcessing = false;\n    }, 700);\n  }\n\n  function patchFetch() {\n    const originalFetch = window.fetch;\n    if (!originalFetch || originalFetch.__jbPatched) return;\n\n    const wrappedFetch = async function() {\n      const args = arguments;\n      const url = args[0];\n      const response = await originalFetch.apply(this, args);\n\n      try {\n        const urlString = typeof url === 'string' ? url : (url && url.url ? url.url : '');\n        if (\n          urlString.indexOf('/cart/add') !== -1 ||\n          urlString.indexOf('/cart/add.js') !== -1\n        ) {\n          jbHandlePossibleProductAdd();\n        }\n      } catch (e) {\n        console.error('JB fetch patch error:', e);\n      }\n\n      return response;\n    };\n\n    wrappedFetch.__jbPatched = true;\n    window.fetch = wrappedFetch;\n  }\n\n  function patchXHR() {\n    if (XMLHttpRequest.prototype.__jbPatched) return;\n\n    const originalOpen = XMLHttpRequest.prototype.open;\n    const originalSend = XMLHttpRequest.prototype.send;\n\n    XMLHttpRequest.prototype.__jbPatched = true;\n\n    XMLHttpRequest.prototype.open = function(method, url) {\n      this._jbUrl = url;\n      return originalOpen.apply(this, arguments);\n    };\n\n    XMLHttpRequest.prototype.send = function() {\n      this.addEventListener('load', function() {\n        try {\n          const url = this._jbUrl || '';\n          if (\n            url.indexOf('/cart/add') !== -1 ||\n            url.indexOf('/cart/add.js') !== -1\n          ) {\n            jbHandlePossibleProductAdd();\n          }\n        } catch (e) {\n          console.error('JB XHR patch error:', e);\n        }\n      });\n\n      return originalSend.apply(this, arguments);\n    };\n  }\n\n  function initBundleButtons() {\n    document.querySelectorAll('#jolie-bundle .jb-btn').forEach(function(btn) {\n      btn.addEventListener('click', function() {\n        const qty = Number(btn.getAttribute('data-qty'));\n        jbSelect(qty);\n      });\n    });\n  }\n\n  initBundleButtons();\n  patchFetch();\n  patchXHR();\n  jbSelect(1);\n})();\n</script>"
