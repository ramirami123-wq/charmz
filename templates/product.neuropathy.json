    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"nr-results-section\">\n  <h2 class=\"nr-results-heading\">\n    Real <span class=\"nr-highlight\">Results</span>\n  </h2>\n  <div class=\"nr-results-grid\">\n    <div class=\"nr-result-card\">\n      <p class=\"nr-result-percent\">95%</p>\n      <p class=\"nr-result-title\">felt noticeable relief<br>from the first application</p>\n      <p class=\"nr-result-subtext\">Based on a survey of 7,596 customers</p>\n    </div>\n    <div class=\"nr-result-card\">\n      <p class=\"nr-result-percent\">89%</p>\n      <p class=\"nr-result-title\">slept through the night<br>without burning or tingling</p>\n      <p class=\"nr-result-subtext\">Based on a survey of 7,596 customers</p>\n    </div>\n    <div class=\"nr-result-card\">\n      <p class=\"nr-result-percent\">84%</p>\n      <p class=\"nr-result-title\">would recommend it to a<br>friend with neuropathy</p>\n      <p class=\"nr-result-subtext\">Based on a survey of 7,596 customers</p>\n    </div>\n  </div>\n</div>\n<style>\n  .nr-results-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n  .nr-results-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 30px 0;\n  }\n  .nr-highlight {\n    background: linear-gradient(135deg, #4a86e0, #1e3a8a);\n    color: #fff;\n    padding: 2px 10px;\n  }\n  .nr-results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .nr-result-card {\n    background: #eef4fc;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n  .nr-result-percent {\n    font-size: 64px;\n    font-weight: 800;\n    background: linear-gradient(135deg, #4a86e0, #1e3a8a);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: #2563eb;\n    -webkit-text-fill-color: transparent;\n    line-height: 1;\n    margin: 0 0 16px 0;\n  }\n  .nr-result-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.4;\n    margin: 0 0 10px 0;\n  }\n  .nr-result-subtext {\n    font-size: 12px;\n    color: #555;\n    margin: 0;\n  }\n  @media (max-width: 900px) {\n    .nr-results-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n  @media (max-width: 480px) {\n    .nr-results-heading {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n    .nr-result-card {\n      padding: 22px 18px;\n    }\n    .nr-result-percent {\n      font-size: 44px;\n      margin-bottom: 10px;\n    }\n    .nr-result-title {\n      font-size: 14px;\n    }\n    .nr-result-subtext {\n      font-size: 11px;\n    }\n  }\n</style>",
