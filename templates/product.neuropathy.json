    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"nw-section\">\n  <h2 class=\"nw-heading\">Why Us?</h2>\n\n  <div class=\"nw-columns-header\">\n    <div class=\"nw-col-label\"></div>\n    <div class=\"nw-col-label\">\n      <div class=\"nw-product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <defs>\n            <linearGradient id=\"nwJar\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#bcd8fa\"/>\n              <stop offset=\"100%\" stop-color=\"#4a86e0\"/>\n            </linearGradient>\n          </defs>\n          <rect x=\"10\" y=\"40\" width=\"40\" height=\"38\" rx=\"6\" fill=\"url(#nwJar)\" stroke=\"#1e3a8a\" stroke-width=\"1.5\"/>\n          <rect x=\"8\" y=\"30\" width=\"44\" height=\"12\" rx=\"3\" fill=\"#1e3a8a\" stroke=\"#1e3a8a\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"62\" font-size=\"7\" text-anchor=\"middle\" fill=\"#ffffff\" font-family=\"Arial\" font-weight=\"700\">NERVE</text>\n        </svg>\n      </div>\n      <span>Us</span>\n    </div>\n    <div class=\"nw-col-label\">\n      <div class=\"nw-product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Ordinary lotions &amp; creams</span>\n    </div>\n  </div>\n\n  <div class=\"nw-rows\">\n    <div class=\"nw-row\">\n      <div class=\"nw-row-label\">Feel it working</div>\n      <div class=\"nw-row-us\">Cooling comfort within minutes of rubbing it in</div>\n      <div class=\"nw-row-other\">Rub it in and hope something happens</div>\n    </div>\n\n    <div class=\"nw-row\">\n      <div class=\"nw-row-label\">Your nights</div>\n      <div class=\"nw-row-us\">Part of a calmer bedtime, fewer 2 a.m. wake-ups</div>\n      <div class=\"nw-row-other\">Wears off before you fall asleep</div>\n    </div>\n\n    <div class=\"nw-row\">\n      <div class=\"nw-row-label\">Made for your problem</div>\n      <div class=\"nw-row-us\">Made for burning, tingling feet, hands &amp; legs</div>\n      <div class=\"nw-row-other\">Generic moisture for dry skin only</div>\n    </div>\n\n    <div class=\"nw-row\">\n      <div class=\"nw-row-label\">How it feels</div>\n      <div class=\"nw-row-us\">Absorbs fully, socks &amp; sheets stay clean</div>\n      <div class=\"nw-row-other\">Greasy film or a strong medicinal smell</div>\n    </div>\n\n    <div class=\"nw-row\">\n      <div class=\"nw-row-label\">Your risk</div>\n      <div class=\"nw-row-us\">60-day money-back guarantee</div>\n      <div class=\"nw-row-other\">Stuck with another jar that didn't help</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .nw-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #eef4fc;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .nw-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .nw-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #1e3a8a;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .nw-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .nw-product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .nw-product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .nw-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .nw-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #cddcf1;\n  }\n\n  .nw-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .nw-row-us {\n    font-size: 14px;\n    font-weight: 600;\n    color: #1e3a8a;\n  }\n\n  .nw-row-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .nw-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .nw-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .nw-columns-header {\n      display: none;\n    }\n\n    .nw-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .nw-row-label {\n      font-size: 13px;\n    }\n\n    .nw-row-us::before {\n      content: \"Us: \";\n      font-weight: 700;\n      color: #1e3a8a;\n    }\n\n    .nw-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .nw-row-us,\n    .nw-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
