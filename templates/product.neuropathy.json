          "settings": {
            "custom_liquid": "<div class=\"nerve-benefits-block\">\n  <p class=\"benefits-heading\">\n    Burning, tingling feet don't have to steal another night from you: a cooling magnesium cream that calms tired feet, hands &amp; legs within minutes, so you can finally rest, walk and enjoy your days again.\n  </p>\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- moon: sleep -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\"/>\n          <path d=\"M17 3v3M15.5 4.5h3\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Sleep through the night instead of rubbing your feet at 2AM</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- snowflake: cooling -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 2v20M4.9 7l14.2 10M4.9 17l14.2-10\"/>\n          <path d=\"M9.5 3.5L12 6l2.5-2.5M9.5 20.5L12 18l2.5 2.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Cooling comfort you feel minutes after rubbing it in</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- footprints: walking -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M8 3C6.3 3 5 4.8 5 8c0 2.4.8 4.3 1.7 5.5h3.1c.5-1.4.9-3.2.9-5.5C10.7 4.8 9.6 3 8 3z\"/>\n          <path d=\"M6.8 16.5h3v1a1.5 1.5 0 0 1-3 0z\"/>\n          <path d=\"M16 7c-1.7 0-3 1.8-3 5 0 2.4.8 4.3 1.7 5.5h3.1c.5-1.4.9-3.2.9-5.5 0-3.2-1.1-5-2.7-5z\"/>