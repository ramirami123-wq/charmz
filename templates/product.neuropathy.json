    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"nf-section\">\n  <div class=\"nf-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/Untitled_design_26.webp?v=1790879737\" alt=\"How the Neuropathy Guy Nerve Cream absorbs into the skin\" loading=\"lazy\">\n  </div>\n  <div class=\"nf-content\">\n    <h2 class=\"nf-heading\">\n      Made For <span class=\"nf-highlight\">Burning Feet, Pins &amp; Needles &amp; Sleepless Nights</span>\n    </h2>\n    <p class=\"nf-text\">\n      Meet the cooling nerve cream made for the burning, the tingling, and the 2 a.m. wake-ups that nothing else has calmed.\n    </p>\n    <p class=\"nf-text\">\n      Most creams sit on top of your skin and fade within minutes. This one sinks in fast, carrying magnesium into the skin while a cooling layer of menthol goes to work right where your feet, hands and legs bother you most.\n    </p>\n    <p class=\"nf-text\">\n      You feel the cool, calming comfort within minutes of rubbing it in, and with nightly use, bedtime stops being something you dread. It absorbs completely, so it never leaves your socks or sheets greasy.\n    </p>\n    <div class=\"nf-highlights\">\n      <div class=\"nf-highlight-item\">\n        <span class=\"nf-sparkle\">✦</span>\n        <span>Soothes burning &amp; tingling feet</span>\n      </div>\n      <div class=\"nf-highlight-item\">\n        <span class=\"nf-sparkle\">✦</span>\n        <span>Cooling comfort, never greasy</span>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n  .nf-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #4a86e0;\n    padding-top: 20px;\n  }\n  .nf-image {\n    flex: 1;\n    min-width: 0;\n  }\n  .nf-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n  .nf-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n  .nf-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n  .nf-highlight {\n    background: linear-gradient(135deg, #4a86e0, #1e3a8a);\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n  .nf-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n  .nf-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n  .nf-highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n  .nf-sparkle {\n    color: #2563eb;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n  @media (max-width: 768px) {\n    .nf-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n    .nf-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n    .nf-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n    .nf-highlights {\n      gap: 14px;\n    }\n    .nf-highlight-item {\n      font-size: 12.5px;\n    }\n    .nf-content {\n      padding: 0;\n    }\n  }\n</style>",
