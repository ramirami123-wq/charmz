    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"vs-block\">\n  <div class=\"vs-block-head\">\n    <p class=\"vs-eyebrow\">The difference is in the ingredients</p>\n    <h2 class=\"vs-title\">Chemical Treatments <span class=\"vs-vs\">vs</span> Norse Organics</h2>\n  </div>\n\n  <div class=\"vs-cols\">\n    <div class=\"vs-col vs-col-chem\">\n      <div class=\"vs-col-head\">\n        <span class=\"vs-col-icon vs-col-icon-chem\">✕</span>\n        <span class=\"vs-col-name\">Chemical Treatments</span>\n      </div>\n      <div class=\"vs-list\">\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Ingredients</span><span class=\"vs-point-val\">Synthetic actives, alcohol, fragrance</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Formula</span><span class=\"vs-point-val\">Mostly water and fillers</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Side effects</span><span class=\"vs-point-val\">Dryness, peeling, redness</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Skin barrier</span><span class=\"vs-point-val\">Weakens it over time</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Long-term</span><span class=\"vs-point-val\">Needs ongoing upkeep</span></div>\n      </div>\n    </div>\n\n    <div class=\"vs-col vs-col-norse\">\n      <div class=\"vs-col-head\">\n        <span class=\"vs-col-icon vs-col-icon-norse\">✓</span>\n        <span class=\"vs-col-name\">Norse Organics</span>\n      </div>\n      <div class=\"vs-list\">\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Ingredients</span><span class=\"vs-point-val\">Sea buckthorn &amp; marigold</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Formula</span><span class=\"vs-point-val\">0% water, nothing diluted</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Side effects</span><span class=\"vs-point-val\">Gentle enough for daily use</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Skin barrier</span><span class=\"vs-point-val\">Helps rebuild it</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Long-term</span><span class=\"vs-point-val\">Supports lasting balance</span></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .vs-block{\n    max-width:820px;\n    margin:0 auto;\n    box-sizing:border-box;\n  }\n  .vs-block *{box-sizing:border-box;}\n  .vs-block-head{\n    text-align:center;\n    margin-bottom:36px;\n  }\n  .vs-eyebrow{\n    font-size:13px;\n    color:#7a7568;\n    margin:0 0 10px 0;\n  }\n  .vs-title{\n    font-size:28px;\n    font-weight:800;\n    color:#1f2420;\n    margin:0;\n    line-height:1.3;\n  }\n  .vs-vs{\n    color:#a8a290;\n    font-weight:500;\n    font-size:20px;\n    padding:0 6px;\n  }\n  .vs-cols{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:20px;\n    align-items:stretch;\n  }\n  .vs-col{\n    border-radius:16px;\n    padding:28px 26px;\n  }\n  .vs-col-chem{\n    background:#eeece5;\n    border:1px solid #e0ddd2;\n  }\n  .vs-col-norse{\n    background:#2f3c34;\n    border:1px solid #2f3c34;\n  }\n  .vs-col-head{\n    display:flex;\n    align-items:center;\n    gap:12px;\n    margin-bottom:22px;\n    padding-bottom:20px;\n    border-bottom:1px solid rgba(0,0,0,0.08);\n  }\n  .vs-col-norse .vs-col-head{\n    border-bottom:1px solid rgba(255,255,255,0.14);\n  }\n  .vs-col-icon{\n    width:30px;\n    height:30px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:14px;\n    font-weight:800;\n    flex-shrink:0;\n  }\n  .vs-col-icon-chem{\n    background:#e2ddd0;\n    color:#8a5a4a;\n  }\n  .vs-col-icon-norse{\n    background:#7fa593;\n    color:#16241c;\n  }\n  .vs-col-name{\n    font-size:17px;\n    font-weight:700;\n    color:#1f2420;\n  }\n  .vs-col-norse .vs-col-name{\n    color:#f2f0e8;\n  }\n  .vs-list{\n    display:flex;\n    flex-direction:column;\n    gap:16px;\n  }\n  .vs-point{\n    display:flex;\n    flex-direction:column;\n    gap:3px;\n  }\n  .vs-point-label{\n    font-size:12px;\n    font-weight:700;\n    color:#8f8a7a;\n  }\n  .vs-col-norse .vs-point-label{\n    color:#9fb3a7;\n  }\n  .vs-point-val{\n    font-size:15px;\n    line-height:1.45;\n    color:#2b2b26;\n    font-weight:500;\n  }\n  .vs-col-norse .vs-point-val{\n    color:#f2f0e8;\n  }\n\n  @media(max-width:640px){\n    .vs-title{font-size:21px;}\n    .vs-vs{font-size:15px;}\n    .vs-cols{grid-template-columns:1fr; gap:16px;}\n    .vs-col{padding:22px 20px;}\n  }\n</style>",
