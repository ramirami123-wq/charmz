    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/1_-_befo_IG-7.webp?v=1788868884\" alt=\"Before and after results on acne and redness\" loading=\"lazy\">\n  </div>\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To Clear <span class=\"highlight\">Acne, Breakouts &amp; Redness</span>\n    </h2>\n    <p class=\"fade-text\">\n      Meet the overnight balm built for the breakouts and redness nothing else has touched.\n    </p>\n    <p class=\"fade-text\">\n      Most creams evaporate within a couple of hours, long before they reach the bacteria and inflammation sitting deeper down. This one seals sea buckthorn and marigold against your skin for a full 8 hours while you sleep, the contact time they always needed to actually work.\n    </p>\n    <p class=\"fade-text\">\n      You wake up calmer the first morning, and your skin keeps clearing over the following weeks. It calms your breakouts, it never dries out or irritates your skin.\n    </p>\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Clears Acne &amp; Breakouts</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Calms redness, never dries you out</span>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #e8c073;\n    padding-top: 20px;\n  }\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n  .highlight {\n    background: #e8c073;\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n  .sparkle {\n    color: #e8a94a;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n    .fade-highlights {\n      gap: 14px;\n    }\n    .highlight-item {\n      font-size: 12.5px;\n    }\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
        "full_width": false,
