            "custom_liquid": "<div class=\"skin-benefits-block\">\n  <p class=\"benefits-heading\">\n    Your pimples and red spots don't have to stay: these natural plant oils work on them all night while you sleep.\n  </p>\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M19 9c0-3.5-3-6-7-6-3.2 0-5.8 1.7-6.7 4.2L3 8.5V12h2l1 2v2h3v-1.5h4V16h3v-3l1.5-1.2C18.4 11 19 10.1 19 9z\"/>\n          <circle cx=\"15\" cy=\"8\" r=\"1\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <path d=\"M8 9l-1.5-1.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Stop buying creams that don't do anything</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"10\" cy=\"12\" r=\"7\"/>\n          <circle cx=\"7.5\" cy=\"10.5\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <circle cx=\"12.5\" cy=\"10.5\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <path d=\"M7.5 14c0.8 1 2 1.5 2.5 1.5s1.7-0.5 2.5-1.5\"/>\n          <path d=\"M17 8v4M15 10h4\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Skin feels calmer by morning, pimples fade in a few days</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Pimples and red marks get smaller every week</p>\n    </div>\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z\"/>\n          <path d=\"M12 9v6M9 12h6\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Calms down pimples and redness, without drying out your skin</p>\n    </div>\n  </div>\n</div>\n<style>\n  .skin-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n  .benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n  .benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n  .benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: #fbead9;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n  .benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n  @media (max-width: 480px) {\n    .benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n    .benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n    .benefit-item {\n      gap: 10px;\n    }\n    .benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n    .benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n    }\n    .benefit-text {\n      font-size: 11.5px;\n    }\n  }\n</style>"
