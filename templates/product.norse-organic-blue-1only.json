    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"myth-block\">\n  <h2 class=\"myth-title\">What actually calms a breakout</h2>\n  <p class=\"myth-sub\">Five things the skincare aisle got wrong.</p>\n\n  <div class=\"myth-list\">\n    <div class=\"myth-row\">\n      <span class=\"myth-old\">Alcohol that strips your skin</span>\n      <span class=\"myth-arrow\">→</span>\n      <span class=\"myth-new\">Sea buckthorn that calms it</span>\n    </div>\n    <div class=\"myth-row\">\n      <span class=\"myth-old\">Products that are 70% water</span>\n      <span class=\"myth-arrow\">→</span>\n      <span class=\"myth-new\">A formula with 0% water</span>\n    </div>\n    <div class=\"myth-row\">\n      <span class=\"myth-old\">Treatments that dry you out</span>\n      <span class=\"myth-arrow\">→</span>\n      <span class=\"myth-new\">A balm gentle enough for daily use</span>\n    </div>\n    <div class=\"myth-row\">\n      <span class=\"myth-old\">A barrier weakened over time</span>\n      <span class=\"myth-arrow\">→</span>\n      <span class=\"myth-new\">Ingredients that help rebuild it</span>\n    </div>\n    <div class=\"myth-row\">\n      <span class=\"myth-old\">Upkeep that never really ends</span>\n      <span class=\"myth-arrow\">→</span>\n      <span class=\"myth-new\">Skin that finds its own balance</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .myth-block{\n    max-width:640px;\n    margin:0 auto;\n    box-sizing:border-box;\n  }\n  .myth-block *{box-sizing:border-box;}\n  .myth-title{\n    font-family:\"Iowan Old Style\",\"Palatino Linotype\",Georgia,serif;\n    font-size:30px;\n    font-weight:600;\n    color:#1f2420;\n    margin:0 0 8px 0;\n    line-height:1.25;\n  }\n  .myth-sub{\n    font-size:15px;\n    color:#7a7568;\n    margin:0 0 34px 0;\n  }\n  .myth-list{\n    border-top:1px solid #ddd8ca;\n  }\n  .myth-row{\n    display:flex;\n    align-items:baseline;\n    flex-wrap:wrap;\n    gap:10px;\n    padding:20px 0;\n    border-bottom:1px solid #ddd8ca;\n  }\n  .myth-old{\n    font-size:15px;\n    color:#a39d8c;\n    text-decoration:line-through;\n    text-decoration-color:#c2a99a;\n    text-decoration-thickness:1.5px;\n  }\n  .myth-arrow{\n    font-size:15px;\n    color:#b9a26a;\n    flex-shrink:0;\n  }\n  .myth-new{\n    font-size:16px;\n    font-weight:700;\n    color:#2f3c34;\n  }\n\n  @media(max-width:560px){\n    .myth-title{font-size:23px;}\n    .myth-row{\n      flex-direction:column;\n      gap:4px;\n      padding:16px 0;\n    }\n    .myth-arrow{display:none;}\n    .myth-old{font-size:13.5px;}\n    .myth-new{font-size:14.5px;}\n  }\n</style>",
