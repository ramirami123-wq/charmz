    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"dt-results-section\">\n  <h2 class=\"dt-results-heading\">\n    Real <span class=\"dt-results-highlight\">Results</span>\n  </h2>\n  <div class=\"dt-results-grid\">\n    <div class=\"dt-result-card\">\n      <p class=\"dt-result-percent\">92%</p>\n      <p class=\"dt-result-title\">noticed fresher breath<br>within the first week</p>\n      <p class=\"dt-result-subtext\">Based on a survey of 1,250 customers</p>\n    </div>\n    <div class=\"dt-result-card\">\n      <p class=\"dt-result-percent\">87%</p>\n      <p class=\"dt-result-title\">said their pet's teeth looked<br>cleaner by week 4</p>\n      <p class=\"dt-result-subtext\">Based on a survey of 1,250 customers</p>\n    </div>\n    <div class=\"dt-result-card\">\n      <p class=\"dt-result-percent\">95%</p>\n      <p class=\"dt-result-title\">said it was easier than<br>brushing their pet's teeth</p>\n      <p class=\"dt-result-subtext\">Based on a survey of 1,250 customers</p>\n    </div>\n  </div>\n</div>\n<style>\n  .dt-results-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n  .dt-results-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 30px 0;\n  }\n  .dt-results-highlight {\n    background: linear-gradient(135deg, #4caf50, #1b5e20);\n    color: #fff;\n    padding: 2px 10px;\n  }\n  .dt-results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .dt-result-card {\n    background: #eef8ec;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n  .dt-result-percent {\n    font-size: 64px;\n    font-weight: 800;\n    background: linear-gradient(135deg, #4caf50, #1b5e20);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: #2e7d32;\n    -webkit-text-fill-color: transparent;\n    line-height: 1;\n    margin: 0 0 16px 0;\n  }\n  .dt-result-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.4;\n    margin: 0 0 10px 0;\n  }\n  .dt-result-subtext {\n    font-size: 12px;\n    color: #555;\n    margin: 0;\n  }\n  @media (max-width: 900px) {\n    .dt-results-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n  @media (max-width: 480px) {\n    .dt-results-heading {\n      font-size: 22px;\n      margin-bottom: 20px;\n    }\n    .dt-result-card {\n      padding: 22px 18px;\n    }\n    .dt-result-percent {\n      font-size: 44px;\n      margin-bottom: 10px;\n    }\n    .dt-result-title {\n      font-size: 14px;\n    }\n    .dt-result-subtext {\n      font-size: 11px;\n    }\n  }\n</style>",
