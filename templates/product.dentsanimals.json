    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"dt-why-section\">\n  <h2 class=\"dt-why-heading\">Why Us?</h2>\n\n  <div class=\"dt-why-columns-header\">\n    <div class=\"dt-why-col-label\"></div>\n    <div class=\"dt-why-col-label\">\n      <div class=\"dt-product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <defs>\n            <linearGradient id=\"dtBottle\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#b9eab5\"/>\n              <stop offset=\"100%\" stop-color=\"#4caf50\"/>\n            </linearGradient>\n          </defs>\n          <rect x=\"16\" y=\"34\" width=\"28\" height=\"48\" rx=\"5\" fill=\"url(#dtBottle)\" stroke=\"#1b5e20\" stroke-width=\"1.5\"/>\n          <rect x=\"22\" y=\"22\" width=\"16\" height=\"12\" fill=\"#1b5e20\" stroke=\"#1b5e20\" stroke-width=\"1.5\"/>\n          <path d=\"M38 25h10v5H38z\" fill=\"#1b5e20\"/>\n          <text x=\"30\" y=\"60\" font-size=\"5.5\" text-anchor=\"middle\" fill=\"#ffffff\" font-family=\"Arial\" font-weight=\"700\">DENTAL</text>\n        </svg>\n      </div>\n      <span>Us</span>\n    </div>\n    <div class=\"dt-why-col-label\">\n      <div class=\"dt-product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Chews &amp; brushing</span>\n    </div>\n  </div>\n\n  <div class=\"dt-why-rows\">\n    <div class=\"dt-why-row\">\n      <div class=\"dt-why-row-label\">Fresh breath</div>\n      <div class=\"dt-why-row-us\">Fresher breath you notice within days</div>\n      <div class=\"dt-why-row-other\">Chews cover the smell for an hour or so</div>\n    </div>\n    <div class=\"dt-why-row\">\n      <div class=\"dt-why-row-label\">Effort</div>\n      <div class=\"dt-why-row-us\">5 seconds a day, no brushing</div>\n      <div class=\"dt-why-row-other\">A toothbrush battle you lose every time</div>\n    </div>\n    <div class=\"dt-why-row\">\n      <div class=\"dt-why-row-label\">Reaches the teeth</div>\n      <div class=\"dt-why-row-us\">Sprays right onto teeth &amp; gums</div>\n      <div class=\"dt-why-row-other\">Chews get gulped down before they do much</div>\n    </div>\n    <div class=\"dt-why-row\">\n      <div class=\"dt-why-row-label\">Extra calories</div>\n      <div class=\"dt-why-row-us\">Zero, no extra treats needed</div>\n      <div class=\"dt-why-row-other\">Daily dental chews add up fast</div>\n    </div>\n    <div class=\"dt-why-row\">\n      <div class=\"dt-why-row-label\">Your risk</div>\n      <div class=\"dt-why-row-us\">60-day money-back guarantee</div>\n      <div class=\"dt-why-row-other\">Another bag of chews that didn't help</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .dt-why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #eef8ec;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n  .dt-why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n  .dt-why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #1b5e20;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n  .dt-why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .dt-product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n  .dt-product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n  .dt-why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n  .dt-why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #cfe6cb;\n  }\n  .dt-why-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .dt-why-row-us {\n    font-size: 14px;\n    font-weight: 600;\n    color: #1b5e20;\n  }\n  .dt-why-row-other {\n    font-size: 14px;\n    color: #999;\n  }\n  @media (max-width: 700px) {\n    .dt-why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n    .dt-why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n    .dt-why-columns-header {\n      display: none;\n    }\n    .dt-why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n    .dt-why-row-label {\n      font-size: 13px;\n    }\n    .dt-why-row-us::before {\n      content: \"Us: \";\n      font-weight: 700;\n      color: #1b5e20;\n    }\n    .dt-why-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n    .dt-why-row-us,\n    .dt-why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
