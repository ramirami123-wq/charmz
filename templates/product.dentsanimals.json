            "custom_liquid": "<div class=\"dt-benefits-block\">\n  <p class=\"dt-benefits-heading\">\n    No more turning your face away when they come in for kisses: a few quick sprays a day keep your dog's or cat's breath fresh and slow new tartar buildup, without ever fighting a toothbrush again.\n  </p>\n  <div class=\"dt-benefits-grid\">\n    <div class=\"dt-benefit-item\">\n      <div class=\"dt-benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z\"/>\n        </svg>\n      </div>\n      <p class=\"dt-benefit-text\">Enjoy kisses &amp; cuddles again without the bad breath</p>\n    </div>\n    <div class=\"dt-benefit-item\">\n      <div class=\"dt-benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M5 19l9-9\"/>\n          <path d=\"M14 10l3-3M15.5 11.5l3-3M12.5 8.5l3-3\"/>\n          <path d=\"M3 3l18 18\"/>\n        </svg>\n      </div>\n      <p class=\"dt-benefit-text\">No more wrestling your pet with a toothbrush</p>\n    </div>\n    <div class=\"dt-benefit-item\">\n      <div class=\"dt-benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M7 3C5 3 3.5 4.6 3.5 7c0 2.5 1 4 1.5 6 .5 2.5 1 7 2.5 7s2-4 3-6c.4-.8.6-1 1.5-1s1.1.2 1.5 1c1 2 1.5 6 3 6s2-4.5 2.5-7c.5-2 1.5-3.5 1.5-6 0-2.4-1.5-4-3.5-4-2 0-3 1-5 1S9 3 7 3z\"/>\n        </svg>\n      </div>\n      <p class=\"dt-benefit-text\">Helps keep teeth cleaner between vet cleanings</p>\n    </div>\n    <div class=\"dt-benefit-item\">\n      <div class=\"dt-benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M8 10h6v10a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z\"/>\n          <path d=\"M9 10V6h4v4\"/>\n          <path d=\"M13 6h3\"/>\n          <path d=\"M18.5 4l1-1M19 6h1.5M18.5 8l1 1\"/>\n        </svg>\n      </div>\n      <p class=\"dt-benefit-text\">Takes 5 seconds a day, even for fussy pets</p>\n    </div>\n  </div>\n</div>\n<style>\n  .dt-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n  .dt-benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n  .dt-benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n  .dt-benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n  .dt-benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, #b9eab5 0%, #4caf50 50%, #1b5e20 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .dt-benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n  .dt-benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n  @media (max-width: 480px) {\n    .dt-benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n    .dt-benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n    .dt-benefit-item {\n      gap: 10px;\n    }\n    .dt-benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n    .dt-benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n    }\n    .dt-benefit-text {\n      font-size: 11.5px;\n    }\n  }\n</style>"
