    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"dt-fade-section\">\n  <div class=\"dt-fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/Capture_d_ecran_2025-10-19_a_14.30.26.webp?v=1790790200\" alt=\"Dental spray being used on a dog's teeth\" loading=\"lazy\">\n  </div>\n  <div class=\"dt-fade-content\">\n    <h2 class=\"dt-fade-heading\">\n      Made For <span class=\"dt-fade-highlight\">Bad Breath, Dirty Teeth &amp; Pets Who Hate Brushing</span>\n    </h2>\n    <p class=\"dt-fade-text\">\n      Meet the daily dental spray made for the dog breath you can smell from across the couch, and the toothbrush battles you lose every single time.\n    </p>\n    <p class=\"dt-fade-text\">\n      Chews and treats only cover up the smell for an hour or so, and brushing never happens because your pet won't sit still. This spray goes straight onto the teeth and gums in seconds, where it fights the bacteria behind bad breath and helps keep new plaque from hardening into tartar.\n    </p>\n    <p class=\"dt-fade-text\">\n      You notice fresher breath within days, and with daily use their teeth stay cleaner between vet visits. No brushing, no struggle, no extra calories.\n    </p>\n    <div class=\"dt-fade-highlights\">\n      <div class=\"dt-fade-highlight-item\">\n        <span class=\"dt-sparkle\">✦</span>\n        <span>Fresher breath within days</span>\n      </div>\n      <div class=\"dt-fade-highlight-item\">\n        <span class=\"dt-sparkle\">✦</span>\n        <span>No brushing needed</span>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n  .dt-fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #4caf50;\n    padding-top: 20px;\n  }\n  .dt-fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n  .dt-fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n  .dt-fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n  .dt-fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n  .dt-fade-highlight {\n    background: linear-gradient(135deg, #4caf50, #1b5e20);\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n  .dt-fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n  .dt-fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n  .dt-fade-highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n  .dt-sparkle {\n    color: #2e7d32;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n  @media (max-width: 768px) {\n    .dt-fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n    .dt-fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n    .dt-fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n    .dt-fade-highlights {\n      gap: 14px;\n    }\n    .dt-fade-highlight-item {\n      font-size: 12.5px;\n    }\n    .dt-fade-content {\n      padding: 0;\n    }\n  }\n</style>",
