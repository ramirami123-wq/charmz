    "custom_liquid_9AGPLc": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% capture review_data %}\nRita Khoury|RK|5|My under-eyes looked more rested|I tried it before a family lunch. Once it dried, my under-eye bags looked less noticeable, especially in photos.\n||\nMaya Haddad|MH|4|A thin layer worked better for me|I used too much the first time and saw a little residue. The next time I used a thinner layer and liked the finish much more.\n||\nNadine Aoun|NA|5|Fits into my makeup routine|I let it set before gently tapping on concealer. My under-eyes looked smoother, and I liked how it sat under my makeup.\n||\nCarla Nassar|CN|5|My eyes looked less puffy on camera|I tried it before a morning video call. Once it set, the puffiness under my eyes looked less obvious in daylight.\n||\nDalia Saad|DS|4|Less is more with this one|The first time I applied it, I could see where it dried. The next time I used less and the finish looked more natural.\n||\nLara Hobeika|LH|5|Worked best on clean, dry skin|I tried it over my usual eye cream first and the finish was uneven. On clean, dry skin, it went on more evenly.\n||\nRania Matar|RM|3|A subtle difference around my eyes|The fine lines near the outer corners looked a little softer. I didn’t see much change in the shadows under my eyes.\n||\nTania Fakhoury|TF|5|Easy to apply with my fingertip|I tapped on a little at a time so I could see where it was going. I felt a slight tightening as it dried.\n||\nJoelle Abi Raad|JR|5|I use it when I’m getting dressed up|I used it before a wedding and liked how my under-eyes looked in photos. I save it for occasions when I have a few extra minutes to get ready.\n{% endcapture %}\n{% assign reviews = review_data | strip | split: '||' %}\n\n<section id=\"link-to-reviews\" class=\"sd-rv\" aria-label=\"Studio Dermal Eye Tightener sample reviews\">\n  <div class=\"sd-rv__wrap\">\n \n\n    <div class=\"sd-rv__layout\">\n      <aside class=\"sd-rv__summary\">\n        <h2>Reviews</h2>\n        <p class=\"sd-rv__muted\">Studio Dermal Reverse-Aging Eye Tightener</p>\n\n        <div class=\"sd-rv__score\">\n          <span class=\"sd-rv__stars\" style=\"--fill: 92%\" aria-hidden=\"true\">★★★★★</span>\n          <strong>4.6 out of 5</strong>\n        </div>\n        <p class=\"sd-rv__muted\">9 sample ratings</p>\n\n        <ul class=\"sd-rv__bars\" aria-label=\"Sample rating breakdown\">\n          <li><span>5 stars</span><span class=\"sd-rv__bar\" style=\"--fill: 67%\" aria-hidden=\"true\"></span><span>67%</span></li>\n          <li><span>4 stars</span><span class=\"sd-rv__bar\" style=\"--fill: 22%\" aria-hidden=\"true\"></span><span>22%</span></li>\n          <li><span>3 stars</span><span class=\"sd-rv__bar\" style=\"--fill: 11%\" aria-hidden=\"true\"></span><span>11%</span></li>\n          <li><span>2 stars</span><span class=\"sd-rv__bar\" aria-hidden=\"true\"></span><span>0%</span></li>\n          <li><span>1 star</span><span class=\"sd-rv__bar\" aria-hidden=\"true\"></span><span>0%</span></li>\n        </ul>\n      </aside>\n\n      <div class=\"sd-rv__main\">\n        <div class=\"sd-rv__topics\">\n          <h3>What the sample reviews cover</h3>\n          <ul class=\"sd-rv__tags\">\n            <li>Under-eye puffiness</li>\n            <li>Thin application</li>\n            <li>Finish under concealer</li>\n          </ul>\n        </div>\n\n        <div class=\"sd-rv__list\">\n          {% for review in reviews %}\n            {% if forloop.index == 4 %}\n              </div>\n              <details class=\"sd-rv__more\">\n                <summary>\n                  <span class=\"sd-rv__show\">Show 6 more reviews</span>\n                  <span class=\"sd-rv__hide\">Show fewer reviews</span>\n                </summary>\n                <div class=\"sd-rv__list\">\n            {% endif %}\n\n            {% assign fields = review | strip | split: '|' %}\n            {% assign star_fill = fields[2] | times: 20 %}\n            <article class=\"sd-rv__card\">\n              <div class=\"sd-rv__person\">\n                <span class=\"sd-rv__avatar\" aria-hidden=\"true\">{{ fields[1] | escape }}</span>\n                <strong>{{ fields[0] | escape }}</strong>\n              </div>\n              <div class=\"sd-rv__headline\">\n                <span class=\"sd-rv__stars sd-rv__stars--small\" style=\"--fill: {{ star_fill }}%\" aria-hidden=\"true\">★★★★★</span>\n                <span class=\"sd-rv__muted\">{{ fields[2] | escape }}/5</span>\n                <h3>{{ fields[3] | escape }}</h3>\n              </div>\n              <p>“{{ fields[4] | escape }}”</p>\n            </article>\n          {% endfor %}\n                </div>\n              </details>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .sd-rv {\n    --ink: #16191f;\n    --muted: #5d6470;\n    --line: #e3e6ea;\n    --soft: #f6f7f8;\n    --gold: #f5a300;\n    --accent: #0f6f78;\n    padding: 48px 20px;\n    background: #fff;\n    color: var(--ink);\n    font-size: 15px;\n    line-height: 1.55;\n  }\n\n  .sd-rv *, .sd-rv *::before { box-sizing: border-box; }\n  .sd-rv h2, .sd-rv h3, .sd-rv p { margin: 0; color: inherit; }\n  .sd-rv__wrap { max-width: 1120px; margin-inline: auto; }\n\n  .sd-rv .sd-rv__disclaimer {\n    margin-bottom: 24px;\n    padding: 10px 14px;\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    background: var(--soft);\n    font-size: 14px;\n  }\n\n  .sd-rv__layout {\n    display: grid;\n    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);\n    gap: 48px;\n    align-items: start;\n  }\n\n  .sd-rv__summary { position: sticky; top: 24px; }\n  .sd-rv__summary h2 { margin-bottom: 6px; font-size: 24px; }\n  .sd-rv .sd-rv__muted { color: var(--muted); font-size: 14px; }\n\n  .sd-rv__score,\n  .sd-rv__person,\n  .sd-rv__headline {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .sd-rv__score { margin: 12px 0 4px; font-size: 17px; }\n  .sd-rv__stars {\n    display: inline-block;\n    background: linear-gradient(90deg, var(--gold) var(--fill), #c6cbd2 var(--fill));\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    font: 20px/1 Arial, sans-serif;\n    letter-spacing: 2px;\n    white-space: nowrap;\n  }\n  .sd-rv__stars--small { font-size: 15px; letter-spacing: 1px; }\n\n  .sd-rv__bars {\n    display: grid;\n    gap: 8px;\n    margin: 16px 0 0;\n    padding: 0;\n    list-style: none;\n  }\n  .sd-rv__bars li {\n    display: grid;\n    grid-template-columns: 46px 1fr 36px;\n    align-items: center;\n    gap: 10px;\n    font-size: 13px;\n  }\n  .sd-rv__bars li span:last-child { text-align: right; }\n  .sd-rv__bar {\n    height: 13px;\n    overflow: hidden;\n    border: 1px solid var(--line);\n    border-radius: 4px;\n    background: var(--soft);\n  }\n  .sd-rv__bar::before {\n    content: \"\";\n    display: block;\n    width: var(--fill, 0%);\n    height: 100%;\n    background: var(--gold);\n  }\n\n  .sd-rv__topics {\n    padding-bottom: 18px;\n    margin-bottom: 18px;\n    border-bottom: 1px solid var(--line);\n  }\n  .sd-rv__topics h3 { font-size: 18px; }\n  .sd-rv__tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin: 10px 0 0;\n    padding: 0;\n    list-style: none;\n  }\n  .sd-rv__tags li {\n    padding: 4px 10px;\n    border: 1px solid var(--line);\n    border-radius: 7px;\n    background: var(--soft);\n    font-size: 13px;\n  }\n\n  .sd-rv__list { display: grid; gap: 18px; }\n  .sd-rv__card { padding-bottom: 18px; border-bottom: 1px solid var(--line); }\n  .sd-rv__person { margin-bottom: 8px; font-size: 14px; }\n  .sd-rv__avatar {\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #e0e6eb;\n    font-size: 12px;\n    font-weight: 700;\n  }\n  .sd-rv__headline { margin-bottom: 6px; }\n  .sd-rv__headline h3 { font-size: 16px; font-weight: 700; }\n  .sd-rv__card p { max-width: 70ch; overflow-wrap: anywhere; }\n\n  .sd-rv__more { margin-top: 16px; }\n  .sd-rv__more summary { width: fit-content; color: var(--accent); cursor: pointer; font-weight: 700; }\n  .sd-rv__more .sd-rv__list { margin-top: 18px; }\n  .sd-rv__hide, .sd-rv__more[open] .sd-rv__show { display: none; }\n  .sd-rv__more[open] .sd-rv__hide { display: inline; }\n\n  @media (max-width: 860px) {\n    .sd-rv { padding: 32px 16px; }\n    .sd-rv__layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }\n    .sd-rv__summary { position: static; }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
