      "settings": {
        "custom_liquid": "<section class=\"et-stats\">\n  <div class=\"et-stats-left\">\n    <h2 class=\"et-stats-title\">Made For Tired Eyes That Want To Look Awake</h2>\n    <p class=\"et-stats-sub\">One tiny drop in the morning, with a full 30 days to try it.</p>\n  </div>\n\n  <div class=\"et-stats-right\">\n    <div class=\"et-stat\">\n      <p class=\"et-stat-number\"><span class=\"et-count\" data-target=\"7\">7</span><span class=\"et-unit\">min</span></p>\n      <div class=\"et-stat-body\">\n        <p class=\"et-stat-heading\">To Dry And Set</p>\n        <p class=\"et-stat-text\">Dab on a thin layer, keep your face still for 5 to 7 minutes, and you're done.</p>\n      </div>\n    </div>\n\n    <div class=\"et-stat\">\n      <p class=\"et-stat-number\"><span class=\"et-count\" data-target=\"16\">16</span><span class=\"et-unit\">hrs</span></p>\n      <div class=\"et-stat-body\">\n        <p class=\"et-stat-heading\">Of Wear, At The Most</p>\n        <p class=\"et-stat-text\">The smoother look can last up to 16 hours, then washes off when you clean your face.</p>\n      </div>\n    </div>\n\n    <div class=\"et-stat\">\n      <p class=\"et-stat-number\"><span class=\"et-count\" data-target=\"30\">30</span></p>\n      <div class=\"et-stat-body\">\n        <p class=\"et-stat-heading\">Days To Try It</p>\n        <p class=\"et-stat-text\">Use it every morning. If you don't love how your eyes look, get a full refund.</p>\n      </div>\n    </div>\n\n    <p class=\"et-stats-note\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n        <circle cx=\"10\" cy=\"10\" r=\"9\" fill=\"currentColor\"/>\n        <circle cx=\"10\" cy=\"6\" r=\"1.2\" fill=\"#fff\"/>\n        <rect x=\"9\" y=\"8.5\" width=\"2\" height=\"6.5\" rx=\"1\" fill=\"#fff\"/>\n      </svg>\n      <span>Results are temporary and different for everyone.</span>\n    </p>\n  </div>\n</section>\n\n<style>\n  .et-stats {\n    --et-main: #f6c9d4;\n    --et-soft: #fdf0f3;\n    --et-dark: #b8587a;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    align-items: center;\n    gap: 40px 80px;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 70px 24px;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #000;\n    box-sizing: border-box;\n  }\n\n  .et-stats-left {\n    text-align: center;\n  }\n\n  .et-stats-title {\n    font-family: \"Arial Black\", \"Helvetica Neue\", Arial, sans-serif;\n    font-weight: 900;\n    font-size: 60px;\n    line-height: 1.05;\n    letter-spacing: -0.5px;\n    margin: 0 0 18px 0;\n  }\n\n  .et-stats-sub {\n    font-size: 20px;\n    line-height: 1.4;\n    margin: 0;\n  }\n\n  .et-stat {\n    display: flex;\n    align-items: center;\n    gap: 22px;\n    padding: 18px 0;\n    border-bottom: 1px solid var(--et-main);\n  }\n\n  .et-stat:first-child {\n    padding-top: 0;\n  }\n\n  .et-stat:nth-of-type(3) {\n    border-bottom: none;\n  }\n\n  .et-stat-number {\n    flex-shrink: 0;\n    min-width: 170px;\n    margin: 0;\n    font-family: \"Arial Black\", \"Helvetica Neue\", Arial, sans-serif;\n    font-weight: 900;\n    font-size: 62px;\n    line-height: 1;\n    color: var(--et-dark);\n    font-variant-numeric: tabular-nums;\n  }\n\n  .et-unit {\n    font-size: 26px;\n    margin-left: 3px;\n  }\n\n  .et-stat-heading {\n    font-size: 27px;\n    font-weight: 700;\n    line-height: 1.25;\n    margin: 0 0 6px 0;\n  }\n\n  .et-stat-text {\n    font-size: 19px;\n    line-height: 1.45;\n    color: #333;\n    margin: 0;\n  }\n\n  .et-stats-note {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin: 44px 0 0 0;\n    font-size: 19px;\n    font-style: italic;\n  }\n\n  .et-stats-note svg {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: var(--et-dark);\n  }\n\n  @media (max-width: 990px) {\n    .et-stats {\n      grid-template-columns: 1fr;\n      padding: 48px 20px;\n    }\n\n    .et-stats-title {\n      font-size: 42px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .et-stats {\n      gap: 28px;\n      padding: 36px 16px;\n    }\n\n    .et-stats-title {\n      font-size: 30px;\n      margin-bottom: 12px;\n    }\n\n    .et-stats-sub {\n      font-size: 14px;\n    }\n\n    .et-stat {\n      gap: 14px;\n      padding: 14px 0;\n    }\n\n    .et-stat-number {\n      min-width: 104px;\n      font-size: 38px;\n    }\n\n    .et-unit {\n      font-size: 16px;\n    }\n\n    .et-stat-heading {\n      font-size: 17px;\n      margin-bottom: 4px;\n    }\n\n    .et-stat-text {\n      font-size: 13px;\n    }\n\n    .et-stats-note {\n      margin-top: 24px;\n      gap: 8px;\n      font-size: 12px;\n    }\n\n    .et-stats-note svg {\n      width: 15px;\n      height: 15px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.querySelector('.et-stats');\n    if (!section) return;\n\n    var counters = section.querySelectorAll('.et-count');\n    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduceMotion || !('IntersectionObserver' in window)) return;\n\n    counters.forEach(function (el) { el.textContent = '0'; });\n\n    function run() {\n      var duration = 1600;\n      var start = null;\n\n      function frame(now) {\n        if (start === null) start = now;\n        var progress = Math.min((now - start) / duration, 1);\n        var eased = 1 - Math.pow(1 - progress, 3);\n\n        counters.forEach(function (el) {\n          var target = parseInt(el.getAttribute('data-target'), 10) || 0;\n          el.textContent = Math.round(target * eased);\n        });\n\n        if (progress < 1) requestAnimationFrame(frame);\n      }\n\n      requestAnimationFrame(frame);\n    }\n\n    var observer = new IntersectionObserver(function (entries) {\n      if (entries[0].isIntersecting) {\n        observer.disconnect();\n        run();\n      }\n    }, { threshold: 0.35 });\n\n    observer.observe(section);\n  })();\n</script>",
