    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"eye-reviews\" aria-label=\"Sample reviews for Reverse-Aging Eye Tightener\">\n  <h2>Reverse-Aging Eye Tightener Reviews</h2>\n\n\n  <div class=\"eye-reviews__grid\">\n    <article class=\"eye-reviews__card\">\n      <h3>My under-eyes looked more rested</h3>\n      <p>“I tried it before a family lunch. Once it dried, my under-eye bags looked less noticeable, especially in photos.”</p>\n      <p class=\"eye-reviews__name\">Rita Khoury</p>\n    </article>\n\n    <article class=\"eye-reviews__card\">\n      <h3>A thin layer worked better for me</h3>\n      <p>“I used too much the first time and saw a little residue. The next time I used a thinner layer and liked the finish much more.”</p>\n      <p class=\"eye-reviews__name\">Maya Haddad</p>\n    </article>\n\n    <article class=\"eye-reviews__card\">\n      <h3>Fits into my makeup routine</h3>\n      <p>“I let it set before gently tapping on concealer. My under-eyes looked smoother, and I liked how it sat under my makeup.”</p>\n      <p class=\"eye-reviews__name\">Nadine Aoun</p>\n    </article>\n  </div>\n</section>\n\n<style>\n  .eye-reviews {\n    max-width: 1120px;\n    margin-inline: auto;\n    padding: 36px 16px;\n    color: #29231f;\n  }\n\n  .eye-reviews h2 {\n    margin: 0 0 8px;\n    color: inherit;\n    font-size: clamp(24px, 4vw, 34px);\n    line-height: 1.2;\n    text-align: center;\n  }\n\n  .eye-reviews .eye-reviews__notice {\n    margin: 0 0 24px;\n    color: #61534a;\n    font-size: 14px;\n    text-align: center;\n  }\n\n  .eye-reviews__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .eye-reviews__card {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 22px;\n    border: 1px solid #e4d8cd;\n    border-radius: 14px;\n    background: #faf6f1;\n  }\n\n  .eye-reviews__card h3,\n  .eye-reviews__card p {\n    margin: 0;\n    color: inherit;\n  }\n\n  .eye-reviews__card h3 {\n    font-size: 18px;\n    line-height: 1.3;\n  }\n\n  .eye-reviews__card p {\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  .eye-reviews__card .eye-reviews__name {\n    margin-top: auto;\n    padding-top: 12px;\n    border-top: 1px solid #e4d8cd;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  @media (max-width: 749px) {\n    .eye-reviews__grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<article class=\"eye-reviews__card\">\n  <h3>My eyes looked less puffy on camera</h3>\n  <p>“I tried it before a morning video call. Once it set, the puffiness under my eyes looked less obvious, especially in daylight.”</p>\n  <p class=\"eye-reviews__name\">Carla Nassar</p>\n</article>\n\n<article class=\"eye-reviews__card\">\n  <h3>Less is more with this one</h3>\n  <p>“The first time I applied it, I could see where it dried. I used a thinner layer the next time and the finish looked much more natural.”</p>\n  <p class=\"eye-reviews__name\">Dalia Saad</p>\n</article>\n\n<article class=\"eye-reviews__card\">\n  <h3>Worked best on clean, dry skin</h3>\n  <p>“I tried it over my usual eye cream first and the finish was uneven. On clean, dry skin, it went on more evenly.”</p>\n  <p class=\"eye-reviews__name\">Lara Hobeika</p>\n</article>\n\n<article class=\"eye-reviews__card\">\n  <h3>A subtle difference around my eyes</h3>\n  <p>“I noticed more of a difference in the fine lines at the outer corners than in the darker area underneath. The finish was subtle, which I liked.”</p>\n  <p class=\"eye-reviews__name\">Rania Matar</p>\n</article>\n\n<article class=\"eye-reviews__card\">\n  <h3>Easy to apply with my fingertip</h3>\n  <p>“I tapped on a little at a time so I could see where it was going. I felt a slight tightening as it dried.”</p>\n  <p class=\"eye-reviews__name\">Tania Fakhoury</p>\n</article>\n\n<article class=\"eye-reviews__card\">\n  <h3>I use it when I’m getting dressed up</h3>\n  <p>“I used it before a wedding and liked how my under-eyes looked in photos. I save it for occasions when I have a few extra minutes to get ready.”</p>\n  <p class=\"eye-reviews__name\">Joelle Abi Raad</p>\n</article>",
        "full_width": true,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"et-why\">\n  <h2 class=\"et-why-heading\">Why Jolie?</h2>\n\n  <div class=\"et-why-header\">\n    <div class=\"et-why-col\"></div>\n    <div class=\"et-why-col\">\n      <div class=\"et-why-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"24\" y=\"6\" width=\"12\" height=\"14\" rx=\"2\" fill=\"#b8587a\"/>\n          <path d=\"M20 20h20l4 56c0 4-3 8-8 8H24c-5 0-8-4-8-8l4-56z\" fill=\"#f6c9d4\" stroke=\"#b8587a\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"54\" font-size=\"7\" text-anchor=\"middle\" fill=\"#7a2f4d\" font-family=\"Arial\" font-weight=\"700\">JOLIE</text>\n        </svg>\n      </div>\n      <span>Jolie</span>\n    </div>\n    <div class=\"et-why-col\">\n      <div class=\"et-why-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Regular eye creams</span>\n    </div>\n  </div>\n\n  <div class=\"et-why-rows\">\n    <div class=\"et-why-row\">\n      <div class=\"et-why-label\">Works fast</div>\n      <div class=\"et-why-jolie\">Tightens as it dries, in 5 to 7 minutes</div>\n      <div class=\"et-why-other\">Can take weeks to show anything</div>\n    </div>\n\n    <div class=\"et-why-row\">\n      <div class=\"et-why-label\">What it does</div>\n      <div class=\"et-why-jolie\">A thin film that smooths the look of bags and lines</div>\n      <div class=\"et-why-other\">Mostly add moisture</div>\n    </div>\n\n    <div class=\"et-why-row\">\n      <div class=\"et-why-label\">Lasts through your day</div>\n      <div class=\"et-why-jolie\">Up to 16 hours of wear</div>\n      <div class=\"et-why-other\">No tightening effect to last</div>\n    </div>\n\n    <div class=\"et-why-row\">\n      <div class=\"et-why-label\">Under makeup</div>\n      <div class=\"et-why-jolie\">Sets clear, concealer goes on top</div>\n      <div class=\"et-why-other\">Can make makeup slide or crease</div>\n    </div>\n\n    <div class=\"et-why-row\">\n      <div class=\"et-why-label\">Honest about results</div>\n      <div class=\"et-why-jolie\">A temporary lift that washes off at night</div>\n      <div class=\"et-why-other\">\"Erase wrinkles forever\" promises</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .et-why {\n    --et-main: #f6c9d4;\n    --et-soft: #fdf0f3;\n    --et-dark: #b8587a;\n    font-family: Arial, Helvetica, sans-serif;\n    background: var(--et-soft);\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .et-why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .et-why-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid var(--et-dark);\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .et-why-col {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .et-why-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .et-why-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .et-why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .et-why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid var(--et-main);\n  }\n\n  .et-why-row:last-child {\n    border-bottom: none;\n  }\n\n  .et-why-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .et-why-jolie {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  .et-why-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .et-why {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .et-why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .et-why-header {\n      display: none;\n    }\n\n    .et-why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .et-why-label {\n      font-size: 13px;\n    }\n\n    .et-why-jolie::before {\n      content: \"Jolie: \";\n      font-weight: 700;\n      color: #1a1a1a;\n    }\n\n    .et-why-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .et-why-jolie,\n    .et-why-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
