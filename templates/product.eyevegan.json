    "custom_liquid_KL9pzK": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .batana-features {\n    background-color: #FBF8ED;\n    padding: clamp(32px, 6vw, 72px) clamp(20px, 6vw, 56px);\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    font-family: Georgia, 'Times New Roman', serif;\n    text-align: center;\n  }\n\n  .batana-features * {\n    box-sizing: border-box;\n  }\n\n  .batana-features__heading {\n    font-size: clamp(28px, 5.5vw, 48px);\n    line-height: 1.2;\n    color: #1B3B2F;\n    margin: 0 0 clamp(16px, 3vw, 24px) 0;\n    font-weight: 400;\n  }\n\n  .batana-features__subtext {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(14px, 2.4vw, 18px);\n    line-height: 1.6;\n    color: #2b2b28;\n    max-width: 640px;\n    margin: 0 auto clamp(32px, 6vw, 56px) auto;\n  }\n\n  .batana-features__grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: clamp(24px, 4vw, 40px);\n  }\n\n  .batana-features__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .batana-features__badge {\n    width: clamp(64px, 12vw, 96px);\n    height: clamp(64px, 12vw, 96px);\n    border-radius: 50%;\n    background-color: #EDE7D6;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: clamp(14px, 2.5vw, 20px);\n  }\n\n  .batana-features__icon {\n    width: clamp(30px, 5.5vw, 42px);\n    height: clamp(30px, 5.5vw, 42px);\n  }\n\n  .batana-features__title {\n    font-size: clamp(15px, 2.4vw, 20px);\n    color: #1B3B2F;\n    margin: 0 0 8px 0;\n    font-weight: 400;\n  }\n\n  .batana-features__desc {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(11px, 1.9vw, 14px);\n    line-height: 1.55;\n    color: #4a4a45;\n    margin: 0;\n    max-width: 220px;\n  }\n\n  @media (max-width: 700px) {\n    .batana-features__grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n</style>\n\n<div class=\"batana-features\">\n  <h2 class=\"batana-features__heading\">Thousands of <br>tired eyes, revived</h2>\n  <p class=\"batana-features__subtext\">\n    In a world full of watery, do-nothing serums, thousands choose the original Vegan Collagen Eye Serum\n  </p>\n\n  <div class=\"batana-features__grid\">\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M8 24 C13 15 19 11 24 11 C29 11 35 15 40 24 C35 33 29 37 24 37 C19 37 13 33 8 24 Z\" stroke=\"#1B3B2F\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/>\n          <circle cx=\"24\" cy=\"24\" r=\"6\" fill=\"#E7A93C\" opacity=\"0.35\" stroke=\"#1B3B2F\" stroke-width=\"1.2\"/>\n          <circle cx=\"24\" cy=\"24\" r=\"2\" fill=\"#1B3B2F\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">100% Vegan Collagen</h3>\n      <p class=\"batana-features__desc\">Plant-derived, low-molecular-weight collagen built to actually absorb.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M13 30 C13 30 15 21 24 21 C33 21 35 30 35 30\" stroke=\"#1B3B2F\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          <path d=\"M16 34 C16 34 19 30 24 30 C29 30 32 34 32 34\" stroke=\"#1B3B2F\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\"0.6\"/>\n          <circle cx=\"18\" cy=\"19\" r=\"1\" fill=\"#E7A93C\"/>\n          <circle cx=\"30\" cy=\"19\" r=\"1\" fill=\"#E7A93C\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Fades Dark Circles</h3>\n      <p class=\"batana-features__desc\">Brightening peptides target shadows and uneven under-eye tone.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M24 12 L26 20 L34 22 L26 24 L24 32 L22 24 L14 22 L22 20 Z\" fill=\"#E7A93C\" stroke=\"#1B3B2F\" stroke-width=\"1.2\" stroke-linejoin=\"round\"/>\n          <path d=\"M33 28 L34 32 L38 33 L34 34 L33 38 L32 34 L28 33 L32 32 Z\" fill=\"#EDE7D6\" stroke=\"#1B3B2F\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Smooths Fine Lines</h3>\n      <p class=\"batana-features__desc\">5-peptide complex firms and softens crow's feet from the first weeks.</p>\n    </div>\n\n    <div class=\"batana-features__item\">\n      <div class=\"batana-features__badge\">\n        <svg class=\"batana-features__icon\" viewBox=\"0 0 48 48\" fill=\"none\">\n          <path d=\"M24 12 C31 12 36 17 36 24 C36 31 31 36 24 36 C17 36 12 31 12 24 C12 17 17 12 24 12 Z\" stroke=\"#1B3B2F\" stroke-width=\"1.4\"/>\n          <path d=\"M18 24 C18 24 20 18 24 18 C28 18 26 26 24 30 C22 34 18 30 18 24 Z\" fill=\"#E7A93C\" opacity=\"0.5\" stroke=\"#1B3B2F\" stroke-width=\"1.2\"/>\n          <path d=\"M24 18 L24 30\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n        </svg>\n      </div>\n      <h3 class=\"batana-features__title\">Lightweight &amp; Absorbent</h3>\n      <p class=\"batana-features__desc\">Triple hyaluronic acid hydrates deeply without greasiness or tugging.</p>\n    </div>\n  </div>\n</div>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
