      "settings": {
        "custom_liquid": "<style>\n  .batana-stats {\n    background-color: #FBF8ED;\n    padding: clamp(32px, 6vw, 72px) clamp(20px, 6vw, 56px);\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    font-family: Georgia, 'Times New Roman', serif;\n    text-align: center;\n  }\n\n  .batana-stats * {\n    box-sizing: border-box;\n  }\n\n  .batana-stats__heading {\n    font-size: clamp(28px, 5.5vw, 48px);\n    line-height: 1.2;\n    color: #1B3B2F;\n    margin: 0 0 clamp(16px, 3vw, 24px) 0;\n    font-weight: 400;\n  }\n\n  .batana-stats__heading em {\n    font-style: italic;\n  }\n\n  .batana-stats__subtext {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(14px, 2.2vw, 18px);\n    line-height: 1.6;\n    color: #2b2b28;\n    max-width: 680px;\n    margin: 0 auto clamp(36px, 6vw, 64px) auto;\n  }\n\n  .batana-stats__grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: clamp(24px, 4vw, 48px);\n    text-align: left;\n  }\n\n  .batana-stats__item {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .batana-stats__top {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 10px;\n  }\n\n  .batana-stats__percent {\n    font-size: clamp(36px, 7vw, 56px);\n    color: #1B3B2F;\n    line-height: 1;\n    font-weight: 400;\n  }\n\n  .batana-stats__jar {\n    flex: 0 0 auto;\n  }\n\n  .batana-stats__bar {\n    height: clamp(60px, 9vw, 90px);\n    border-radius: 4px;\n    background-color: #E4D3AE;\n    background-image: repeating-linear-gradient(\n      -45deg,\n      #D8C093 0,\n      #D8C093 2px,\n      transparent 2px,\n      transparent 8px\n    );\n    margin-bottom: clamp(14px, 2.5vw, 20px);\n  }\n\n  .batana-stats__desc {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: clamp(13px, 2vw, 15px);\n    line-height: 1.5;\n    color: #2b2b28;\n    margin: 0;\n  }\n\n  .batana-stats__desc strong {\n    font-weight: 700;\n  }\n\n  @media (max-width: 700px) {\n    .batana-stats__grid {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n  }\n</style>\n\n<div class=\"batana-stats\">\n  <h2 class=\"batana-stats__heading\">Backed by <em>Testing</em>,<br>Not Just Promises.</h2>\n  <p class=\"batana-stats__subtext\">\n    Every batch of our eye serum is put through clinical testing to confirm real results. While others rely on filters, we rely on data&mdash;and the results speak for themselves.\n  </p>\n\n  <div class=\"batana-stats__grid\">\n    <div class=\"batana-stats__item\">\n      <div class=\"batana-stats__top\">\n        <span class=\"batana-stats__percent\">43%</span>\n        <svg class=\"batana-stats__jar\" width=\"52\" height=\"60\" viewBox=\"0 0 52 60\" fill=\"none\">\n          <rect x=\"22\" y=\"2\" width=\"8\" height=\"6\" rx=\"1\" fill=\"#3B2410\"/>\n          <rect x=\"20\" y=\"8\" width=\"12\" height=\"6\" rx=\"1\" fill=\"#5A3A1E\"/>\n          <path d=\"M18 14 L34 14 L36 22 L36 54 C36 56.2 34.2 58 32 58 L20 58 C17.8 58 16 56.2 16 54 L16 22 Z\" fill=\"#EAF3F1\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <rect x=\"16\" y=\"30\" width=\"20\" height=\"18\" fill=\"#8FD8CC\"/>\n          <text x=\"26\" y=\"38\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"4.2\" font-weight=\"700\" fill=\"#1B3B2F\">EYE</text>\n          <text x=\"26\" y=\"43\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3.6\" fill=\"#1B3B2F\">SERUM</text>\n          <rect x=\"18\" y=\"48\" width=\"16\" height=\"5\" fill=\"#F2A03D\"/>\n          <text x=\"26\" y=\"52\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3\" font-weight=\"700\" fill=\"#3B2410\">VEGAN</text>\n        </svg>\n      </div>\n      <div class=\"batana-stats__bar\"></div>\n      <p class=\"batana-stats__desc\"><strong>43%</strong> saw fewer, shorter wrinkles in just 3 days</p>\n    </div>\n\n    <div class=\"batana-stats__item\">\n      <div class=\"batana-stats__top\">\n        <span class=\"batana-stats__percent\">67%</span>\n        <svg class=\"batana-stats__jar\" width=\"52\" height=\"60\" viewBox=\"0 0 52 60\" fill=\"none\">\n          <rect x=\"22\" y=\"2\" width=\"8\" height=\"6\" rx=\"1\" fill=\"#3B2410\"/>\n          <rect x=\"20\" y=\"8\" width=\"12\" height=\"6\" rx=\"1\" fill=\"#5A3A1E\"/>\n          <path d=\"M18 14 L34 14 L36 22 L36 54 C36 56.2 34.2 58 32 58 L20 58 C17.8 58 16 56.2 16 54 L16 22 Z\" fill=\"#EAF3F1\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <rect x=\"16\" y=\"30\" width=\"20\" height=\"18\" fill=\"#8FD8CC\"/>\n          <text x=\"26\" y=\"38\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"4.2\" font-weight=\"700\" fill=\"#1B3B2F\">EYE</text>\n          <text x=\"26\" y=\"43\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3.6\" fill=\"#1B3B2F\">SERUM</text>\n          <rect x=\"18\" y=\"48\" width=\"16\" height=\"5\" fill=\"#F2A03D\"/>\n          <text x=\"26\" y=\"52\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3\" font-weight=\"700\" fill=\"#3B2410\">VEGAN</text>\n        </svg>\n      </div>\n      <div class=\"batana-stats__bar\"></div>\n      <p class=\"batana-stats__desc\"><strong>67%</strong> improvement in wrinkle depth after 2 weeks</p>\n    </div>\n\n    <div class=\"batana-stats__item\">\n      <div class=\"batana-stats__top\">\n        <span class=\"batana-stats__percent\">90%</span>\n        <svg class=\"batana-stats__jar\" width=\"52\" height=\"60\" viewBox=\"0 0 52 60\" fill=\"none\">\n          <rect x=\"22\" y=\"2\" width=\"8\" height=\"6\" rx=\"1\" fill=\"#3B2410\"/>\n          <rect x=\"20\" y=\"8\" width=\"12\" height=\"6\" rx=\"1\" fill=\"#5A3A1E\"/>\n          <path d=\"M18 14 L34 14 L36 22 L36 54 C36 56.2 34.2 58 32 58 L20 58 C17.8 58 16 56.2 16 54 L16 22 Z\" fill=\"#EAF3F1\" stroke=\"#1B3B2F\" stroke-width=\"1\"/>\n          <rect x=\"16\" y=\"30\" width=\"20\" height=\"18\" fill=\"#8FD8CC\"/>\n          <text x=\"26\" y=\"38\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"4.2\" font-weight=\"700\" fill=\"#1B3B2F\">EYE</text>\n          <text x=\"26\" y=\"43\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3.6\" fill=\"#1B3B2F\">SERUM</text>\n          <rect x=\"18\" y=\"48\" width=\"16\" height=\"5\" fill=\"#F2A03D\"/>\n          <text x=\"26\" y=\"52\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-size=\"3\" font-weight=\"700\" fill=\"#3B2410\">VEGAN</text>\n        </svg>\n      </div>\n      <div class=\"batana-stats__bar\"></div>\n      <p class=\"batana-stats__desc\"><strong>90%</strong> said their under-eye area looked more hydrated &amp; refreshed</p>\n    </div>\n  </div>\n</div>",
