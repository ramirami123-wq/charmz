      "settings": {
        "custom_liquid": "<style>\n  .stats-section {\n    display: flex;\n    align-items: center;\n    gap: 60px;\n    max-width: 1100px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 40px 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n  }\n  .stats-bars {\n    flex: 1 1 480px;\n    min-width: 280px;\n  }\n  .stats-bar-row {\n    margin-bottom: 28px;\n  }\n  .stats-bar-outer {\n    position: relative;\n    height: 68px;\n    border: 1px solid #d9cefa;\n    border-radius: 34px;\n    overflow: hidden;\n    background: #f8f5fe;\n  }\n  .stats-bar-fill {\n    position: absolute;\n    top: 0;\n    left: 0;\n    height: 100%;\n    background: linear-gradient(90deg, #9b84f0 0%, #7B5FE8 100%);\n    border-radius: 34px 0 0 34px;\n    display: flex;\n    align-items: center;\n    padding-left: 24px;\n    box-sizing: border-box;\n  }\n  .stats-bar-fill span {\n    font-size: clamp(28px, 5vw, 40px);\n    font-weight: 400;\n    color: #fff;\n  }\n  .stats-bar-label {\n    margin-top: 12px;\n    font-size: clamp(14px, 2vw, 16px);\n    line-height: 1.4;\n    color: #1a1a1a;\n    text-transform: uppercase;\n  }\n  .stats-bar-label b {\n    font-weight: 700;\n    color: #7B5FE8;\n  }\n  .stats-text {\n    flex: 1 1 320px;\n    min-width: 260px;\n  }\n  .stats-text h2 {\n    font-size: clamp(28px, 4vw, 38px);\n    font-weight: 500;\n    color: #1a1a1a;\n    line-height: 1.2;\n    margin: 0 0 20px;\n  }\n  .stats-text p {\n    font-size: clamp(15px, 2vw, 17px);\n    line-height: 1.6;\n    color: #444;\n    margin: 0;\n  }\n  @media (max-width: 800px) {\n    .stats-section {\n      flex-direction: column;\n      gap: 32px;\n    }\n    .stats-bar-outer {\n      height: 56px;\n    }\n    .stats-bar-fill {\n      padding-left: 18px;\n    }\n  }\n</style>\n\n<div class=\"stats-section\">\n  <div class=\"stats-bars\">\n\n    <div class=\"stats-bar-row\">\n      <div class=\"stats-bar-outer\">\n        <div class=\"stats-bar-fill\" style=\"width: 98%;\">\n          <span>98%</span>\n        </div>\n      </div>\n      <div class=\"stats-bar-label\">Of reviewers rated it <b>4 or 5 stars</b></div>\n    </div>\n\n    <div class=\"stats-bar-row\">\n      <div class=\"stats-bar-outer\">\n        <div class=\"stats-bar-fill\" style=\"width: 92%;\">\n          <span>92%</span>\n        </div>\n      </div>\n      <div class=\"stats-bar-label\">Said it stays <b>crease-free all day</b></div>\n    </div>\n\n    <div class=\"stats-bar-row\">\n      <div class=\"stats-bar-outer\">\n        <div class=\"stats-bar-fill\" style=\"width: 87%;\">\n          <span>87%</span>\n        </div>\n      </div>\n      <div class=\"stats-bar-label\">Gave it a <b>perfect 5-star</b> rating</div>\n    </div>\n\n  </div>\n\n  <div class=\"stats-text\">\n    <h2>Brighter Eyes From the Very First Use</h2>\n    <p>Over 2,300 women have reviewed EyeCorrect+. No more looking tired, no more grey concealer, no more creasing, just fresh, rested eyes in seconds.</p>\n  </div>\n</div>",
