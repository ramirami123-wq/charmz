    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .ec-reviews {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 40px 16px;\n    box-sizing: border-box;\n    color: #1a1a1a;\n  }\n  .ec-reviews * { box-sizing: border-box; }\n\n  .ec-reviews__head {\n    text-align: center;\n    margin-bottom: 32px;\n  }\n  .ec-reviews__title {\n    font-size: clamp(24px, 4vw, 34px);\n    font-weight: 700;\n    margin: 0 0 12px;\n  }\n  .ec-reviews__score {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 16px;\n    color: #555;\n  }\n  .ec-reviews__score strong {\n    font-size: 28px;\n    color: #1a1a1a;\n  }\n  .ec-stars {\n    color: #7B5FE8;\n    letter-spacing: 2px;\n    font-size: 18px;\n  }\n\n  .ec-reviews__bars {\n    max-width: 360px;\n    margin: 20px auto 0;\n  }\n  .ec-bar {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 13px;\n    color: #555;\n    margin: 6px 0;\n  }\n  .ec-bar__label { width: 28px; text-align: right; }\n  .ec-bar__track {\n    flex: 1;\n    height: 8px;\n    background: #eee9fb;\n    border-radius: 99px;\n    overflow: hidden;\n  }\n  .ec-bar__fill {\n    height: 100%;\n    background: #7B5FE8;\n    border-radius: 99px;\n  }\n  .ec-bar__count { width: 40px; }\n\n  .ec-reviews__grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 20px;\n  }\n  .ec-card {\n    background: #f8f5fe;\n    border: 1px solid #ebe4fb;\n    border-radius: 14px;\n    padding: 22px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .ec-card__title {\n    font-size: 17px;\n    font-weight: 700;\n    margin: 0;\n  }\n  .ec-card__text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #444;\n    margin: 0;\n    flex: 1;\n  }\n  .ec-card__author {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 14px;\n    font-weight: 700;\n  }\n  .ec-card__avatar {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #7B5FE8;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n  }\n  .ec-card__badge {\n    font-weight: 400;\n    font-size: 12px;\n    color: #7B5FE8;\n  }\n\n  @media (max-width: 700px) {\n    .ec-reviews__grid { grid-template-columns: 1fr; }\n    .ec-card { padding: 18px; }\n  }\n</style>\n\n<section class=\"ec-reviews\">\n  <div class=\"ec-reviews__head\">\n    <h2 class=\"ec-reviews__title\">Real Women. Real Results.</h2>\n    <div class=\"ec-reviews__score\">\n      <strong>4.8</strong>\n      <span class=\"ec-stars\">★★★★★</span>\n      <span>Based on 2,396 reviews</span>\n    </div>\n\n    <div class=\"ec-reviews__bars\">\n      <div class=\"ec-bar\"><span class=\"ec-bar__label\">5★</span><div class=\"ec-bar__track\"><div class=\"ec-bar__fill\" style=\"width:87%\"></div></div><span class=\"ec-bar__count\">2097</span></div>\n      <div class=\"ec-bar\"><span class=\"ec-bar__label\">4★</span><div class=\"ec-bar__track\"><div class=\"ec-bar__fill\" style=\"width:11%\"></div></div><span class=\"ec-bar__count\">267</span></div>\n      <div class=\"ec-bar\"><span class=\"ec-bar__label\">3★</span><div class=\"ec-bar__track\"><div class=\"ec-bar__fill\" style=\"width:0.5%\"></div></div><span class=\"ec-bar__count\">3</span></div>\n      <div class=\"ec-bar\"><span class=\"ec-bar__label\">2★</span><div class=\"ec-bar__track\"><div class=\"ec-bar__fill\" style=\"width:0.5%\"></div></div><span class=\"ec-bar__count\">9</span></div>\n      <div class=\"ec-bar\"><span class=\"ec-bar__label\">1★</span><div class=\"ec-bar__track\"><div class=\"ec-bar__fill\" style=\"width:1%\"></div></div><span class=\"ec-bar__count\">31</span></div>\n    </div>\n  </div>\n\n  <div class=\"ec-reviews__grid\">\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">Great product!</h3>\n      <p class=\"ec-card__text\">This product really works. It goes on smoothly and brightens the under eye beautifully. I'm 71 and have tried a lot of products. This one is great. I sometimes use it by itself or under my concealer. Although by using this product you'll need a lot less concealer.</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">G</span>Gloria G. <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">Unexpectedly loved it</h3>\n      <p class=\"ec-card__text\">I really thought this was going to be cakey and enhance everything I wanted to hide, but I was surprised by how sheer and light it went on my skin. Even right under my eyes. And it didn't even make me look like a raccoon, which I was really afraid of. Good product for mature ladies!!</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">L</span>Lynne <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">Wow</h3>\n      <p class=\"ec-card__text\">Excellent! I have tried everything and this is the only thing that actually makes a difference.</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">J</span>Joyce <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">Under eye corrector</h3>\n      <p class=\"ec-card__text\">Absolutely fantastic product. Was amazed with the first use, covers blackness in corners of eyes, really lifts the eye &amp; brightens lids &amp; under eyes. Minimal amount of application.</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">S</span>Susan B. <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">The pink disappears</h3>\n      <p class=\"ec-card__text\">I was surprised to see that it's pink! But after applying concealer over it, the pink seemed to disappear as well as much of the darkness under my eyes.</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">L</span>Lori M. <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n\n    <div class=\"ec-card\">\n      <span class=\"ec-stars\">★★★★★</span>\n      <h3 class=\"ec-card__title\">Eye brightener that works</h3>\n      <p class=\"ec-card__text\">I was skeptical but it really does cover nicely and doesn't flake.</p>\n      <div class=\"ec-card__author\"><span class=\"ec-card__avatar\">A</span>Amy C. <span class=\"ec-card__badge\">✓ Verified Buyer</span></div>\n    </div>\n  </div>\n</section>",
