    "custom_liquid_pCKbAn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Jolie – Related products with quick add (Custom Liquid block, product page)\n  Edit the settings below, nothing else needs changing.\n{%- endcomment -%}\n{%- liquid\n  assign rp_heading = 'You may also like'\n  assign rp_limit = 4\n  assign rp_collection = 'cosmetics'\n  assign rp_add_label = 'Add to cart'\n  assign rp_options_label = 'Choose options'\n\n  assign rp_source = collections[rp_collection]\n  assign rp_count = 0\n-%}\n\n{%- capture rp_cards -%}\n  {%- for p in rp_source.products -%}\n    {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}\n    {%- if rp_count >= rp_limit -%}{%- break -%}{%- endif -%}\n    {%- assign rp_count = rp_count | plus: 1 -%}\n    <div class=\"jrp__card\">\n      <a class=\"jrp__link\" href=\"{{ p.url }}\">\n        <div class=\"jrp__media\">\n          {%- if p.featured_image -%}\n            {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 25vw, 45vw', alt: p.title, class: 'jrp__img' }}\n            {%- if p.images[1] -%}\n              {{ p.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 25vw, 45vw', alt: '', class: 'jrp__img jrp__img--alt' }}\n            {%- endif -%}\n          {%- endif -%}\n          {%- if p.compare_at_price > p.price -%}\n            <span class=\"jrp__badge\">Sale</span>\n          {%- endif -%}\n        </div>\n        <p class=\"jrp__title\">{{ p.title }}</p>\n        <p class=\"jrp__price\">\n          {%- if p.price_varies -%}From {% endif -%}\n          <span>{{ p.price | money }}</span>\n          {%- if p.compare_at_price > p.price -%}\n            <s>{{ p.compare_at_price | money }}</s>\n          {%- endif -%}\n        </p>\n      </a>\n      {%- if p.has_only_default_variant -%}\n        <button type=\"button\" class=\"jrp__btn\" data-jrp-add=\"{{ p.selected_or_first_available_variant.id }}\">{{ rp_add_label }}</button>\n      {%- else -%}\n        <a class=\"jrp__btn\" href=\"{{ p.url }}\">{{ rp_options_label }}</a>\n      {%- endif -%}\n    </div>\n  {%- endfor -%}\n{%- endcapture -%}\n\n{%- if rp_count > 0 -%}\n<section class=\"jrp\" aria-label=\"{{ rp_heading | escape }}\">\n  <h2 class=\"jrp__heading\">{{ rp_heading }}</h2>\n  <div class=\"jrp__grid\">{{ rp_cards }}</div>\n  <p class=\"jrp__status\" role=\"status\" aria-live=\"polite\"></p>\n</section>\n\n<style>\n  .jrp { margin: 3rem 0 1rem; }\n  .jrp__heading { margin: 0 0 1.25rem; font-size: 1.4em; font-weight: 500; }\n  .jrp__grid {\n    display: grid; gap: 1rem;\n    grid-auto-flow: column; grid-auto-columns: 45%;\n    overflow-x: auto; scroll-snap-type: x mandatory;\n    padding-bottom: .5rem; -webkit-overflow-scrolling: touch;\n  }\n  .jrp__card { scroll-snap-align: start; display: flex; flex-direction: column; }\n  .jrp__link { color: inherit; text-decoration: none; display: block; flex: 1; }\n  .jrp__link:focus-visible, .jrp__btn:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }\n  .jrp__media {\n    position: relative; aspect-ratio: 3 / 4; overflow: hidden;\n    background: rgba(127,127,127,.08); border-radius: 4px;\n  }\n  .jrp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n  .jrp__img--alt { opacity: 0; transition: opacity .35s ease; }\n  .jrp__link:hover .jrp__img--alt { opacity: 1; }\n  .jrp__badge {\n    position: absolute; top: .6rem; left: .6rem;\n    background: #fff; color: #000; font-size: .75em; padding: .2rem .55rem; border-radius: 2px;\n  }\n  .jrp__title { margin: .7rem 0 .2rem; font-size: .95em; line-height: 1.35; }\n  .jrp__price { margin: 0 0 .7rem; font-size: .9em; opacity: .85; }\n  .jrp__price s { margin-left: .4rem; opacity: .6; }\n  .jrp__btn {\n    display: block; width: 100%; box-sizing: border-box;\n    padding: .7rem .5rem; font: inherit; font-size: .85em; text-align: center;\n    color: inherit; background: transparent; text-decoration: none;\n    border: 1px solid currentColor; border-radius: 4px; cursor: pointer;\n    transition: background-color .2s ease, color .2s ease;\n  }\n  .jrp__btn:hover { background: rgba(127,127,127,.15); }\n  .jrp__btn[disabled] { opacity: .6; cursor: default; }\n  .jrp__btn.is-added { background: #1f7a4d; border-color: #1f7a4d; color: #fff; }\n  .jrp__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\n  @media (min-width: 750px) {\n    .jrp__grid { grid-auto-flow: row; grid-template-columns: repeat({{ rp_limit }}, 1fr); overflow: visible; }\n  }\n  @media (prefers-reduced-motion: reduce) { .jrp__img--alt, .jrp__btn { transition: none; } }\n</style>\n\n<script>\n(function () {\n  if (window.__jrpQuickAdd) return;\n  window.__jrpQuickAdd = true;\n  var addUrl = '{{ routes.cart_add_url }}.js';\n  var cartUrl = '{{ routes.cart_url }}.js';\n  var addLabel = {{ rp_add_label | json }};\n\n  function updateCartCount() {\n    fetch(cartUrl).then(function (r) { return r.json(); }).then(function (cart) {\n      document.querySelectorAll('.cart-count-bubble span[aria-hidden], [data-cart-count], .cart-count, .js-cart-count')\n        .forEach(function (el) { el.textContent = cart.item_count; });\n      document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart, bubbles: true }));\n      document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart, bubbles: true }));\n    }).catch(function () {});\n  }\n\n  document.addEventListener('click', function (e) {\n    var btn = e.target.closest('[data-jrp-add]');\n    if (!btn) return;\n    e.preventDefault();\n    var status = btn.closest('.jrp').querySelector('.jrp__status');\n    btn.disabled = true;\n    btn.textContent = 'Adding…';\n\n    fetch(addUrl, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n      body: JSON.stringify({ items: [{ id: Number(btn.dataset.jrpAdd), quantity: 1 }] })\n    })\n    .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })\n    .then(function () {\n      btn.classList.add('is-added');\n      btn.textContent = 'Added';\n      if (status) status.textContent = 'Added to cart';\n      updateCartCount();\n      setTimeout(function () {\n        btn.classList.remove('is-added');\n        btn.textContent = addLabel;\n        btn.disabled = false;\n      }, 2000);\n    })\n    .catch(function (err) {\n      btn.textContent = (err && err.description) ? err.description : 'Could not add, try again';\n      if (status) status.textContent = btn.textContent;\n      setTimeout(function () { btn.textContent = addLabel; btn.disabled = false; }, 2500);\n    });\n  });\n})();\n</script>\n{%- endif -%}",
