      "settings": {
        "custom_liquid": "<style> .yc-hero-split { all: initial; display: block; background: #FAF7F1; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; padding: 2.5rem 1.5rem; box-sizing: border-box; } .yc-hero-split *, .yc-hero-split *::before, .yc-hero-split *::after { box-sizing: border-box; font-family: inherit; } .yc-hero-split .yc-hs-wrap { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; } .yc-hero-split .yc-hs-image { width: 100%; height: 100%; max-height: 620px; object-fit: cover; border-radius: 20px; display: block; } .yc-hero-split .yc-hs-heading { font-family: Georgia, \"Times New Roman\", serif; font-size: 2.4rem; color: #1c1c1c; margin: 0 0 1rem 0; line-height: 1.2; } .yc-hero-split .yc-hs-subheading { font-weight: 700; font-size: 1.1rem; color: #1c1c1c; margin: 0 0 1rem 0; } .yc-hero-split .yc-hs-paragraph { font-size: 1.05rem; line-height: 1.65; color: #3a3733; margin: 0 0 1.5rem 0; } .yc-hero-split .yc-hs-pills { display: flex; flex-wrap: wrap; gap: 0.75rem; } .yc-hero-split .yc-hs-pill { display: inline-flex; align-items: center; gap: 0.4rem; background: #F0E4D6; border: 1px solid #E0CBAE; color: #3F5B4A; padding: 0.55rem 1.1rem; border-radius: 999px; font-size: 0.95rem; white-space: nowrap; } .yc-hero-split .yc-hs-pill svg { width: 14px; height: 14px; flex-shrink: 0; } .yc-hero-split .yc-hs-note { max-width: 1200px; margin: 1.5rem auto 0 auto; font-size: 0.85rem; color: #6b665e; } /* Tablet: stack, image on top */ @media (max-width: 860px) { .yc-hero-split .yc-hs-wrap { grid-template-columns: 1fr; gap: 1.75rem; } .yc-hero-split .yc-hs-image { max-height: 420px; } } /* Mobile: bigger, comfortable text */ @media (max-width: 480px) { .yc-hero-split { padding: 1.75rem 1rem; } .yc-hero-split .yc-hs-image { max-height: 340px; border-radius: 16px; } .yc-hero-split .yc-hs-heading { font-size: 2rem; } .yc-hero-split .yc-hs-subheading { font-size: 1.25rem; } .yc-hero-split .yc-hs-paragraph { font-size: 1.2rem; line-height: 1.65; } .yc-hero-split .yc-hs-pill { font-size: 1.1rem; padding: 0.6rem 1.15rem; } .yc-hero-split .yc-hs-pill svg { width: 16px; height: 16px; } .yc-hero-split .yc-hs-note { font-size: 0.95rem; } } </style> <div class=\"yc-hero-split\"> <div class=\"yc-hs-wrap\"> <img class=\"yc-hs-image\" src=\"https://yoracare.com/cdn/shop/files/hf_20260417_165748_84847bda-55c6-4379-8191-b358cae706e6.webp?v=1776445985&width=1200\" alt=\"Man running fingers through healthy hair\"> <div class=\"yc-hs-content\"> <h2 class=\"yc-hs-heading\">Healthier hair starts with a healthier scalp.</h2> <p class=\"yc-hs-subheading\">Made for all hair types, for men and women.</p> <p class=\"yc-hs-paragraph\"> PDRN is a skincare ingredient from Korean beauty, known for helping calm and support the skin. Our PDRN Scalp Serum brings it to your scalp in a simple 60-second step. Apply it after washing, massage it in, and give your scalp the care it needs to support stronger, fuller-looking hair over time. </p> <div class=\"yc-hs-pills\"> <span class=\"yc-hs-pill\"> <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M4 12.5l5 5L20 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> </svg> Made with PDRN </span> <span class=\"yc-hs-pill\"> <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M4 12.5l5 5L20 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> </svg> Easy 60-second routine </span> </div> </div> </div> </div>",
