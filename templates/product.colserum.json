    "custom_liquid_cqKTNy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"jlr-reviews-section\">\n  <h2 class=\"jlr-heading\">\n    Loved by <span class=\"jlr-highlight\">12,000+ customers</span>\n  </h2>\n \n\n  <div class=\"jlr-grid\">\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Maya, 29</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"I've been using the collagen serum every night for about six weeks and my skin feels so much plumper. The fine lines around my eyes are softer and my makeup sits better in the morning.\"\n      </p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Rania, 41</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"Beirut summers usually leave my skin dull and dehydrated, but this serum absorbs fast and never feels sticky. My friends keep asking what I changed in my routine!\"\n      </p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Karim, 35</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"My wife got me to try it and honestly I'm hooked. It's lightweight, has no strong smell, and my skin looks less tired even after long shifts. Two bottles in and still going.\"\n      </p>\n    </div>\n\n    <div class=\"jlr-card\">\n      <div class=\"jlr-header\">\n        <span class=\"jlr-name\">Nour, 24</span>\n        <span class=\"jlr-stars\">★★★★★</span>\n      </div>\n      <p class=\"jlr-text\">\n        \"I have sensitive skin and most serums break me out, but this one has been gentle from day one. My skin is glowy, smoother, and the redness on my cheeks has calmed down a lot.\"\n      </p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .jlr-reviews-section {\n    font-family: Arial, Helvetica, sans-serif;\n    padding: 20px;\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 100vw;\n    overflow-x: hidden;\n  }\n\n  .jlr-reviews-section * {\n    box-sizing: border-box;\n  }\n\n  .jlr-heading {\n    text-align: center;\n    font-size: 32px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 10px 0;\n  }\n\n  .jlr-disclaimer {\n    text-align: center;\n    font-size: 12px;\n    color: #777;\n    margin: 0 0 24px 0;\n    font-style: italic;\n  }\n\n  .jlr-highlight {\n    background: linear-gradient(135deg, #4fb3df 0%, #87ceeb 100%);\n    color: #fff;\n    padding: 4px 12px;\n    border-radius: 4px;\n    white-space: nowrap;\n  }\n\n  .jlr-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 16px;\n    max-width: 1400px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .jlr-card {\n    background: linear-gradient(180deg, #eaf7fd 0%, #ffffff 100%);\n    border: 1px solid #d3eefa;\n    border-radius: 10px;\n    padding: 20px;\n    min-width: 0;\n  }\n\n  .jlr-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 12px;\n    flex-wrap: wrap;\n  }\n\n  .jlr-name {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .jlr-stars {\n    color: #4fb3df;\n    font-size: 14px;\n    letter-spacing: 1px;\n  }\n\n  .jlr-text {\n    font-size: 14px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0;\n    overflow-wrap: break-word;\n    word-break: break-word;\n  }\n\n  @media (max-width: 900px) {\n    .jlr-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 480px) {\n    .jlr-heading {\n      font-size: 22px;\n      margin-bottom: 8px;\n    }\n\n    .jlr-disclaimer {\n      margin-bottom: 18px;\n    }\n\n    .jlr-grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 12px;\n    }\n\n    .jlr-card {\n      padding: 16px;\n    }\n\n    .jlr-name {\n      font-size: 13px;\n    }\n\n    .jlr-text {\n      font-size: 12.5px;\n    }\n  }\n</style>",
