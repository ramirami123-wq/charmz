        "custom_liquid_H9DXEK": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"skin-benefits-block\">\n  <p class=\"benefits-heading\">\n    Those deeper lines and that tired, deflated look aren't only age, they're thirst: Korean collagen floods mature skin with the moisture it lost, so your face looks plumper, firmer and rested again, from the very first drop.\n  </p>\n\n  <div class=\"benefits-grid\">\n    <!-- Plump / hydration -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11z\"/>\n          <path d=\"M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Plump, bouncy skin from the first use</p>\n    </div>\n\n    <!-- Fine lines smoothing -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M3 8c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0\"/>\n          <path d=\"M3 13c2-1 4-1 6 0s4 1 6 0 4-1 6 0\"/>\n          <path d=\"M3 18h18\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Fine lines &amp; wrinkles look visibly smoother</p>\n    </div>\n\n    <!-- Firmness / lift -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 20V5\"/>\n          <path d=\"M7 10l5-5 5 5\"/>\n          <path d=\"M5 20h14\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Firmer-feeling skin that bounces back</p>\n    </div>\n\n    <!-- Glow -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z\"/>\n          <path d=\"M19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Dewy glass-skin glow, never greasy or sticky</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .skin-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n\n  .benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n\n  .benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n\n  .benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, #87ceeb 0%, #ffffff 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n\n  @media (max-width: 480px) {\n    .benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n\n    .benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n\n    .benefit-item {\n      gap: 10px;\n    }\n\n    .benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n\n    .benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n    }\n\n    .benefit-text {\n      font-size: 11.5px;\n    }\n  }\n</style>"
