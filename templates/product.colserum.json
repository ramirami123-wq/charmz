        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why Jolie?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M20 8h20v10c4 4 6 10 6 18v42c0 3-2 5-5 5H19c-3 0-5-2-5-5V36c0-8 2-14 6-18V8z\" fill=\"#cfeefb\" stroke=\"#4fb3df\" stroke-width=\"1.5\"/>\n          <rect x=\"20\" y=\"8\" width=\"20\" height=\"8\" fill=\"#cfeefb\" stroke=\"#4fb3df\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"26\" font-size=\"6\" text-anchor=\"middle\" fill=\"#1e4a5c\" font-family=\"Arial\" font-weight=\"700\">JOLIE</text>\n        </svg>\n      </div>\n      <span>Jolie Collagen Serum</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Moisturizers &amp; creams alone</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Where the hydration goes</div>\n      <div class=\"why-row-jolie\">Pulls moisture in and holds it there</div>\n      <div class=\"why-row-other\">Mostly sits on the surface</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Made for mature skin</div>\n      <div class=\"why-row-jolie\">Made for dry, changing 40+ skin</div>\n      <div class=\"why-row-other\">One formula for every age</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Texture</div>\n      <div class=\"why-row-jolie\">Lightweight, absorbs fast, never sticky</div>\n      <div class=\"why-row-other\">Heavy, greasy or pills