    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"results-section\">\n  <h2 class=\"results-heading\">\n    Backed By <span class=\"highlight\">Research</span>\n  </h2>\n  <p class=\"results-note\">\n    Findings from published clinical studies on the individual ingredients, at the doses those studies used. These are not studies of Bloomin gummies.\n  </p>\n\n  <div class=\"results-grid\">\n    <div class=\"result-card\">\n      <p class=\"result-percent\">73%</p>\n      <p class=\"result-title\">drop in menopause symptom scores<br>with shatavari (vs 22.8% on placebo)</p>\n      <p class=\"result-subtext\">Randomized placebo-controlled trial in perimenopausal women, 100 mg/day standardized shatavari extract (2025)</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">6 wks</p>\n      <p class=\"result-title\">for saffron to improve mood<br>and hot flashes</p>\n      <p class=\"result-subtext\">Randomized placebo-controlled trial in postmenopausal women, 30 mg/day saffron</p>\n    </div>\n\n    <div class=\"result-card\">\n      <p class=\"result-percent\">145</p>\n      <p class=\"result-title\">women saw less fatigue, irritability<br>and trouble sleeping with shatavari</p>\n      <p class=\"result-subtext\">12-week randomized placebo-controlled trial in perimenopausal women aged 38–54, 500 mg/day shatavari extract</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .results-section {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n  .results-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 12px 0;\n  }\n\n  .highlight {\n    background: linear-gradient(135deg, #f7b8cf 0%, #fde3ec 55%, #ffffff 100%);\n    color: #1a1a1a;\n    padding: 2px 10px;\n  }\n\n  .results-note {\n    text-align: center;\n    font-size: 13px;\n    line-height: 1.4;\n    color: #555;\n    max-width: 700px;\n    margin: 0 auto 28px auto;\n  }\n\n  .results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n\n  .result-card {\n    background: linear-gradient(160deg, #fde3ec 0%, #ffffff 100%);\n    border: 1px solid #f7cfdd;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  .result-percent {\n    font-size: 64px;\n    font-weight: 800;\n    color: #e0608e;\n    line-height: 1;\n    margin: 0 0 16px 0;\n  }\n\n  .result-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.4;\n    margin: 0 0 10px 0;\n  }\n\n  .result-subtext {\n    font-size: 12px;\n    color: #555;\n    margin: 0;\n  }\n\n  @media (max-width: 900px) {\n    .results-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .results-heading {\n      font-size: 22px;\n      margin-bottom: 10px;\n    }\n\n    .results-note {\n      font-size: 11.5px;\n      margin-bottom: 20px;\n    }\n\n    .result-card {\n      padding: 22px 18px;\n    }\n\n    .result-percent {\n      font-size: 44px;\n      margin-bottom: 10px;\n    }\n\n    .result-title {\n      font-size: 14px;\n    }\n\n    .result-subtext {\n      font-size: 11px;\n    }\n  }\n</style>",
