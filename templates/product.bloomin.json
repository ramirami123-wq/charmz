    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why Bloomin?</h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"14\" y=\"8\" width=\"32\" height=\"12\" rx=\"3\" fill=\"#e0608e\" stroke=\"#a8325e\" stroke-width=\"1.5\"/>\n          <rect x=\"10\" y=\"20\" width=\"40\" height=\"62\" rx=\"8\" fill=\"#fde3ec\" stroke=\"#e48aab\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"48\" font-size=\"7\" text-anchor=\"middle\" fill=\"#a8325e\" font-family=\"Arial\" font-weight=\"700\">BLOOMIN</text>\n          <circle cx=\"22\" cy=\"64\" r=\"4\" fill=\"#f7b8cf\"/>\n          <circle cx=\"32\" cy=\"66\" r=\"4\" fill=\"#e8739c\"/>\n          <circle cx=\"40\" cy=\"62\" r=\"3.5\" fill=\"#f7b8cf\"/>\n        </svg>\n      </div>\n      <span>Bloomin</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"16\" y=\"8\" width=\"28\" height=\"12\" rx=\"2\" fill=\"#333\" stroke=\"#222\" stroke-width=\"1.5\"/>\n          <rect x=\"12\" y=\"20\" width=\"36\" height=\"62\" rx=\"4\" fill=\"#555\" stroke=\"#333\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Diet pills &amp; fat burners</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Works with your hormones</div>\n      <div class=\"why-row-jolie\">Made for women whose bodies changed with their hormones</div>\n      <div class=\"why-row-other\">One-size-fits-all, ignores hormonal shifts</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Energy</div>\n      <div class=\"why-row-jolie\">Stimulant-free, steady energy with no crash</div>\n      <div class=\"why-row-other\">Often caffeine-heavy: jitters, then a crash</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Mood &amp; stress</div>\n      <div class=\"why-row-jolie\">Saffron and shatavari support a calmer, brighter mood</div>\n      <div class=\"why-row-other\">Can leave you wired, anxious or irritable</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Cravings</div>\n      <div class=\"why-row-jolie\">Helps quiet cravings so you feel in control</div>\n      <div class=\"why-row-other\">Relies on willpower, or on suppressing appetite with stimulants</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Routine</div>\n      <div class=\"why-row-jolie\">One gummy a day</div>\n      <div class=\"why-row-other\">Multiple capsules, timed doses</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Honest about pace</div>\n      <div class=\"why-row-jolie\">Feel the shift build week by week</div>\n      <div class=\"why-row-other\">\"Lose it fast\" promises that fizzle</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: linear-gradient(160deg, #fde3ec 0%, #ffffff 100%);\n    border: 1px solid #f7cfdd;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 24px 0;\n  }\n\n  .why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #e0608e;\n    padding-bottom: 12px;\n    margin-bottom: 8px;\n  }\n\n  .why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid #f7cfdd;\n  }\n\n  .why-row-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-row-jolie {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  .why-row-other {\n    font-size: 14px;\n    color: #999;\n  }\n\n  @media (max-width: 700px) {\n    .why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .why-columns-header {\n      display: none;\n    }\n\n    .why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .why-row-label {\n      font-size: 13px;\n    }\n\n    .why-row-jolie::before {\n      content: \"Bloomin: \";\n      font-weight: 700;\n      color: #e0608e;\n    }\n\n    .why-row-other::before {\n      content: \"Others: \";\n      font-weight: 700;\n      color: #999;\n    }\n\n    .why-row-jolie,\n    .why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
