        "custom_liquid_H9DXEK": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"skin-benefits-block\">\n  <p class=\"benefits-heading\">\n    Feel like yourself again: calmer days, steady energy, and cravings that finally loosen their grip, even while your hormones shift. Shatavari, saffron and shilajit in one gummy a day, with no hormones and no stimulants.\n  </p>\n\n  <div class=\"benefits-grid\">\n    <!-- Mood / stress -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n          <circle cx=\"9\" cy=\"10\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <circle cx=\"15\" cy=\"10\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <path d=\"M8.5 14.5c1 1.2 2.2 1.8 3.5 1.8s2.5-0.6 3.5-1.8\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">A calmer, brighter mood, with fewer stress spirals</p>\n    </div>\n\n    <!-- Energy -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M13 2L5 13h6l-1 9 8-11h-6l1-9z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Steady energy all day, with no caffeine and no crash</p>\n    </div>\n\n    <!-- Cravings / appetite -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 7c-1.5-1.5-5-1.5-6.5 1S5 15 7 18c1.2 1.8 3 2 5 1 2 1 3.8 0.8 5-1 2-3 3-7.5 1.5-10S13.5 5.5 12 7z\"/>\n          <path d=\"M12 7c0-2 1-3.5 3-4\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Fewer cravings, so you feel back in control around food</p>\n    </div>\n\n    <!-- Hormonal balance -->\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M5 19c0-8 5-13 14-14-1 9-6 14-14 14z\"/>\n          <path d=\"M5 19l7-7\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Supports hormonal balance through every shift</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .skin-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n\n  .benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n\n  .benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n\n  .benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, #f7b8cf 0%, #fde3ec 55%, #ffffff 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n\n  /* Mobile: sizes bumped +10% from previous mobile version */\n  @media (max-width: 480px) {\n    .benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n\n    .benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n\n    .benefit-item {\n      gap: 10px;\n    }\n\n    .benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n\n    .benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n    }\n\n   