    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/IBRSCustomerResults_cce9a52c-12e8-4ce2-b6f6-30e928b21152.webp?v=1792958451\" alt=\"Hydrating face serum for dry, tired and aging skin\" loading=\"lazy\">\n  </div>\n\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made For <span class=\"highlight\">Dry, Tired &amp; Aging Skin</span>\n    </h2>\n\n    <p class=\"fade-text\">\n      Meet the light serum that gives your skin back the water it's been missing.\n    </p>\n\n    <p class=\"fade-text\">\n      As we get older, our skin holds less water, so fine lines look deeper and skin looks dull. This serum uses hyaluronic acid in small and big sizes, so it works on the top of your skin and soaks in below it too.\n    </p>\n\n    <p class=\"fade-text\">\n      Your skin feels soft and glowy from the first use, and fine lines look smoother over the next few weeks. Use it morning and night, under your cream or makeup.\n    </p>\n\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Fills skin with water</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Smooths fine lines</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #e8c073;\n    padding-top: 20px;\n  }\n\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n\n  .highlight {\n    background: #e8c073;\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n\n  .sparkle {\n    color: #e8a94a;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .fade-highlights {\n      gap: 14px;\n    }\n\n    .highlight-item {\n      font-size: 12.5px;\n    }\n\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
