            "custom_liquid": "<div class=\"skin-benefits-block\">\n  <p class=\"benefits-heading\">\n    Your fine lines look deeper when your skin is dry. This serum soaks in and fills your skin with water, morning and night, so it looks smoother, fuller and brighter every week.\n  </p>\n\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- droplet: hydration -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11z\"/>\n          <path d=\"M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Softer, fuller skin from the first use</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- sparkle: glow -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z\"/>\n          <path d=\"M18 16l.7 1.8L20.5 18.5l-1.8.7L18 21l-.7-1.8-1.8-.7 1.8-.7z\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Glowing skin by morning, smoother lines in 4 weeks</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- smiling face: smoother, brighter skin -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"8\"/>\n          <circle cx=\"9.5\" cy=\"10.5\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <circle cx=\"14.5\" cy=\"10.5\" r=\"0.8\" fill=\"#1a1a1a\" stroke=\"none\"/>\n          <path d=\"M9 14.5c.8 1 2 1.5 3 1.5s2.2-.5 3-1.5\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Brighter, fresher skin that gets better every week</p>\n    </div>\n\n    <div class=\"benefit-item\">\n      <div class=\"benefit-icon\">\n        <!-- shield: gentle -->\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z\"/>\n          <path d=\"M9 12l2 2 4-4\"/>\n        </svg>\n      </div>\n      <p class=\"benefit-text\">Gentle, no perfume, great under makeup</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .skin-benefits-block {\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 700px;\n  }\n\n  .benefits-heading {\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1a1a1a;\n    margin: 0 0 20px 0;\n  }\n\n  .benefits-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 24px;\n  }\n\n  .benefit-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n\n  .benefit-icon {\n    flex-shrink: 0;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: #fbead9;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .benefit-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .benefit-text {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #1a1a1a;\n    font-weight: 600;\n    margin: 0;\n  }\n\n  /* Mobile: sizes bumped +10% from previous mobile version */\n  @media (max-width: 480px) {\n    .benefits-heading {\n      font-size: 12px;\n      margin-bottom: 16px;\n    }\n\n    .benefits-grid {\n      grid-template-columns: 1fr;\n      gap: 13px;\n    }\n\n    .benefit-item {\n      gap: 10px;\n    }\n\n    .benefit-icon {\n      width: 33px;\n      height: 33px;\n    }\n\n    .benefit-icon svg {\n      width: 16.5px;\n      height: 16.5px;\n   