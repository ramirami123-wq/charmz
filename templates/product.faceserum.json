    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"why-section\">\n  <h2 class=\"why-heading\">Why <span class=\"why-highlight\">Jolie?</span></h2>\n\n  <div class=\"why-columns-header\">\n    <div class=\"why-col-label\"></div>\n    <div class=\"why-col-label why-col-product\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <rect x=\"26\" y=\"2\" width=\"8\" height=\"10\" rx=\"3\" fill=\"#1a1a1a\"/>\n          <rect x=\"22\" y=\"11\" width=\"16\" height=\"7\" rx=\"2\" fill=\"#cf9d3f\"/>\n          <path d=\"M16 24c0-4 3-6 6-6h16c3 0 6 2 6 6v54c0 4-3 7-7 7H23c-4 0-7-3-7-7V24z\" fill=\"#f3e3c0\" stroke=\"#cf9d3f\" stroke-width=\"1.5\"/>\n          <text x=\"30\" y=\"52\" font-size=\"7\" text-anchor=\"middle\" fill=\"#5c4a1e\" font-family=\"Arial\" font-weight=\"700\">JOLIE</text>\n        </svg>\n      </div>\n      <span>Jolie</span>\n    </div>\n    <div class=\"why-col-label why-col-other\">\n      <div class=\"product-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 90\">\n          <path d=\"M25 10h10v8l6 6v56c0 3-2 5-5 5H24c-3 0-5-2-5-5V24l6-6v-8z\" fill=\"#bdbdbd\" stroke=\"#8a8a8a\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <span>Regular serums</span>\n    </div>\n  </div>\n\n  <div class=\"why-rows\">\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Hydration depth</div>\n      <div class=\"why-row-jolie\">Multi-weight hyaluronic acid hydrates the surface and deeper layers</div>\n      <div class=\"why-row-other\">Single-weight formulas hydrate one level only</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Benefits per bottle</div>\n      <div class=\"why-row-jolie\">5-in-1: hydrates, plumps, smooths fine lines, evens tone, soothes</div>\n      <div class=\"why-row-other\">Usually targets 1–2 concerns</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Ingredients</div>\n      <div class=\"why-row-jolie\">Tremella mushroom, aloe vera, purslane and hyaluronic acid</div>\n      <div class=\"why-row-other\">Often built around a single hero ingredient</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Texture</div>\n      <div class=\"why-row-jolie\">Thin and light, absorbs in a few minutes</div>\n      <div class=\"why-row-other\">Can feel heavy or greasy, especially in humid weather</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Routine</div>\n      <div class=\"why-row-jolie\">A few drops morning and night, layers under SPF and makeup</div>\n      <div class=\"why-row-other\">A multi-step stack to keep up</div>\n    </div>\n\n    <div class=\"why-row\">\n      <div class=\"why-row-label\">Honest about pace</div>\n      <div class=\"why-row-jolie\">Softer skin from day one, smoother and brighter over 4–8 weeks</div>\n      <div class=\"why-row-other\">\"Overnight results\" promises that fizzle</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .why-section {\n    font-family: Arial, Helvetica, sans-serif;\n    background: #f5f5f4;\n    border-radius: 20px;\n    padding: 40px;\n    max-width: 1000px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .why-section * {\n    box-sizing: border-box;\n  }\n\n  .why-heading {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 28px 0;\n  }\n\n  .why-highlight {\n    background: #cf9d3f;\n    color: #fff;\n    padding: 4px 12px;\n    border-radius: 4px;\n    white-space: nowrap;\n  }\n\n  .why-columns-header {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    align-items: end;\n    border-bottom: 2px solid #1a1a1a;\n    padding-bottom: 12px;\n  }\n\n  .why-col-label {\n    text-align: center;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-col-product {\n    color: #a0782c;\n  }\n\n  .why-col-other {\n    color: #999;\n  }\n\n  .product-icon {\n    width: 40px;\n    height: 60px;\n    margin: 0 auto 8px auto;\n  }\n\n  .product-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .why-rows {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .why-row {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr 1fr;\n    gap: 16px;\n    border-bottom: 1px solid #ddd;\n  }\n\n  .why-row-label,\n  .why-row-jolie,\n  .why-row-other {\n    padding: 18px 8px;\n    font-size: 14px;\n    line-height: 1.45;\n  }\n\n  .why-row-label {\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n\n  .why-row-jolie {\n    color: #1a1a1a;\n    background: #fbf3e2;\n  }\n\n  .why-row-jolie::before {\n    content: \"✓ \";\n    color: #cf9d3f;\n    font-weight: 700;\n  }\n\n  .why-row-other {\n    color: #999;\n  }\n\n  .why-row-other::before {\n    content: \"✕ \";\n    color: #bbb;\n    font-weight: 700;\n  }\n\n  @media (max-width: 700px) {\n    .why-section {\n      padding: 20px;\n      border-radius: 14px;\n    }\n\n    .why-heading {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .why-columns-header {\n      display: none;\n    }\n\n    .why-row {\n      grid-template-columns: 1fr;\n      gap: 6px;\n      padding: 14px 0;\n    }\n\n    .why-row-label,\n    .why-row-jolie,\n    .why-row-other {\n      padding: 0;\n      background: none;\n    }\n\n    .why-row-label {\n      font-size: 13px;\n    }\n\n    .why-row-jolie::before {\n      content: \"✓ Jolie: \";\n    }\n\n    .why-row-other::before {\n      content: \"✕ Others: \";\n    }\n\n    .why-row-jolie,\n    .why-row-other {\n      font-size: 12.5px;\n    }\n  }\n</style>",
        "full_width": false,
