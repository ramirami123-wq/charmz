        "custom_liquid": "<style>\n  .lb-section {\n    max-width: 1200px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 40px 16px;\n    font-family: Arial, Helvetica, sans-serif;\n    box-sizing: border-box;\n    position: relative;\n  }\n  .lb-title-wrap {\n    text-align: center;\n    margin-bottom: 30px;\n    position: relative;\n  }\n  .lb-title {\n    font-size: clamp(26px, 4.5vw, 38px);\n    font-weight: 800;\n    color: #1a1a1a;\n    position: relative;\n    display: inline-block;\n  }\n  .lb-circle {\n    position: absolute;\n    top: -14px;\n    left: 50%;\n    transform: translateX(-6%);\n    width: 46%;\n    min-width: 130px;\n    pointer-events: none;\n  }\n  .lb-circle svg {\n    width: 100%;\n    height: auto;\n    display: block;\n    color: #4a90e2;\n  }\n  .lb-carousel-wrap {\n    position: relative;\n  }\n  .lb-track-outer {\n    overflow: hidden;\n  }\n  .lb-track {\n    display: flex;\n    gap: 16px;\n    transition: transform 0.4s ease;\n  }\n  .lb-card {\n    flex: 0 0 calc(33.333% - 11px);\n    min-width: 220px;\n    background: #fff;\n    border-radius: 14px;\n    overflow: hidden;\n    box-shadow: 0 1px 4px rgba(0,0,0,0.08);\n  }\n  .lb-avatar {\n    width: 100%;\n    aspect-ratio: 2.4 / 1;\n    background: linear-gradient(135deg, #dceaf9, #bcd9f5);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n  .lb-avatar img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n  }\n  .lb-avatar-circle {\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background: #4a90e2;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    font-weight: 700;\n  }\n  .lb-card-body {\n    padding: 14px 16px 18px;\n  }\n  .lb-card-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 6px;\n  }\n  .lb-name {\n    font-size: clamp(14px, 1.