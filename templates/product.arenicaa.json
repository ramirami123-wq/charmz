      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n*{box-sizing:border-box;margin:0;padding:0}\n.sec{padding:2rem 0;border-bottom:0.5px solid #f0e0e8}\n\n.trust-bar{display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:12px;padding:1.2rem 0}\n.trust-item{display:flex;align-items:center;gap:8px;font-size:13px;color:#444}\n.trust-item span.ic{font-size:18px}\n\n.how-title{text-align:center;font-size:17px;font-weight:500;color:#111;margin-bottom:1.5rem}\n.steps{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.step{flex:1;min-width:120px;text-align:center;padding:1rem}\n.step-num{width:36px;height:36px;border-radius:50%;background:#7B2D5E;color:#fff;font-size:14px;font-weight:500;display:flex;align-items:center;justify-content:center;margin:0 auto 10px}\n.step-title{font-size:13px;font-weight:500;color:#111;margin-bottom:4px}\n.step-desc{font-size:12px;color:#888;line-height:1.5}\n\n.rev-title{text-align:center;font-size:17px;font-weight:500;color:#111;margin-bottom:4px}\n.rev-avg{text-align:center;font-size:13px;color:#888;margin-bottom:1.5rem}\n.stars{color:#f5a623;font-size:15px;letter-spacing:1px}\n.reviews{display:flex;flex-direction:column;gap:12px}\n.review-card{background:#fdf0f6;border-radius:12px;padding:14px 16px;border:0.5px solid #edd0e0}\n.rev-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}\n.rev-name{font-size:13px;font-weight:500;color:#111}\n.rev-date{font-size:11px;color:#bbb}\n.rev-text{font-size:13px;color:#555;line-height:1.6}\n.rev-badge{display:inline-block;font-size:10px;background:#e8f5e9;color:#2e7d32;padding:2px 8px;border-radius:10px;margin-top:6px}\n.rev-more-wrap{text-align:center;margin-top:6px}\n.rev-more-btn{background:none;border:1px solid #edd0e0;color:#7B2D5E;font-size:12px;font-weight:500;padding:9px 22px;border-radius:999px;cursor:pointer;font-family:inherit}\n.rev-more-btn:hover{background:#fdf0f6}\n.review-card.hidden{display:none}\n\n.faq-title{text-align:center;font-size:17px;font-weight:500;color:#111;margin-bottom:1.2rem}\n.faq-item{border-bottom:0.5px solid #f0e0e8}\n.faq-q{width:100%;background:none;border:none;text-align:left;padding:14px 0;font-size:14px;font-weight:500;color:#111;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:inherit}\n.faq-q .arrow{font-size:16px;color:#7B2D5E;transition:transform 0.2s}\n.faq-q.open .arrow{transform:rotate(180deg)}\n.faq-a{font-size:13px;color:#666;line-height:1.7;max-height:0;overflow:hidden;transition:max-height 0.3s ease,padding-bottom 0.3s}\n.faq-a.open{max-height:200px;padding-bottom:14px}\n\n.guarantee{display:flex;align-items:center;gap:16px;background:#fdf0f6;border-radius:14px;padding:16px 20px;border:0.5px solid #edd0e0}\n.guarantee-icon{font-size:36px;flex-shrink:0}\n.guarantee-text h4{font-size:14px;font-weight:500;color:#111;margin-bottom:4px}\n.guarantee-text p{font-size:13px;color:#666;line-height:1.6}\n</style>\n\n<!-- TRUST BAR -->\n<div class=\"sec\">\n  <div class=\"trust-bar\">\n    <div class=\"trust-item\"><span class=\"ic\">🚚</span><span>Free delivery</span></div>\n    <div class=\"trust-item\"><span class=\"ic\">💧</span><span>Fast-absorbing formula</span></div>\n    <div class=\"trust-item\"><span class=\"ic\">🌿</span><span>Gentle on all skin types</span></div>\n    <div class=\"trust-item\"><span class=\"ic\">↩️</span><span>Easy returns</span></div>\n  </div>\n</div>\n\n<!-- HOW IT WORKS -->\n<div class=\"sec\">\n  <div class=\"how-title\">How to use</div>\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"step-num\">1</div>\n      <div class=\"step-title\">Cleanse</div>\n      <div class=\"step-desc\">Start with clean, dry skin so the formula can absorb fully</div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">2</div>\n      <div class=\"step-title\">Apply</div>\n      <div class=\"step-desc\">Massage a few drops into targeted areas until fully absorbed</div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">3</div>\n      <div class=\"step-title\">Repeat daily</div>\n      <div class=\"step-desc\">Use morning & night for visible brightening within days</div>\n    </div>\n  </div>\n</div>\n\n<!-- REVIEWS -->\n<div class=\"sec\">\n  <div class=\"rev-title\">What people are saying</div>\n  <div class=\"rev-avg\"><span class=\"stars\">★★★★★</span> 4.9 out of 5 · 214 happy customers</div>\n  <div class=\"reviews\" id=\"revList\">\n    <div class=\"review-card\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Sarah M.</span><span class=\"rev-date\">2 days ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★★</div>\n      <div class=\"rev-text\">I've tried so many brightening products and this is the only one that actually made a visible difference. My underarms are so much lighter 😭</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Lara K.</span><span class=\"rev-date\">5 days ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★★</div>\n      <div class=\"rev-text\">Used it daily for a week and my skin tone already looks so much more even. I'm obsessed. Absorbs fast too, doesn't feel sticky.</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Nour A.</span><span class=\"rev-date\">1 week ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★☆</div>\n      <div class=\"rev-text\">Started noticing my dark spots fading within the first two weeks. Took a bit to find the right amount to use but now it's part of my daily routine.</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n    <div class=\"review-card hidden\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Yara H.</span><span class=\"rev-date\">1 week ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★★</div>\n      <div class=\"rev-text\">Ordered this for underarm brightening and honestly didn't expect much, but two weeks in the difference is real. Doesn't irritate my sensitive skin either.</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n    <div class=\"review-card hidden\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Maya D.</span><span class=\"rev-date\">2 weeks ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★★</div>\n      <div class=\"rev-text\">Texture is light, sinks in fast, and a little really does go a long way. My elbows and knees look noticeably more even after consistent daily use.</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n    <div class=\"review-card hidden\">\n      <div class=\"rev-top\"><span class=\"rev-name\">Rania F.</span><span class=\"rev-date\">3 weeks ago</span></div>\n      <div class=\"stars\" style=\"font-size:12px;margin-bottom:6px\">★★★★☆</div>\n      <div class=\"rev-text\">Good product overall, just wish the bottle was a bit bigger given how often I reach for it. Results were gradual but noticeable by week three.</div>\n      <span class=\"rev-badge\">✓ Verified purchase</span>\n    </div>\n  </div>\n  <div class=\"rev-more-wrap\">\n    <button class=\"rev-more-btn\" id=\"revMoreBtn\" onclick=\"toggleReviews()\">Show more reviews</button>\n  </div>\n</div>\n\n<!-- FAQ -->\n<div class=\"sec\">\n  <div class=\"faq-title\">Common questions</div>\n  <div class=\"faq-item\">\n    <button class=\"faq-q\" onclick=\"toggleFaq(this)\">How soon will I see results? <span class=\"arrow\">▾</span></button>\n    <div class=\"faq-a\">Most people notice visibly brighter, more even-toned skin within 7 days of consistent use. For deeper discoloration, full results typically appear over 3–4 weeks.</div>\n  </div>\n  <div class=\"faq-item\">\n    <button class=\"faq-q\" onclick=\"toggleFaq(this)\">Where can I use it? <span class=\"arrow\">▾</span></button>\n    <div class=\"faq-a\">Safe for use on underarms, elbows, knees, and other areas prone to dullness or dark spots. Avoid broken or irritated skin.</div>\n  </div>\n  <div class=\"faq-item\">\n    <button class=\"faq-q\" onclick=\"toggleFaq(this)\">Can I use it with other skincare products? <span class=\"arrow\">▾</span></button>\n    <div class=\"faq-a\">Yes! It layers well with your existing routine. Apply after cleansing and before heavier creams or oils for best absorption.</div>\n  </div>\n  <div class=\"faq-item\">\n    <button class=\"faq-q\" onclick=\"toggleFaq(this)\">Is it safe for sensitive skin? <span class=\"arrow\">▾</span></button>\n    <div class=\"faq-a\">Yes — formulated with skin-friendly ingredients, free from harsh chemicals. Always do a patch test first if you have very sensitive skin.</div>\n  </div>\n</div>\n\n<!-- GUARANTEE -->\n<div class=\"sec\" style=\"border-bottom:none\">\n  <div class=\"guarantee\">\n    <div class=\"guarantee-icon\">🛡️</div>\n    <div class=\"guarantee-text\">\n      <h4>Love it or we'll make it right</h4>\n      <p>Not happy with your order? Contact us within 30 days and we'll sort it out — no complicated process, no hassle.</p>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction toggleFaq(btn) {\n  var ans = btn.nextElementSibling;\n  var isOpen = ans.classList.contains('open');\n  document.querySelectorAll('.faq-a').forEach(function(a){ a.classList.remove('open') });\n  document.querySelectorAll('.faq-q').forEach(function(q){ q.classList.remove('open') });\n  if (!isOpen) { ans.classList.add('open'); btn.classList.add('open'); }\n}\n\nfunction toggleReviews() {\n  var hiddenCards = document.querySelectorAll('#revList .review-card.hidden');\n  var btn = document.getElementById('revMoreBtn');\n  var isShowing = btn.textContent.indexOf('Show less') !== -1;\n\n  if (isShowing) {\n    hiddenCards.forEach(function(c){ c.classList.add('hidden'); });\n    btn.textContent = 'Show more reviews';\n  } else {\n    document.querySelectorAll('#revList .review-card').forEach(function(c){ c.classList.remove('hidden'); });\n    btn.textContent = 'Show less';\n  }\n}\n</script>",
