    "custom_liquid_PyWqQE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"vs-block\">\n  <div class=\"vs-block-head\">\n    <p class=\"vs-eyebrow\">The difference is in the support</p>\n    <h2 class=\"vs-title\">Regular Insoles <span class=\"vs-vs\">vs</span> Stepprs</h2>\n  </div>\n\n  <div class=\"vs-cols\">\n    <div class=\"vs-col vs-col-chem\">\n      <div class=\"vs-col-head\">\n        <span class=\"vs-col-icon vs-col-icon-chem\">✕</span>\n        <span class=\"vs-col-name\">Regular Insoles</span>\n      </div>\n      <div class=\"vs-list\">\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Material</span><span class=\"vs-point-val\">Thin foam, flattens fast</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Support</span><span class=\"vs-point-val\">Little to no arch support</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Side effects</span><span class=\"vs-point-val\">Sweaty, smelly, uncomfortable</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Foot health</span><span class=\"vs-point-val\">Doesn't address the cause</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Long-term</span><span class=\"vs-point-val\">Replace every few weeks</span></div>\n      </div>\n    </div>\n\n    <div class=\"vs-col vs-col-norse\">\n      <div class=\"vs-col-head\">\n        <span class=\"vs-col-icon vs-col-icon-norse\">✓</span>\n        <span class=\"vs-col-name\">Stepprs</span>\n      </div>\n      <div class=\"vs-list\">\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Material</span><span class=\"vs-point-val\">Shock-absorbing, holds its shape</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Support</span><span class=\"vs-point-val\">Targeted arch &amp; heel support</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Side effects</span><span class=\"vs-point-val\">Breathable, comfortable all day</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Foot health</span><span class=\"vs-point-val\">Relieves pain at the source</span></div>\n        <div class=\"vs-point\"><span class=\"vs-point-label\">Long-term</span><span class=\"vs-point-val\">Built to last 12+ months</span></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .vs-block{\n    max-width:820px;\n    margin:0 auto;\n    box-sizing:border-box;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  .vs-block *{box-sizing:border-box;}\n  .vs-block-head{\n    text-align:center;\n    margin-bottom:36px;\n  }\n  .vs-eyebrow{\n    font-size:13px;\n    color:#8a8578;\n    margin:0 0 10px 0;\n  }\n  .vs-title{\n    font-size:28px;\n    font-weight:800;\n    color:#1a1a1a;\n    margin:0;\n    line-height:1.3;\n  }\n  .vs-vs{\n    color:#c2c2c2;\n    font-weight:500;\n    font-size:20px;\n    padding:0 6px;\n  }\n  .vs-cols{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:20px;\n    align-items:stretch;\n  }\n  .vs-col{\n    border-radius:16px;\n    padding:28px 26px;\n  }\n  .vs-col-chem{\n    background:#f1efe9;\n    border:1px solid #e2ded2;\n  }\n  .vs-col-norse{\n    background:#2a1f17;\n    border:1px solid #2a1f17;\n  }\n  .vs-col-head{\n    display:flex;\n    align-items:center;\n    gap:12px;\n    margin-bottom:22px;\n    padding-bottom:20px;\n    border-bottom:1px solid rgba(0,0,0,0.08);\n  }\n  .vs-col-norse .vs-col-head{\n    border-bottom:1px solid rgba(255,255,255,0.14);\n  }\n  .vs-col-icon{\n    width:30px;\n    height:30px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:14px;\n    font-weight:800;\n    flex-shrink:0;\n  }\n  .vs-col-icon-chem{\n    background:#e4dfd2;\n    color:#8a5a4a;\n  }\n  .vs-col-icon-norse{\n    background:#ff6a13;\n    color:#2a1f17;\n  }\n  .vs-col-name{\n    font-size:17px;\n    font-weight:700;\n    color:#1a1a1a;\n  }\n  .vs-col-norse .vs-col-name{\n    color:#f5efe8;\n  }\n  .vs-list{\n    display:flex;\n    flex-direction:column;\n    gap:16px;\n  }\n  .vs-point{\n    display:flex;\n    flex-direction:column;\n    gap:3px;\n  }\n  .vs-point-label{\n    font-size:12px;\n    font-weight:700;\n    color:#928d7f;\n  }\n  .vs-col-norse .vs-point-label{\n    color:#ffb067;\n  }\n  .vs-point-val{\n    font-size:15px;\n    line-height:1.45;\n    color:#2b2b26;\n    font-weight:500;\n  }\n  .vs-col-norse .vs-point-val{\n    color:#f5efe8;\n  }\n\n  @media(max-width:640px){\n    .vs-title{font-size:21px;}\n    .vs-vs{font-size:15px;}\n    .vs-cols{grid-template-columns:1fr; gap:16px;}\n    .vs-col{padding:22px 20px;}\n  }\n</style>",
        "full_width": true,
        "show_divider": false,
