    "custom_liquid_QWbLRi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"fade-section\">\n  <div class=\"fade-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0957/2981/1738/files/jolie.webp?v=1788932527\" alt=\"Woman walking comfortably thanks to Stepprs insoles\" loading=\"lazy\">\n  </div>\n  <div class=\"fade-content\">\n    <h2 class=\"fade-heading\">\n      Made To End <span class=\"highlight\">Foot Pain, Fatigue &amp; Aching Arches</span>\n    </h2>\n    <p class=\"fade-text\">\n      Meet the insole built for the pain nothing else has fixed.\n    </p>\n    <p class=\"fade-text\">\n      Most insoles just add a thin layer of cushioning, gone flat within a few weeks, long before they ever reach the real problem: your arch collapsing with every step. This one holds its shape and supports your foot properly for months, the structure it always needed to actually work.\n    </p>\n    <p class=\"fade-text\">\n      You feel the difference the first day you wear them, and your feet keep improving over the following weeks. It relieves the ache, it never feels stiff or uncomfortable.\n    </p>\n    <div class=\"fade-highlights\">\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Relieves Pain &amp; Fatigue</span>\n      </div>\n      <div class=\"highlight-item\">\n        <span class=\"sparkle\">✦</span>\n        <span>Supports your arch, never feels bulky</span>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n  .fade-section {\n    display: flex;\n    align-items: stretch;\n    gap: 40px;\n    font-family: Arial, Helvetica, sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    border-top: 3px solid #ff8a3d;\n    padding-top: 20px;\n  }\n  .fade-image {\n    flex: 1;\n    min-width: 0;\n  }\n  .fade-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 4px;\n  }\n  .fade-content {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 20px 0;\n  }\n  .fade-heading {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    line-height: 1.3;\n    margin: 0 0 20px 0;\n  }\n  .highlight {\n    background: #ff6a13;\n    color: #fff;\n    padding: 2px 8px;\n    box-decoration-break: clone;\n    -webkit-box-decoration-break: clone;\n  }\n  .fade-text {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #1a1a1a;\n    margin: 0 0 16px 0;\n  }\n  .fade-highlights {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 24px;\n    margin-top: 8px;\n  }\n  .highlight-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n  }\n  .sparkle {\n    color: #ff8a3d;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n  @media (max-width: 768px) {\n    .fade-section {\n      flex-direction: column;\n      gap: 20px;\n    }\n    .fade-heading {\n      font-size: 19px;\n      margin-bottom: 14px;\n    }\n    .fade-text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n    .fade-highlights {\n      gap: 14px;\n    }\n    .highlight-item {\n      font-size: 12.5px;\n    }\n    .fade-content {\n      padding: 0;\n    }\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
