    "custom_liquid_drDHVE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"myth-block\">\n  <h2 class=\"myth-title\">What our customers are saying</h2>\n  <p class=\"myth-sub\">Real feedback from people on their feet all day.</p>\n\n  <div class=\"myth-list\">\n    <div class=\"myth-row\">\n      <div class=\"myth-row-top\">\n        <span class=\"myth-stars\">★★★★★</span>\n        <span class=\"myth-name\">Karim H.</span>\n      </div>\n      <p class=\"myth-quote\">I work 10-hour shifts on my feet and these insoles changed everything. No more dragging myself home in pain.</p>\n    </div>\n    <div class=\"myth-row\">\n      <div class=\"myth-row-top\">\n        <span class=\"myth-stars\">★★★★★</span>\n        <span class=\"myth-name\">Rana A.</span>\n      </div>\n      <p class=\"myth-quote\">Bought them for my dad who never complains but always had sore feet. He asked me to order him a second pair.</p>\n    </div>\n    <div class=\"myth-row\">\n      <div class=\"myth-row-top\">\n        <span class=\"myth-stars\">★★★★★</span>\n        <span class=\"myth-name\">Charbel S.</span>\n      </div>\n      <p class=\"myth-quote\">Fit perfectly in my work boots after a quick trim. First full shift without any heel pain in years.</p>\n    </div>\n    <div class=\"myth-row\">\n      <div class=\"myth-row-top\">\n        <span class=\"myth-stars\">★★★★★</span>\n        <span class=\"myth-name\">Maya K.</span>\n      </div>\n      <p class=\"myth-quote\">I'm a nurse and stand all day. The arch support actually holds up, not like the drugstore ones I kept replacing.</p>\n    </div>\n    <div class=\"myth-row\">\n      <div class=\"myth-row-top\">\n        <span class=\"myth-stars\">★★★★★</span>\n        <span class=\"myth-name\">Ziad N.</span>\n      </div>\n      <p class=\"myth-quote\">Wasn't expecting much honestly, but my feet feel noticeably better by the end of the day now.</p>\n    </div>\n  </div>\n</div>\n\n<style>\n  .myth-block{\n    max-width:640px;\n    margin:0 auto;\n    box-sizing:border-box;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  .myth-block *{box-sizing:border-box;}\n  .myth-title{\n    font-family:\"Iowan Old Style\",\"Palatino Linotype\",Georgia,serif;\n    font-size:30px;\n    font-weight:600;\n    color:#1a1a1a;\n    margin:0 0 8px 0;\n    line-height:1.25;\n  }\n  .myth-sub{\n    font-size:15px;\n    color:#8a8578;\n    margin:0 0 34px 0;\n  }\n  .myth-list{\n    border-top:1px solid #ececec;\n  }\n  .myth-row{\n    padding:20px 0;\n    border-bottom:1px solid #ececec;\n  }\n  .myth-row-top{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    margin-bottom:8px;\n  }\n  .myth-stars{\n    font-size:14px;\n    color:#ff6a13;\n    letter-spacing:1px;\n  }\n  .myth-name{\n    font-size:14px;\n    font-weight:700;\n    color:#1a1a1a;\n  }\n  .myth-quote{\n    font-size:15.5px;\n    line-height:1.5;\n    color:#3a3a3a;\n    margin:0;\n  }\n\n  @media(max-width:560px){\n    .myth-title{font-size:23px;}\n    .myth-row{padding:16px 0;}\n    .myth-stars{font-size:12.5px;}\n    .myth-name{font-size:12.5px;}\n    .myth-quote{font-size:14px;}\n  }\n</style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
