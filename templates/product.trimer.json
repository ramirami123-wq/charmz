"M22 9l2.4 6.6L31 18l-6.6 2.4L22 27l-2.4-6.6L13 18l6.6-2.4L22 9z\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <path d=\"M32 28l1.1 3 3 1.1-3 1.1L32 36l-1.1-2.8-3-1.1 3-1.1L32 28z\" stroke=\"#1a1a1a\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <span class=\"lv-label\">Silky<br>Smooth Skin</span>\n    </div>\n\n    <!-- No bumps / ingrowns -->\n    <div class=\"lv-feat\">\n      <div class=\"lv-icon\">\n        <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- Shield / no bumps icon -->\n          <path d=\"M22 8l11 4v8c0 7-4.7 11.7-11 14-6.3-2.3-11-7-11-14v-8l11-4z\" stroke=\"#1a1a1a\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <path d=\"M17.5 21l3 3 6-6\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <span class=\"lv-label\">No Bumps<br>or Ingrowns</span>\n    </div>\n\n    <!-- No irritation -->\n    <div class=\"lv-feat\">\n      <div class=\"lv-icon\">\n        <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- Calm / soothed icon -->\n          <circle cx=\"22\" cy=\"22\" r=\"13\" stroke=\"#1a1a1a\" stroke-width=\"1.6\"/>\n          <path d=\"M16 25c1.5 2 4 3 6 3s4.5-1 6-3\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <circle cx=\"17.5\" cy=\"18.5\" r=\"1.3\" fill=\"#1a1a1a\"/>\n          <circle cx=\"26.5\" cy=\"18.5\" r=\"1.3\" fill=\"#1a1a1a\"/>\n        </svg>\n      </div>\n      <span class=\"lv-label\">Zero Redness<br>or Irritation</span>\n    </div>\n\n    <!-- Confidence in minutes -->\n    <div class=\"lv-feat\">\n      <div class=\"lv-icon\">\n        <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- Clock / fa