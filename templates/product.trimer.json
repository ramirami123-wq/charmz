      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>2-in-1 Painless Bikini Hair Trimmer</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --black: #1a1320;\n    --white: #ffffff;\n    --gray-light: #faf6f8;\n    --gray-mid: #ececec;\n    --gray-text: #777;\n    --accent: #c25b8e;\n    --accent-dark: #9c3f6e;\n    --green: #1a7f5a;\n    --gold: #e9a8c6;\n    --font: 'Helvetica Neue', Arial, sans-serif;\n  }\n\n  body { font-family: var(--font); color: var(--black); background: var(--white); line-height: 1.6; }\n\n  /* ── CUSTOMER BANNER ── */\n  .customer-banner {\n    background: var(--black);\n    color: var(--white);\n    padding: 14px 20px;\n    text-align: center;\n    font-size: 14px;\n    font-weight: 600;\n    letter-spacing: 0.5px;\n    width: 100%;\n  }\n  .customer-banner span { color: var(--gold); }\n\n  /* ── SECTION TITLES ── */\n  .section-title {\n    font-size: 30px; font-weight: 800; text-align: center;\n    margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px;\n  }\n  .section-subtitle {\n    text-align: center; color: var(--gray-text); font-size: 16px;\n    margin-bottom: 50px; max-width: 680px; margin-left: auto; margin-right: auto;\n  }\n\n  /* ── FEEL BETTER ── */\n  .feel-section { padding: 80px 5%; background: var(--white); }\n  .feel-inner {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;\n  }\n  .feel-img img { width: 100%; border-radius: 14px; object-fit: cover; height: 520px; }\n  .feel-text h2 { font-size: 32px; font-weight: 800; margin-bottom: 20px; line-height: 1.2; }\n  .feel-text p { font-size: 16px; color: #444; margin-bottom: 20px; line-height: 1.7; }\n  .feel-text ul { list-style: none; padding: 0; }\n  .feel-text ul li {\n    padding: 10px 0; font-size: 15px; border-bottom: 1px solid var(--gray-mid);\n    display: flex; align-items: flex-start; gap: 10px;\n  }\n  .feel-text ul li::before {\n    content: \"✓\"; color: var(--green); font-weight: 900; font-size: 17px;\n    flex-shrink: 0; margin-top: 1px;\n  }\n\n  /* ── TESTIMONIAL QUOTE ── */\n  .quote-box {\n    background: var(--gray-light); border-left: 5px solid var(--accent);\n    padding: 24px 28px; border-radius: 0 12px 12px 0; margin-top: 32px;\n  }\n  .quote-box p { font-style: italic; font-size: 16px; color: #333; margin-bottom: 12px; }\n  .quote-author { display: flex; align-items: center; gap: 12px; }\n  .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }\n  .author-info strong { display: block; font-size: 14px; font-weight: 700; }\n  .author-info span { font-size: 12px; color: var(--gray-text); }\n  .stars { color: var(--gold); font-size: 14px; letter-spacing: 2px; }\n\n  /* ── HOW IT WORKS (dark) ── */\n  .how-section { background: var(--black); padding: 80px 5%; color: var(--white); }\n  .how-section .section-title { color: var(--white); }\n  .how-section .section-subtitle { color: rgba(255,255,255,0.6); }\n  .how-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; }\n  .how-card {\n    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 14px; padding: 32px 24px; text-align: center;\n  }\n  .how-card .icon-wrap {\n    width: 64px; height: 64px; background: var(--accent); border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    margin: 0 auto 20px; font-size: 28px;\n  }\n  .how-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 10px; color: var(--white); text-transform: uppercase; letter-spacing: 0.5px; }\n  .how-card p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.6; }\n\n  /* ── COMPARISON ── */\n  .upgrade-section { background: var(--gray-light); padding: 80px 5%; }\n  .compare-table-wrap { max-width: 760px; margin: 40px auto 0; overflow-x: auto; }\n  .compare-table { width: 100%; border-collapse: collapse; background: var(--white); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }\n  .compare-table th, .compare-table td { padding: 16px 14px; text-align: center; font-size: 14px; border-bottom: 1px solid #f0f0f0; }\n  .compare-table thead th { background: var(--black); color: var(--white); font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; font-size: 13px; }\n  .compare-table thead th.brand-col { background: var(--accent); }\n  .compare-table tbody td:first-child { text-align: left; font-weight: 600; color: #333; }\n  .compare-table .yes { color: var(--green); font-weight: 900; font-size: 17px; }\n  .compare-table .no  { color: #c0392b; font-weight: 900; font-size: 17px; }\n  .compare-table .brand-cell { background: rgba(194,91,142,0.07); }\n\n  /* ── RESULTS ── */\n  .results-section { padding: 80px 5%; background: var(--white); }\n  .results-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }\n  .results-img img { width: 100%; border-radius: 14px; height: 500px; object-fit: cover; }\n  .stats-list { display: flex; flex-direction: column; gap: 28px; }\n  .stat-item { display: flex; align-items: flex-start; gap: 20px; }\n  .stat-number { font-size: 52px; font-weight: 900; color: var(--accent); line-height: 1; flex-shrink: 0; min-width: 90px; }\n  .stat-desc { font-size: 15px; color: #444; padding-top: 10px; line-height: 1.5; }\n  .stat-note { font-size: 12px; color: var(--gray-text); margin-top: 24px; font-style: italic; }\n\n  /* ── REVIEWS STRIP ── */\n  .reviews-section { background: var(--gray-light); padding: 80px 5%; }\n  .reviews-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 40px; }\n  .review-card { background: var(--white); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.05); }\n  .review-card img { width: 100%; height: 220px; object-fit: cover; display: block; }\n  .review-body { padding: 20px 22px; }\n  .review-body .stars { font-size: 14px; letter-spacing: 2px; margin-bottom: 10px; }\n  .review-body p { font-size: 14px; color: #444; line-height: 1.6; margin-bottom: 12px; font-style: italic; }\n  .review-body strong { font-size: 13px; font-weight: 700; }\n  .review-body span { font-size: 12px; color: var(--gray-text); display: block; }\n\n  /* ── GUARANTEE ── */\n  .guarantee-section { background: var(--black); color: var(--white); padding: 80px 5%; text-align: center; }\n  .guarantee-section h2 { font-size: 30px; font-weight: 800; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 1px; }\n  .guarantee-section > p { font-size: 17px; color: rgba(255,255,255,0.75); max-width: 680px; margin: 0 auto 48px; line-height: 1.7; }\n  .trust-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }\n  .trust-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 24px 16px; }\n  .trust-card .trust-icon { font-size: 32px; margin-bottom: 12px; }\n  .trust-card h4 { font-size: 14px; font-weight: 700; color: var(--white); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.3px; }\n  .trust-card p { font-size: 12px; color: rgba(255,255,255,0.5); margin: 0; }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 900px) {\n    .feel-inner, .results-inner { grid-template-columns: 1fr; }\n    .feel-img img, .results-img img { height: 320px; }\n    .how-grid { grid-template-columns: 1fr; }\n    .reviews-grid { grid-template-columns: 1fr; }\n    .trust-grid { grid-template-columns: 1fr 1fr; gap: 14px; }\n    .section-title { font-size: 24px; }\n    .stat-number { font-size: 40px; }\n  }\n\n  @media (max-width: 480px) {\n    .feel-section, .how-section, .upgrade-section,\n    .results-section, .reviews-section, .guarantee-section { padding: 50px 4%; }\n    .trust-grid { grid-template-columns: 1fr 1fr; gap: 12px; }\n    .trust-card { padding: 18px 12px; }\n    .trust-card .trust-icon { font-size: 26px; }\n    .trust-card h4 { font-size: 12px; }\n    .trust-card p { font-size: 11px; }\n    .guarantee-section h2 { font-size: 22px; }\n    .guarantee-section > p { font-size: 15px; }\n    .feel-text h2 { font-size: 24px; }\n    .stat-number { font-size: 36px; min-width: 72px; }\n  }\n</style>\n</head>\n<body>\n\n<!-- ── BANNER ── -->\n<div class=\"customer-banner\">💜 Loved by <span>280,000+</span> Women Worldwide — Rated 4.9/5</div>\n\n<!-- ── HERO BENEFIT ── -->\n<section class=\"feel-section\">\n  <div class=\"feel-inner\">\n    <div class=\"feel-img\">\n      <img src=\"https://iuibeauty.com/cdn/shop/files/20260330-143908.webp?v=1775117296&width=1000\" alt=\"Smooth, irritation-free skin\" />\n    </div>\n    <div class=\"feel-text\">\n      <h2>Smooth, Flawless Skin — Without the Pain</h2>\n      <p>No more nicks, razor burn, or stubble. Glide over your legs, arms, underarms, face, and bikini line for a clean, close finish that feels as good as it looks — in just 3 minutes.</p>\n      <p>The gentle <strong>dual-head design</strong> hugs every curve and sensitive area, so you get salon-smooth results at home with zero irritation, zero ingrown hairs, and zero stress.</p>\n      <ul>\n        <li><div><strong>No razor bumps or ingrowns</strong> — Skin stays clear, soft, and bump-free instead of red and irritated.</div></li>\n        <li><div><strong>Truly painless</strong> — No pulling, no cuts, no burning — gentle enough for the most sensitive areas.</div></li>\n        <li><div><strong>Smooth, not just trimmed</strong> — A close finish with no stubble or shadow, every single time.</div></li>\n        <li><div><strong>Ready in 3 minutes</strong> — Beach-ready, date-ready, confidence-ready whenever you want.</div></li>\n        <li><div><strong>Wet or dry, anywhere</strong> — Fully waterproof and USB rechargeable for up to 90 minutes cordless.</div></li>\n      </ul>\n      <div class=\"quote-box\">\n        <p>\"It removes hair smoothly without pulling or causing any irritation — even on sensitive areas like underarms and legs. I was surprised at how gentle it feels.\"</p>\n        <div class=\"quote-author\">\n          <img class=\"avatar\" src=\"https://iuibeauty.com/cdn/shop/files/20260429001.webp?v=1777473235&width=128\" alt=\"Swetha P.\" />\n          <div class=\"author-info\">\n            <strong>Swetha P.</strong>\n            <span>Verified buyer</span>\n            <div class=\"stars\">★ ★ ★ ★ ★</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ── WHAT YOU GET ── -->\n<section class=\"how-section\">\n  <p class=\"section-title\">What You'll Love</p>\n  <p class=\"section-subtitle\">Everything you want from hair removal — and nothing you don't.</p>\n  <div class=\"how-grid\">\n    <div class=\"how-card\">\n      <div class=\"icon-wrap\">✨</div>\n      <h3>Silky Smooth Finish</h3>\n      <p>A clean, close result with no stubble or shadow — leaving skin soft, smooth, and flawless every time you use it.</p>\n    </div>\n    <div class=\"how-card\">\n      <div class=\"icon-wrap\">💧</div>\n      <h3>No Bumps or Irritation</h3>\n      <p>Say goodbye to razor burn, redness, and ingrown hairs. Gentle enough for underarms, bikini line, and the most delicate areas.</p>\n    </div>\n    <div class=\"how-card\">\n      <div class=\"icon-wrap\">⚡</div>\n      <h3>Confidence in 3 Minutes</h3>\n      <p>Fast, effortless, and ready whenever you are — smooth skin on demand for beach days, dates, and last-minute plans.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ── COMPARISON ── -->\n<section class=\"upgrade-section\">\n  <p class=\"section-title\">Why Women Are Switching</p>\n  <p class=\"section-subtitle\">Everything waxing, lasers, and razors put you through — without the pain, cost, or hassle.</p>\n  <div class=\"compare-table-wrap\">\n    <table class=\"compare-table\">\n      <thead>\n        <tr>\n          <th></th>\n          <th class=\"brand-col\">IUI Trimmer</th>\n          <th>Waxing</th>\n          <th>Laser</th>\n          <th>Razors</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Pain-free experience</td>\n          <td class=\"brand-cell yes\">✓</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n        </tr>\n        <tr>\n          <td>Fast &amp; easy at home</td>\n          <td class=\"brand-cell yes\">✓</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n          <td class=\"yes\">✓</td>\n        </tr>\n        <tr>\n          <td>No razor bumps or ingrowns</td>\n          <td class=\"brand-cell yes\">✓</td>\n          <td class=\"no\">✗</td>\n          <td class=\"yes\">✓</td>\n          <td class=\"no\">✗</td>\n        </tr>\n        <tr>\n          <td>Cost-effective</td>\n          <td class=\"brand-cell yes\">✓</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n          <td class=\"yes\">✓</td>\n        </tr>\n        <tr>\n          <td>Gentle on sensitive skin</td>\n          <td class=\"brand-cell yes\">✓</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n          <td class=\"no\">✗</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n\n<!-- ── RESULTS ── -->\n<section class=\"results-section\">\n  <div class=\"results-inner\">\n    <div class=\"results-img\">\n      <img src=\"https://iuibeauty.com/cdn/shop/files/20260402-175051.webp?v=1775123499&width=1000\" alt=\"Smooth skin results\" />\n    </div>\n    <div>\n      <h2 style=\"font-size:30px;font-weight:800;margin-bottom:36px;text-transform:uppercase;letter-spacing:1px;\">Loved by 280,000+ Women</h2>\n      <div class=\"stats-list\">\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">4.9</div>\n          <p class=\"stat-desc\">Average rating across 625+ reviews — women keep coming back for the smooth, irritation-free results.</p>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">100%</div>\n          <p class=\"stat-desc\">Of reviewers would recommend this product to a friend looking for painless hair removal.</p>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">3 min</div>\n          <p class=\"stat-desc\">All it takes to go from stubble to silky smooth — anywhere on your body, wet or dry.</p>\n        </div>\n      </div>\n      <p class=\"stat-note\">*Based on aggregated customer reviews. Individual results may vary.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ── REVIEWS ── -->\n<section class=\"reviews-section\">\n  <p class=\"section-title\">Real Results, Real Reviews</p>\n  <p class=\"section-subtitle\">From sensitive underarms to the bikini line — here's what real users are saying.</p>\n  <div class=\"reviews-grid\">\n    <div class=\"review-card\">\n      <img src=\"https://iuibeauty.com/cdn/shop/files/20260429004.webp?v=1777473379&width=600\" alt=\"Customer review\" />\n      <div class=\"review-body\">\n        <div class=\"stars\">★ ★ ★ ★ ★</div>\n        <p>\"Easy to use and very comfortable for trimming both body hair and the bikini area. It cuts so smoothly without irritating the skin, even in sensitive areas.\"</p>\n        <strong>Kiara B.</strong>\n        <span>Verified buyer</span>\n      </div>\n    </div>\n    <div class=\"review-card\">\n      <img src=\"https://iuibeauty.com/cdn/shop/files/20260429003.webp?v=1777473381&width=600\" alt=\"Customer review\" />\n      <div class=\"review-body\">\n        <div class=\"stars\">★ ★ ★ ★ ★</div>\n        <p>\"The dual-head design makes it super convenient — from my bikini line and underarms to my legs and even facial hair. No irritation, no nicks.\"</p>\n        <strong>Nina C.</strong>\n        <span>Verified buyer</span>\n      </div>\n    </div>\n    <div class=\"review-card\">\n      <img src=\"https://iuibeauty.com/cdn/shop/files/20260429002.webp?v=1777473375&width=600\" alt=\"Customer review\" />\n      <div class=\"review-body\">\n        <div class=\"stars\">★ ★ ★ ★ ★</div>\n        <p>\"From the first use, it delivered an impressively smooth and clean shave — no pulling, no irritation, and no missed spots.\"</p>\n        <strong>Swetha P.</strong>\n        <span>Verified buyer</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ── GUARANTEE ── -->\n<section class=\"guarantee-section\">\n  <h2>Smooth Skin, Guaranteed.</h2>\n  <p>Every woman deserves to feel confident in her own skin. That's why our trimmer is designed for comfort, safety, and real results — backed by hassle-free returns within 30 days so you can try it with total peace of mind.</p>\n  <div class=\"trust-grid\">\n    <div class=\"trust-card\">\n      <div class=\"trust-icon\">🛡️</div>\n      <h4>30-Day Returns</h4>\n      <p>Hassle-free returns within 30 days if you're not completely happy.</p>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"trust-icon\">🚚</div>\n      <h4>Fast & Free Shipping</h4>\n      <p>Free shipping on all orders over $79, delivered straight to your door.</p>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"trust-icon\">💳</div>\n      <h4>Pay With Ease</h4>\n      <p>Multiple secure payment options with flexible installments available.</p>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"trust-icon\">💬</div>\n      <h4>24/7 Support</h4>\n      <p>Quick, convenient, and flexible support whenever you need it.</p>\n    </div>\n  </div>\n</section>\n\n</body>\n</html>",
