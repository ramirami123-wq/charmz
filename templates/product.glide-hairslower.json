        "custom_liquid": "<style>\n  .stat-circles-section {\n    max-width: 800px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 20px 16px;\n    font-family: Georgia, 'Times New Roman', serif;\n    box-sizing: border-box;\n  }\n  .stat-circles-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n  }\n  .stat-circle-card {\n    background: #f7f6f4;\n    border-radius: 14px;\n    padding: 30px 24px;\n    text-align: center;\n  }\n  .stat-circle {\n    width: clamp(110px, 20vw, 150px);\n    height: clamp(110px, 20vw, 150px);\n    border-radius: 50%;\n    background: #3B2F26;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 auto 22px;\n  }\n  .stat-circle-number {\n    font-size: clamp(32px, 6vw, 46px);\n    color: #fff;\n    font-family: Georgia, serif;\n  }\n  .stat-circle-label {\n    font-size: clamp(15px, 2.2vw, 18px);\n    line-height: 1.4;\n    color: #3B2F26;\n    margin-bottom: 16px;\n  }\n  .stat-circle-sub {\n    font-size: clamp(11.5px, 1.6vw, 13px);\n    color: #999;\n    font-family: Arial, Helvetica, sans-serif;\n    line-height: 1.5;\n  }\n  @media (max-width: 500px) {\n    .stat-circles-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"stat-circles-section\">\n  <div class=\"stat-circles-grid\">\n\n    <div class=\"stat-circle-card\">\n      <div class=\"stat-circle\">\n        <span class=\"stat-circle-number\">88%</span>\n      </div>\n      <div class=\"stat-circle-label\">reported softer, finer hair texture in the first 4 weeks*</div>\n      <div class=\"stat-circle-sub\">*Based on a four-week independent customer panel</div>\n    </div>\n\n    <div class=\"stat-circle-card\">\n      <div class=\"stat-circle\">\n        <span class=\"stat-circle-number\">94%</span>\n      </div>\n      <div class=\"stat-circle-label\">reported reduced facial hair in the first 4 weeks*</div>\n      <div class=\"stat-circle-sub\">*Based on a four-week independen