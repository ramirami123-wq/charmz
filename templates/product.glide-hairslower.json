      "settings": {
        "custom_liquid": "<!-- ============================================================\n     NU:YU â€” Glide Serum product page sections\n     1) \"Why Nothing Has Worked\"\n     2) \"What's Really Going On Beneath the Surface\"\n     3) \"The Molecule That Changes Everything\"\n     Structure/class names mirror the live Shopify (Dawn) theme markup.\n     Images are hotlinked directly from nuyubeauty.com's CDN.\n     ============================================================ -->\n\n<style>\n  /* ---------- shared tokens (approximating the theme's CSS vars) ---------- */\n  .nuyu-scope {\n    --color-foreground: 18,18,18;\n    --color-background: 255,255,255;\n    --page-width: 120rem;\n    font-family: \"New York\", Iowan Old Style, Apple Garamond, Baskerville,\n      \"Times New Roman\", Droid Serif, Times, \"Source Serif Pro\", serif;\n    color: rgba(var(--color-foreground), 0.85);\n    background: rgb(var(--color-background));\n  }\n  .nuyu-scope * { box-sizing: border-box; }\n  .nuyu-scope img { max-width: 100%; display: block; }\n\n  .nuyu-scope .page-width {\n    max-width: var(--page-width);\n    margin: 0 auto;\n    padding: 0 5rem;\n  }\n  @media screen and (max-width: 749px) {\n    .nuyu-scope .page-width { padding: 0 1.5rem; }\n  }\n\n  .nuyu-scope .product_judge-outer {\n    padding: 60px 0;\n  }\n  .nuyu-scope .outer_why-bloating { background: #fff; }\n\n  .nuyu-scope .product_judge-container {\n    text-align: center;\n    max-width: 780px;\n    margin: 0 auto 32px;\n  }\n  .nuyu-scope .product_judge-container.top_padding { padding-top: 20px; }\n\n  .nuyu-scope .product-section_title {\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 500;\n    margin: 0 0 16px;\n    color: #121212;\n  }\n  .nuyu-scope .product-section_title.centered { text-align: center; }\n\n  .nuyu-scope .product-section_text {\n    font-size: 17px;\n    line-height: 1.6;\n    color: rgba(18,18,18,0.75);\n    margin: 0;\n  }\n  .nuyu-scope .product-section_text.centered { text-align: center; }\n\n  @media screen and (max-width: 749px) {\n    .nuyu-scope .product-section_title { font-size: 24px; }\n    .nuyu-scope .product-section_text { font-size: 15px; }\n  }\n\n  /* ---------- section 1: Why Nothing Has Worked ---------- */\n  .nuyu-scope .product_why-bloating-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 16px;\n    margin-bottom: 24px;\n  }\n  @media (min-width: 768px) {\n    .nuyu-scope .product_why-bloating-grid {\n      grid-template-columns: 1fr 1fr 1fr 1fr;\n    }\n  }\n\n  .nuyu-scope .product_why-note-img { text-align: center; margin: 24px 0; }\n  .nuyu-scope .product_why-note-img img { margin: 0 auto; }\n  .nuyu-scope .product_why-note-img .Mobile_only { display: none; }\n  @media screen and (max-width: 749px) {\n    .nuyu-scope .product_why-note-img .Desktop_only { display: none; }\n    .nuyu-scope .product_why-note-img .Mobile_only { display: block; }\n  }\n\n  .nuyu-scope .product_arrow-img {\n    display: block;\n    margin: 24px auto;\n    width: 40px;\n    height: auto;\n  }\n\n  /* ---------- section 3: The Molecule That Changes Everything ---------- */\n  .nuyu-scope .pli_outer { padding-top: 0; padding-bottom: 0; }\n\n  .nuyu-scope .pli_flex {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 32px;\n    align-items: center;\n  }\n  @media (min-width: 900px) {\n    .nuyu-scope .pli_flex { grid-template-columns: 1fr 1fr; }\n    .nuyu-scope .pli_flex.reversed { direction: rtl; }\n    .nuyu-scope .pli_flex.reversed > * { direction: ltr; }\n  }\n\n  .nuyu-scope .pli_top-text p,\n  .nuyu-scope .pli_bottom-text p { font-size: 16px; line-height: 1.6; margin: 0 0 10px; }\n  .nuyu-scope .pli_top-text ul,\n  .nuyu-scope .pli_bottom-text ul {\n    margin: 8px 0 12px;\n    padding-left: 20px;\n  }\n  .nuyu-scope .pli_top-text li,\n  .nuyu-scope .pli_bottom-text li { font-size: 16px; line-height: 1.6; margin-bottom: 4px; }\n\n  .nuyu-scope .pli_pink-text {\n    background: #fce9ec;\n    border-radius: 12px;\n    padding: 16px 20px;\n    margin: 16px 0;\n  }\n  .nuyu-scope .pli_pink-text p { margin: 0; font-weight: 600; font-size: 16px; }\n  .nuyu-scope .pli_pink-text ul { margin: 8px 0 0; padding-left: 20px; }\n  .nuyu-scope .pli_pink-text li { font-size: 16px; line-height: 1.6; margin-bottom: 4px; }\n\n  .nuyu-scope .pli_flex img { border-radius: 16px; margin: 0 auto; }\n  .nuyu-scope .pli_flex .Mobile_only { display: none; }\n  @media screen and (max-width: 749px) {\n    .nuyu-scope .pli_flex .Desktop_only { display: none; }\n    .nuyu-scope .pli_flex .Mobile_only { display: block; }\n  }\n</style>\n\n<div class=\"nuyu-scope\">\n\n  <!-- ============ SECTION: Why Nothing Has Worked ============ -->\n  <div class=\"product_judge-outer outer_why-bloating\">\n    <div class=\"page-width\">\n\n      <div class=\"product_judge-container\">\n        <h2 class=\"product-section_title centered\">Why Nothing Has Worked</h2>\n        <p class=\"product-section_text centered\">\n          It's not that you've been doing anything wrong â€” it's that every method\n          you've tried only targets the surface, not the overactive follicles\n          causing the problem beneath it.\n        </p>\n      </div>\n\n      <div class=\"product_why-bloating-grid\"></div>\n\n      <div class=\"product_why-note-img\">\n        <img class=\"Desktop_only\" loading=\"lazy\"\n             src=\"//nuyubeauty.com/cdn/shop/files/Frame_1000003585_1.png?v=1762383587\"\n             alt=\"Why nothing has worked\">\n        <img class=\"Mobile_only\" loading=\"lazy\"\n             src=\"//nuyubeauty.com/cdn/shop/files/Frame_1000003585.png?v=1762383598\"\n             alt=\"Why nothing has worked\">\n      </div>\n\n      <img loading=\"lazy\" class=\"product_arrow-img\"\n           src=\"https://cdn.shopify.com/s/files/1/0917/5649/5191/files/Frame_1000003589.png?v=1760690549\"\n           alt=\"\">\n\n      <!-- ============ SECTION: What's Really Going On Beneath the Surface ============ -->\n      <div class=\"product_judge-container\">\n        <h2 class=\"product-section_title centered\">What's Really Going On Beneath the Surface</h2>\n      </div>\n\n      <div class=\"product_why-note-img\">\n        <img class=\"Desktop_only\" loading=\"lazy\"\n             src=\"//nuyubeauty.com/cdn/shop/files/Frame_1000003590_3.png?v=1762415732\"\n             alt=\"What's really going on beneath the surface\">\n        <img class=\"Mobile_only\" loading=\"lazy\"\n             src=\"//nuyubeauty.com/cdn/shop/files/Frame_1000003590_2.png?v=1762415727\"\n             alt=\"What's really going on beneath the surface\">\n      </div>\n\n      <img loading=\"lazy\" class=\"product_arrow-img\"\n           src=\"https://cdn.shopify.com/s/files/1/0917/5649/5191/files/Frame_1000003589.png?v=1760690549\"\n           alt=\"\">\n\n    </div>\n  </div>\n\n  <!-- ============ SECTION: The Molecule That Changes Everything ============ -->\n  <div class=\"product_judge-outer pli_outer\">\n    <div class=\"page-width\">\n\n      <div class=\"product_judge-container top_padding\">\n        <h2 class=\"product-section_title centered\">The Molecule That Changes Everything</h2>\n      </div>\n\n      <div class=\"pli_flex\">\n        <div>\n          <div class=\"pli_top-text\">\n            <p>Your hair follicles are powered by ATPâ€”the \"energy molecule\" that\n              fuels every cell in your body. When follicles receive this energy,\n              they produce hair. Constantly.</p>\n            <p><br>When everything's balanced, you barely notice facial hair.</p>\n            <ul>\n              <li>Hair grows slowly</li>\n              <li>Texture stays fine</li>\n              <li>You feel confident and free</li>\n            </ul>\n          </div>\n\n          <div class=\"pli_pink-text\">\n            <p>But after hormonal changes, this system goes into overdrive.</p>\n          </div>\n\n          <div class=\"pli_bottom-text\">\n            <ul>\n              <li>Follicles receive more energy</li>\n              <li>Hair grows faster and thicker</li>\n              <li>Removal triggers even more growth</li>\n              <li>The cycle never stops</li>\n            </ul>\n            <p>Instead of slowing down, your follicles are working overtime.\n              The hair you removed yesterday? It's already growing\n              backâ€”coarser, darker, and faster than before.</p>\n          </div>\n        </div>\n\n        <div>\n          <img loading=\"lazy\" class=\"Desktop_only\"\n               src=\"//nuyubeauty.com/cdn/shop/files/Frame_1484580366.png?v=1762374205\"\n               alt=\"ATP hair follicle diagram\">\n          <img loading=\"lazy\" class=\"Mobile_only\"\n               src=\"//nuyubeauty.com/cdn/shop/files/Frame_1484580366_1.png?v=1762384572\"\n               alt=\"ATP hair follicle diagram\">\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n</div>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "custom_liquid_aEqyqy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     NU:YU — Glide Serum product page sections (part 2)\n     1) Stats / Mission section — \"We're on a Mission To Help 1,00,000 Women...\"\n     2) FAQ section — \"Frequently Asked Questions\"\n     Structure/class names mirror the live Shopify (Dawn) theme markup.\n     Images are hotlinked directly from nuyubeauty.com's CDN.\n     ============================================================ -->\n\n<style>\n  .nuyu-scope2 {\n    --color-foreground: 18,18,18;\n    --color-background: 255,255,255;\n    --page-width: 120rem;\n    font-family: \"New York\", Iowan Old Style, Apple Garamond, Baskerville,\n      \"Times New Roman\", Droid Serif, Times, \"Source Serif Pro\", serif;\n    color: rgba(var(--color-foreground), 0.85);\n    background: rgb(var(--color-background));\n  }\n  .nuyu-scope2 * { box-sizing: border-box; }\n  .nuyu-scope2 img { max-width: 100%; display: block; }\n  .nuyu-scope2 .page-width { max-width: var(--page-width); margin: 0 auto; padding: 0 5rem; }\n  @media screen and (max-width: 749px) { .nuyu-scope2 .page-width { padding: 0 1.5rem; } }\n\n  .nuyu-scope2 .product_judge-outer { padding: 60px 0; }\n\n  .nuyu-scope2 .product-section_title {\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 500;\n    margin: 0 0 16px;\n    color: #121212;\n  }\n  .nuyu-scope2 .product-section_title.centered { text-align: center; }\n  .nuyu-scope2 .product-text p { font-size: 17px; line-height: 1.6; margin: 0 0 20px; font-family: Arial, sans-serif; }\n\n  .nuyu-scope2 .Mobile_only { display: none; }\n  @media screen and (max-width: 749px) {\n    .nuyu-scope2 .Desktop_only { display: none !important; }\n    .nuyu-scope2 .Mobile_only { display: block !important; }\n  }\n\n  /* ---------- Stats / Mission section ---------- */\n  .nuyu-scope2 .product_stats-outer {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 40px;\n    align-items: center;\n  }\n  @media (min-width: 900px) {\n    .nuyu-scope2 .product_stats-outer { grid-template-columns: 1fr 1fr; }\n  }\n  .nuyu-scope2 .product_expert-media img { border-radius: 20px; }\n\n  /* ---------- FAQ section ---------- */\n  .nuyu-scope2 .product_faq_container {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n  .nuyu-scope2 .product_faq-box {\n    border-bottom: 1px solid rgba(18,18,18,0.12);\n  }\n  .nuyu-scope2 .product_faq-thumb {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 22px 4px;\n    cursor: pointer;\n  }\n  .nuyu-scope2 .product_faq-thumb p {\n    margin: 0;\n    font-size: 18px;\n    font-weight: 500;\n    color: #121212;\n  }\n  .nuyu-scope2 .product_faq-thumb svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n    fill: #121212;\n    transition: transform 0.25s ease;\n  }\n  .nuyu-scope2 .product_faq-box.active .product_faq-thumb svg {\n    transform: rotate(180deg);\n  }\n  .nuyu-scope2 .product_faq-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease, padding 0.3s ease;\n    font-family: Arial, sans-serif;\n  }\n  .nuyu-scope2 .product_faq-box.active .product_faq-content {\n    max-height: 600px;\n    padding-bottom: 22px;\n  }\n  .nuyu-scope2 .product_faq-content p,\n  .nuyu-scope2 .product_faq-content li {\n    font-size: 15px;\n    line-height: 1.65;\n    color: rgba(18,18,18,0.75);\n    margin: 0 0 10px;\n  }\n  .nuyu-scope2 .product_faq-content ul,\n  .nuyu-scope2 .product_faq-content ol { margin: 0 0 10px; padding-left: 20px; }\n\n  .nuyu-scope2 .btn_container { text-align: center; margin-top: 36px; }\n  .nuyu-scope2 .btn_container.centered { text-align: center; }\n  .nuyu-scope2 .product_primary-btn {\n    display: inline-block;\n    background: #121212;\n    color: #fff;\n    text-decoration: none;\n    font-family: Arial, sans-serif;\n    font-weight: 600;\n    font-size: 15px;\n    letter-spacing: 0.02em;\n    padding: 16px 40px;\n    border-radius: 4px;\n  }\n  .nuyu-scope2 .product_primary-btn-footer {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 12px;\n    font-family: Arial, sans-serif;\n    font-size: 13px;\n    color: rgba(18,18,18,0.7);\n  }\n  .nuyu-scope2 .product_primary-btn-footer img { width: 16px; height: 16px; }\n</style>\n\n<div class=\"nuyu-scope2\">\n\n  <!-- ============ SECTION: Stats / Mission ============ -->\n  <div class=\"product_judge-outer\">\n    <div class=\"page-width\">\n      <div class=\"product_stats-outer\">\n        <div>\n          <div class=\"product_expert-content\">\n            <h2 class=\"product-section_title\">We're on a Mission To Help 1,00,000 Women Naturally Slow Facial Hair... and Regain Their Confidence</h2>\n            <div class=\"product-text\"><p>Here's where we're at right now:</p></div>\n            <img loading=\"lazy\" class=\"Mobile_only\"\n                 src=\"//nuyubeauty.com/cdn/shop/files/image_1_1.png?v=1762376341\"\n                 alt=\"94% of women saw reduced facial hair in the first 4 weeks\">\n            <img loading=\"lazy\" class=\"Desktop_only\"\n                 src=\"//nuyubeauty.com/cdn/shop/files/Frame_1484580444.png?v=1762376357\"\n                 alt=\"Stats: 94%, 88%, 51%\">\n            <img loading=\"lazy\" class=\"Mobile_only\"\n                 src=\"//nuyubeauty.com/cdn/shop/files/Frame_1484580444.png?v=1762376357\"\n                 alt=\"Stats: 94%, 88%, 51%\">\n          </div>\n        </div>\n        <div class=\"product_expert-media Desktop_only\">\n          <img loading=\"lazy\"\n               src=\"//nuyubeauty.com/cdn/shop/files/image_1_1.png?v=1762376341\"\n               alt=\"Woman holding Glide Serum\">\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ============ SECTION: Frequently Asked Questions ============ -->\n  <div class=\"product_judge-outer\">\n    <div class=\"page-width\">\n      <h2 class=\"product-section_title centered\">Frequently Asked Questions</h2>\n\n      <div class=\"product_faq_container\" id=\"nuyuFaqContainer\">\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>How is this different from laser hair removal or other solutions?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Unlike razors, waxes, or creams that only remove hair temporarily, Glide works beneath the surface to slow hair growth at the follicle.</p>\n            <p>It blocks ATP (the energy molecule) that follicles need to grow, making regrowth 51% slower, softer, and less noticeable.</p>\n            <p>Plus, it works on all hair colors and types, unlike laser treatments.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>Why didn't shaving/waxing work long-term?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Shaving, waxing, and plucking only address the hair on the surface.</p>\n            <p>They don't slow down follicle activity or reduce the energy supply that causes rapid growth. In fact, constant removal can actually trigger follicles to produce more hair as a defense response.</p>\n            <p>That's why you're stuck in the endless cycle—removing the same hairs over and over, sometimes even seeing them come back thicker and darker.</p>\n            <p>Glide works differently. It addresses the ROOT CAUSE by blocking ATP energy to follicles, which naturally slows growth from the source.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>How long until I see results?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Most women notice calmer, soothed skin immediately after the first application—no more redness or irritation after hair removal.</p>\n            <p>Within 1-2 weeks, you'll notice hair growing back more slowly than usual.</p>\n            <p>By week 4, hair texture becomes noticeably softer and finer—no more coarse stubble.</p>\n            <p>After 60 days, your hair removal routine will be completely transformed. You'll be going twice as long between sessions, and regrowth will be barely noticeable.</p>\n            <p>The key is consistency—use Glide twice daily for best results.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>Is this safe? Any side effects?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Yes, Glide is completely safe for daily use. The formula is made with natural, gentle ingredients designed to soothe and calm skin, not irritate it.</p>\n            <p>It's gentle enough for sensitive skin and works on all skin tones. Unlike harsh depilatory creams that burn or laser treatments that can cause scarring, Glide nourishes your skin while slowing hair growth.</p>\n            <p>There are no known side effects. However, if you have extremely sensitive skin or specific allergies, we recommend doing a patch test on a small area first or consulting with a skincare specialist.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>Can I use this with my current hair removal method?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Absolutely! Glide complements waxing, threading, plucking, and epilating.</p>\n            <p>It's an alternative to shaving (which we don't recommend, as shaving can make hair grow back thicker). Glide works from the root to slow growth and soften texture, so you're not trapped in the daily shaving cycle.</p>\n            <p>For best results:</p>\n            <ol>\n              <li>Remove hair from the root (wax, pluck, thread, or epilate)</li>\n              <li>Wait 8-12 hours</li>\n              <li>Apply Glide twice daily to clean skin</li>\n            </ol>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>How do I use it?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p><strong>Simple 3-step process:</strong></p>\n            <p><strong>Step 1:</strong> Remove hair from the root by waxing, plucking, threading, or epilating as normal</p>\n            <p><strong>Step 2:</strong> Wait 8-12 hours after hair removal</p>\n            <p><strong>Step 3:</strong> Massage a thin layer of Glide onto freshly cleansed skin twice daily</p>\n            <p>The lightweight serum absorbs quickly and won't interfere with makeup or your skincare routine.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>What if it doesn't work for me?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>We're so confident in Glide that we offer a <strong>60-day money-back guarantee</strong>.</p>\n            <p>If you don't see slower, finer, and more manageable regrowth within 60 days, simply contact our team for a full refund. No hassle, no questions asked.</p>\n            <p>You have nothing to lose and everything to gain—smoother skin, less hair removal, and confidence restored.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>Why isn't this in stores?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Glide Serum is only available through the official NU:YU website. By selling directly to customers, we can:</p>\n            <ul>\n              <li>Keep prices lower (no retail markups)</li>\n              <li>Ensure product freshness and quality</li>\n              <li>Provide better customer support</li>\n              <li>Offer exclusive bundle deals and guarantees</li>\n            </ul>\n            <p>This also protects you from counterfeit products and ensures you're getting the authentic formula that delivers real results.</p>\n          </div>\n        </div>\n\n        <div class=\"product_faq-box\">\n          <div class=\"product_faq-thumb\">\n            <div><p>Is this suitable for sensitive skin?</p></div>\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path d=\"M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z\"/></svg></div>\n          </div>\n          <div class=\"product_faq-content\">\n            <p>Yes! Unlike laser treatments or harsh depilatory creams, Glide is formulated with gentle, soothing ingredients that are perfect for sensitive skin.</p>\n            <p>The formula includes anti-inflammatory botanicals that calm redness and irritation. This makes it ideal for women who've struggled with reactive skin after hair removal.</p>\n            <p>In fact, many of our customers with sensitive skin say Glide has been the ONLY solution that works without causing irritation.</p>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"centered btn_container\">\n        <a href=\"#\" class=\"product_primary-btn scrolling\">Try Glide Serum Risk-Free</a>\n        <p class=\"product_primary-btn-footer\">\n          <span><img src=\"https://cdn.shopify.com/s/files/1/0932/4986/3947/files/Clip_path_group_1.png?v=1762438752\" alt=\"\"></span>\n          <span>60-Day Money-Back Guarantee</span>\n        </p>\n      </div>\n\n    </div>\n  </div>\n\n</div>\n\n<script>\n  (function () {\n    var container = document.getElementById('nuyuFaqContainer');\n    if (!container) return;\n    var boxes = container.querySelectorAll('.product_faq-box');\n    boxes.forEach(function (box) {\n      var thumb = box.querySelector('.product_faq-thumb');\n      thumb.addEventListener('click', function () {\n        var isActive = box.classList.contains('active');\n        boxes.forEach(function (b) { b.classList.remove('active'); });\n        if (!isActive) box.classList.add('active');\n      });\n    });\n  })();\n</script>",
